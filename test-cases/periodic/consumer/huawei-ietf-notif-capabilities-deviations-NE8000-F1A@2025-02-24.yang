module huawei-ietf-notif-capabilities-deviations-NE8000-F1A {
  yang-version 1.1;
  namespace "urn:huawei:yang:huawei-ietf-notif-capabilities-deviations-NE8000-F1A";
  prefix notc-devs-NE8000-F1A;

  import ietf-notification-capabilities {
    prefix notc;
  }
  import ietf-system-capabilities {
    prefix sysc;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for ietf-notification-capabilities module.";

  revision 2025-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  deviation "/sysc:system-capabilities/notc:subscription-capabilities/notc:max-nodes-per-update" {
    deviate not-supported;
  }
  deviation "/sysc:system-capabilities/sysc:datastore-capabilities/sysc:per-node-capabilities/notc:subscription-capabilities/notc:max-nodes-per-update" {
    deviate not-supported;
  }
}

  
module huawei-bgp-vpnv4mcast-deviations-NE8000-F1A {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-bgp-vpnv4mcast-deviations-NE8000-F1A";
  prefix bgp-vpnv4mcast-devs-NE8000-F1A;

  import huawei-bgp-vpnv4mcast {
    prefix bgp-vpnv4mcast;
  }
  import huawei-bgp {
    prefix bgp;
  }
  import huawei-network-instance {
    prefix ni;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-bgp-vpnv4mcast module.";

  revision 2026-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  deviation "/ni:network-instance/ni:instances/ni:instance/bgp:bgp/bgp:base-process/bgp:peer-groups/bgp:peer-group/bgp:afs/bgp:af/bgp-vpnv4mcast:ipv4-vpn-multicast" {
    deviate add {
      must "../../../bgp:peer-establish-mode!='dynamic-ipv6'";
    }
  }
}

  
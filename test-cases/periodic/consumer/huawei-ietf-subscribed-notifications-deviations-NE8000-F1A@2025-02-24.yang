module huawei-ietf-subscribed-notifications-deviations-NE8000-F1A {
  namespace "urn:huawei:yang:huawei-ietf-subscribed-notifications-deviations-NE8000-F1A";
  prefix sn-devs-NE8000-F1A;

  import ietf-subscribed-notifications {
    prefix sn;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-network-instance {
    prefix hwni;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for ietf-subscribed-notifications module.";

  revision 2025-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  deviation "/sn:establish-subscription/sn:input/sn:target/sn:stream/sn:stream-filter/sn:by-reference" {
    deviate not-supported;
  }
  deviation "/sn:establish-subscription/sn:input/sn:dscp" {
    deviate not-supported;
  }
  deviation "/sn:establish-subscription/sn:input/sn:weighting" {
    deviate not-supported;
  }
  deviation "/sn:establish-subscription/sn:input/sn:dependency" {
    deviate not-supported;
  }
  deviation "/sn:modify-subscription/sn:input/sn:target/sn:stream/sn:stream-filter/sn:by-reference" {
    deviate not-supported;
  }
  deviation "/sn:subscription-modified/sn:target" {
    deviate not-supported;
  }
  deviation "/sn:subscription-modified/sn:stop-time" {
    deviate not-supported;
  }
  deviation "/sn:subscription-modified/sn:dscp" {
    deviate not-supported;
  }
  deviation "/sn:subscription-modified/sn:weighting" {
    deviate not-supported;
  }
  deviation "/sn:subscription-modified/sn:dependency" {
    deviate not-supported;
  }
  deviation "/sn:subscription-modified/sn:purpose" {
    deviate not-supported;
  }
  deviation "/sn:subscription-started/sn:target" {
    deviate not-supported;
  }
  deviation "/sn:subscription-started/sn:stop-time" {
    deviate not-supported;
  }
  deviation "/sn:subscription-started/sn:dscp" {
    deviate not-supported;
  }
  deviation "/sn:subscription-started/sn:weighting" {
    deviate not-supported;
  }
  deviation "/sn:subscription-started/sn:dependency" {
    deviate not-supported;
  }
  deviation "/sn:subscription-started/sn:purpose" {
    deviate not-supported;
  }
  deviation "/sn:filters/sn:stream-filter" {
    deviate not-supported;
  }
  deviation "/sn:subscriptions/sn:subscription/sn:target/sn:stream/sn:stream-filter/sn:by-reference" {
    deviate not-supported;
  }
  deviation "/sn:subscriptions/sn:subscription/sn:target/sn:stream/sn:configured-replay" {
    deviate not-supported;
  }
  deviation "/sn:subscriptions/sn:subscription/sn:weighting" {
    deviate not-supported;
  }
  deviation "/sn:subscriptions/sn:subscription/sn:dependency" {
    deviate not-supported;
  }
  deviation "/sn:subscriptions/sn:subscription/sn:receivers/sn:receiver/sn:sent-event-records" {
    deviate not-supported;
  }
  deviation "/sn:subscriptions/sn:subscription/sn:receivers/sn:receiver/sn:excluded-event-records" {
    deviate not-supported;
  }
  deviation "/sn:subscriptions/sn:subscription/sn:receivers/sn:receiver/sn:state" {
    deviate not-supported;
  }
  deviation "/sn:subscriptions/sn:subscription/sn:receivers/sn:receiver/sn:reset" {
    deviate not-supported;
  }
  deviation "/sn:subscriptions/sn:subscription/sn:target" {
    deviate replace {
      mandatory false;
    }
  }
  deviation "/sn:subscriptions/sn:subscription/sn:target/sn:stream/sn:stream-filter" {
    deviate replace {
      config false;
    }
  }
  deviation "/sn:subscriptions/sn:subscription/sn:stop-time" {
    deviate replace {
      config false;
    }
  }
  deviation "/sn:subscriptions/sn:subscription/sn:purpose" {
    deviate replace {
      type string {
        length "1..127";
      }
    }
  }
  deviation "/sn:subscriptions/sn:subscription/sn:notification-message-origin/sn:interface-originated/sn:source-interface" {
    deviate replace {
      type leafref {
        path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
      }
    }
  }
  deviation "/sn:subscriptions/sn:subscription/sn:notification-message-origin/sn:address-originated/sn:source-vrf" {
    deviate replace {
      type leafref {
        path "/hwni:network-instance/hwni:instances/hwni:instance/hwni:name";
      }
    }
  }
  deviation "/sn:subscriptions/sn:subscription/sn:receivers/sn:receiver" {
    deviate replace {
      min-elements 0;
    }
  }
  deviation "/sn:subscriptions/sn:subscription/sn:receivers/sn:receiver/sn:name" {
    deviate replace {
      type string {
        length "1..64";
        pattern '[A-Za-z0-9]+';
      }
    }
  }
}

  
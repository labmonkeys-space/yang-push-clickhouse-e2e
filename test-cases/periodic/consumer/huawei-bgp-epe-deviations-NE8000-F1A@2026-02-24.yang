module huawei-bgp-epe-deviations-NE8000-F1A {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-bgp-epe-deviations-NE8000-F1A";
  prefix bgp-epe-devs-NE8000-F1A;

  import huawei-bgp-epe {
    prefix bgp-epe;
  }
  import huawei-bgp {
    prefix bgp;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-bgp-epe module.";

  revision 2026-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  deviation "/bgp:bgp/bgp:base-process/bgp-epe:egress-engineer-global/bgp-epe:collect-utilized-bandwidth" {
    deviate not-supported;
  }
  deviation "/bgp:bgp/bgp:base-process/bgp-epe:egress-engineer-global/bgp-epe:bidirectional" {
    deviate not-supported;
  }
}

  
  import huawei-routing-adjust-policy {
    prefix ra-policy;
  }
  import huawei-bgp {
    prefix bgp;
  }
  import huawei-network-instance {
    prefix ni;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-routing-adjust-policy module.";

  revision 2026-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  deviation "/ra-policy:routing-adjust-policy" {
    deviate not-supported;
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/bgp:bgp/bgp:base-process/bgp:afs/bgp:af/bgp:ipv4-unicast/ra-policy:routing-adjusts" {

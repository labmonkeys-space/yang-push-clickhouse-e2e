  }
  deviation "/cellular:cellular/cellular:cellular-profiles/cellular:cellular-profile/cellular:band/cellular:band-manually/cellular:network/cellular:wcdma" {
    deviate not-supported;
  }
  deviation "/cellular:cellular/cellular:cellular-profiles/cellular:cellular-profile/cellular:plmn-select" {
    deviate not-supported;
  }
  deviation "/cellular:cellular/cellular:cellular-profiles/cellular:cellular-profile/cellular:sim-wait-restore" {
    deviate not-supported;
  }
  deviation "/cellular:cellular/cellular:cellular-profiles/cellular:cellular-profile/cellular:modem-event/cellular:icmpv6-unreachable" {
    deviate not-supported;
  }
  deviation "/cellular:cellular/cellular:cellular-profiles/cellular:cellular-profile/cellular:modem-event/cellular:packet-service-detached" {
    deviate not-supported;
  }
  deviation "/cellular:cellular/cellular:cellular-profiles/cellular:cellular-profile/cellular:permit-imsis" {
    deviate not-supported;
  }
  deviation "/cellular:cellular/cellular:cellular-profiles/cellular:cellular-profile/cellular:pin-pre-verifications" {

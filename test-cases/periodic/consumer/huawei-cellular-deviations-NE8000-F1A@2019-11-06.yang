  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular-state/cellular:sims/cellular:sim/cellular:radio/cellular:rscp" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular-state/cellular:sims/cellular:sim/cellular:radio/cellular:ecio" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular-info" {

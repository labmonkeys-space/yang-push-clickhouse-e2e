    deviate not-supported;
  }
  deviation "/cellular:sim-switch" {
    deviate not-supported;
  }
  deviation "/cellular:modify-sim-pin" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular/cellular:bridge-mode" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular/cellular:dial-on-demand" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular/cellular:apn-profiles/cellular:apn-profile/cellular:priority" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular/cellular:modem-event/cellular:detect-event/cellular:ipv4-address" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular/cellular:modem-event/cellular:detect-event/cellular:ipv6-addresses" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular/cellular:default-route" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular-state/cellular:current-apns" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular-state/cellular:hardware/cellular:modem-name" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular-state/cellular:hardware/cellular:firmware-version" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular-state/cellular:sims/cellular:sim/cellular:network/cellular:band" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:cellular-state/cellular:sims/cellular:sim/cellular:network/cellular:ber" {

  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:sim-traffic-statistics" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/cellular:modem-location" {
    deviate not-supported;
  }
  deviation "/cellular:cellular/cellular:cellular-profiles/cellular:cellular-profile/cellular:connection-mode" {
    deviate replace {
      type cellular-devs-NE8000-F1A:connection-mode-type-nr-lte-deviations;
    }
  }
  deviation "/cellular:cellular/cellular:cellular-profiles/cellular:cellular-profile/cellular:band/cellular:band-manually/cellular:network/cellular:lte" {
    deviate replace {
      type cellular-devs-NE8000-F1A:lte-frequency-type-router-deviations;
    }
  }
  deviation "/cellular:cellular/cellular:cellular-profiles/cellular:cellular-profile/cellular:modem-event/cellular:services-unavailable/cellular:action" {
    deviate replace {
      type enumeration {
        enum none {
          value 1;
          description
            "Take no action.";
        }
        enum modem-reboot {
          value 2;
          description
            "Specify modem reboot.";
        }
      }
    }
  }
}

  
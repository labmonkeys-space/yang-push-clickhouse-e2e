  }
  deviation "/vaccess:vaccess/vaccess-master:flexe-master/nvsnmp:snmp" {
    deviate not-supported;
  }
  deviation "/vaccess:vaccess/vaccess-master:master/vaccess-master:aps/vaccess-master:ap/nvsnmp:snmp" {

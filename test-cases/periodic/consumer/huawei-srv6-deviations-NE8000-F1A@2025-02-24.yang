    }
    deviate add {
      must "(../s-flag = 'false' and count(../../end-x-psp-usp-usd-coc[value=current()]) = 1) or ../s-flag='true'";
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/srv6:srv6/srv6:locators/srv6:locator/srv6:opcodes/srv6:end-x-cocs/srv6:end-x-coc/srv6:value" {
    deviate delete {
      must "(../s-flag = 'false' and count(../../end-x-coc[value=current()]) = 1) or (../s-flag='true' and not(../../end-x-coc[value = current()][protected != current()/../protected]))";
    }
    deviate add {
      must "(../s-flag = 'false' and count(../../end-x-coc[value=current()]) = 1) or ../s-flag='true'";
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/srv6:srv6/srv6:locators/srv6:locator/srv6:opcodes/srv6:end-x-psp-cocs/srv6:end-x-psp-coc/srv6:value" {
    deviate delete {
      must "(../s-flag = 'false' and count(../../end-x-psp-coc[value=current()]) = 1) or (../s-flag='true' and not(../../end-x-psp-coc[value = current()][protected != current()/../protected]))";
    }
    deviate add {
      must "(../s-flag = 'false' and count(../../end-x-psp-coc[value=current()]) = 1) or ../s-flag='true'";
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/srv6:srv6/srv6:locators/srv6:locator/srv6:opcodes/srv6:end-x-extensions/srv6:end-x-extension/srv6:value" {
    deviate delete {
      must "(../s-flag = 'false' and count(../../end-x-extension[value=current()]) = 1) or (../s-flag = 'true' and not(../../end-x-extension[value = current()][behavior != current()/../behavior]) and not(../../end-x-extension[value = current()][protected != current()/../protected]))";
    }
    deviate add {
      must "(../s-flag = 'false' and count(../../end-x-extension[value=current()]) = 1) or (../s-flag = 'true' and not(../../end-x-extension[value = current()][behavior != current()/../behavior]))";
    }

  deviation "/ni:network-instance/ni:instances/ni:instance/srv6:srv6/srv6:local-sids/srv6:end-x-uncompressed-extensions/srv6:end-x-uncompressed-extension/srv6:next-hops/srv6:next-hop/srv6:bak-next-hop" {

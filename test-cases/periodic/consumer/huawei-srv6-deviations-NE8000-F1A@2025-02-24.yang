  deviation "/ni:network-instance/ni:instances/ni:instance/srv6:srv6/srv6:local-sids/srv6:end-x-uncompressed-extensions/srv6:end-x-uncompressed-extension/srv6:next-hops/srv6:next-hop/srv6:bak-label-stack" {
    deviate not-supported;
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/srv6:srv6/srv6:reduce-srh-enable" {
    deviate add {
      must "not(../reduce-srh-enable = 'true' and ../local-end-x-encapsulation = 'true')";
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/srv6:srv6/srv6:local-end-x-encapsulation" {
    deviate add {
      must "not(../reduce-srh-enable = 'true' and ../local-end-x-encapsulation = 'true')";
    }
  }

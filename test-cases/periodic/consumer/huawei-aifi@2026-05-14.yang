            units bit/s;
            description
              "Valley flow speed.";
          }
          leaf average-flow-speed-bps {
            type uint64;
            units bit/s;
            description
              "Average flow speed.";
          }
          leaf start-time {
            type string {
              length "1..24";
            }
            description
              "Start time.";
          }
          leaf end-time {
            type string {
              length "1..24";
            }
            description
              "End time.";
          }
        }

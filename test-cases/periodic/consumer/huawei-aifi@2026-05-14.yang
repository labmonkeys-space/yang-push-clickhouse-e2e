      }
    }
    container flow-classes {
      must "not(../user-defined-flow) or count(../flow-classes/flow-class)=0";
      description
        "List of configure the service class of flow classification result.";
      list flow-class {
        key "classification-result";
        max-elements 4;
        description
          "Configure the service class of flow classification result.";
        leaf classification-result {
          type flow-classification-result;
          description
            "Flow classification result.";
        }
        leaf service-class {
          type aifi-service-class;
          mandatory true;
          description
            "Service class of flow classification result.";
        }
        leaf color {
          type aifi-color;
          mandatory true;
          description
            "Color of flow classification result.";
        }
        leaf remark-switch {
          type remark-type;
          default "enable";
          description
            "Remark switch.";
        }
      }
    }
    container host-timeouts {
      description
        "Configure intervals for reporting data and templates.";
        leaf data-export-interval {
          type uint16 {
            range "1..300";
          }
          units min;
          must "not(../../user-defined-flow)";
          default "30";
          description
            "Interval for reporting data.";
        }
        leaf template-export-interval {
          type uint16 {
            range "1..300";
          }
          units min;
          default "15";
          description
            "Interval for reporting templates.";
        }
    }
    container flow-dscp-values {
      must "not(../user-defined-flow) or count(../flow-dscp-values/flow-dscp-value)=0";
      description
        "List of configure DSCP values of flow classification result.";
      list flow-dscp-value {
        key "classification-result";
        max-elements 4;
        description
          "Configure a DSCP value for flow classification results.";
        leaf classification-result {
          type flow-classification-result;
          description
            "Flow classification result.";
        }
        leaf dscp-value {
          type uint8 {
            range "0..63";
          }
          mandatory true;
          description
            "DSCP value of flow classification results.";
        }
      }
    }
    container user-defined-flow {
      must "../global/direction='inbound' or not(../user-defined-flow)";
      must "../global/burst-min-threshold=4 or not(../global/burst-min-threshold) or not(../user-defined-flow)";
      must "../global/burst-monitor-enable='disable' or not(../global/burst-monitor-enable) or not(../user-defined-flow)";
      must "../global/burst-static-threshold=5 or not(../global/burst-static-threshold) or not(../user-defined-flow)";
      must "../global/carpet-bombing-detect-enable='disable' or not(../global/carpet-bombing-detect-enable) or not(../user-defined-flow)";
      must "../global/carpet-bombing-ipv4-prefix=24 or not(../global/carpet-bombing-ipv4-prefix) or not(../user-defined-flow)";
      must "../global/carpet-bombing-ipv6-prefix=80 or not(../global/carpet-bombing-ipv6-prefix) or not(../user-defined-flow)";
      must "../global/carpet-bombing-detect-bandwidth=0 or not(../global/carpet-bombing-detect-bandwidth) or not(../user-defined-flow)";
      must "../global/classification-enable='disable' or not(../global/classification-enable) or not(../user-defined-flow)";
      must "../global/flow-aggregation-enable='disable' or not(../global/flow-aggregation-enable) or not(../user-defined-flow)";
      must "../global/flow-initial-silent-period=15 or not(../global/flow-initial-silent-period) or not(../user-defined-flow)";
      must "../global/flow-size-para-weight=25 or not(../global/flow-size-para-weight) or not(../user-defined-flow)";
      must "../global/flow-speed-para-weight=25 or not(../global/flow-speed-para-weight) or not(../user-defined-flow)";
      must "../global/high-sample-ratio=1000 or not(../global/high-sample-ratio) or not(../user-defined-flow)";
      must "../global/low-sample-ratio=10000 or not(../global/low-sample-ratio) or not(../user-defined-flow)";
      must "../global/lowest-burst-level='notification' or not(../global/lowest-burst-level) or not(../user-defined-flow)";
      must "../global/match-pattern='sip-sport-dip-dport-protocol' or not(../global/match-pattern) or not(../user-defined-flow)";
      must "../global/max-burst-size-weight=25 or not(../global/max-burst-size-weight) or not(../user-defined-flow)";
      must "../global/max-packet-interval-weight=25 or not(../global/max-packet-interval-weight) or not(../user-defined-flow)";
      must "../global/packet-len-std-para-weight=25 or not(../global/packet-len-std-para-weight) or not(../user-defined-flow)";
      must "../global/packet-size=1000 or not(../global/packet-size) or not(../user-defined-flow)";
      must "../global/burst-suppress/mode='disable' or not(../global/burst-suppress/mode) or not(../user-defined-flow)";
      must "../global/burst-suppress/user-log='enable' or not(../global/burst-suppress/user-log) or not(../user-defined-flow)";
      must "../host-timeouts/data-export-interval=30 or not(../host-timeouts/data-export-interval) or not(../user-defined-flow)";
      must "count(../static-ipv4-flow-5tuples/static-ipv4-flow-5tuple)=0 or not(../user-defined-flow)";
      must "count(../static-ipv4-flow-dip-protocols/static-ipv4-flow-dip-protocol)=0 or not(../user-defined-flow)";
      must "count(../static-ipv4-flow-dips/static-ipv4-flow-dip)=0 or not(../user-defined-flow)";
      must "count(../static-ipv4-flow-sip-dips/static-ipv4-flow-sip-dip)=0 or not(../user-defined-flow)";
      must "count(../static-ipv4-flow-sips/static-ipv4-flow-sip)=0 or not(../user-defined-flow)";
      must "count(../static-ipv6-flow-5tuples/static-ipv6-flow-5tuple)=0 or not(../user-defined-flow)";
      must "count(../static-ipv6-flow-dip-protocols/static-ipv6-flow-dip-protocol)=0 or not(../user-defined-flow)";
      must "count(../static-ipv6-flow-dips/static-ipv6-flow-dip)=0 or not(../user-defined-flow)";
      must "count(../static-ipv6-flow-sip-dips/static-ipv6-flow-sip-dip)=0 or not(../user-defined-flow)";
      must "count(../static-ipv6-flow-sips/static-ipv6-flow-sip)=0 or not(../user-defined-flow)";
      must "count(../export-ipv4-hosts/export-ipv4-host)=0 or not(../user-defined-flow)";
      must "count(../export-ipv6-hosts/export-ipv6-host)=0 or not(../user-defined-flow)";
      must "count(../flow-classes/flow-class)=0 or not(../user-defined-flow)";
      must "count(../flow-dscp-values/flow-dscp-value)=0 or not(../user-defined-flow)";
      must "not(../burst-suppress-protect-lists) or not(../user-defined-flow)";
      must "not(../burst-suppress-unprotect-lists) or not(../user-defined-flow)";
      must "not(../burst-suppress-trust-lists) or not(../user-defined-flow)";
      presence "AIFI user-defined-flow function enable.";
      description
        "Configure parameters of the user-defined-flow function.";
      leaf match-pattern {
        type user-defined-flow-match-pattern;
        default "sip-dip-dport-protocol";
        description
          "User-defined-flow match pattern.";
      }
      leaf algorithm-threshold-drop {
        type uint8 {
          range "5..50";
        }
        units %;
        default "10";
        description
          "User-defined-flow algorithm threshold.";
      }
      leaf algorithm-threshold-rise {
        type uint8 {
          range "5..200";
        }
        units %;
        default "5";
        description
          "User-defined-flow algorithm threshold.";
      }
      leaf algorithm-threshold-lowest-detect {
        type uint16 {
          range "0..100";
        }
        units "100 kbit/s";
        default "10";
        description
          "User-defined-flow algorithm threshold.";
      }
      leaf data-export-interval-second {
        type uint16 {
          range "30..600";
        }
        units s;
        default "300";
        description
          "Interval second for reporting data.";
      }
      container export-ipv4-hosts {
        must "(count(export-ipv4-host) + count(../export-ipv6-hosts/export-ipv6-host))<=8";
        description
          "List of configure export VPN destination IPv4 address instance.";
        list export-ipv4-host {
          must "not(./original-flow = 'false' and ./aggregate-flow = 'false' and ./original-abnormal-flow = 'false' and ./aggregate-abnormal-flow = 'false')";
          key "address port vpn-name";
          description
            "Configure export VPN destination IPv4 address instance.";
          leaf address {
            type inet:ipv4-address-no-zone;
            description
              "Host IPv4 address.";
            }
          leaf port {
            type uint16 {
              range "1..65535";
            }
            description
              "Host IPv4 port.";
          }
          leaf vpn-name {
            type leafref {
              path "/ni:network-instance/ni:instances/ni:instance/ni:name";
            }
            must "/ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv4-unicast']";
            description
              "VPN instance name.";
          }
          leaf dscp-value {
            type uint8 {
              range "0..63";
            }
            default "0";
            description
              "Differentiated services code point.";
          }
          leaf original-flow {
            type boolean;
            mandatory true;
            description
              "Enable/disable reporting original flows periodically.";
          }
          leaf aggregate-flow {
            type boolean;
            mandatory true;
            description
              "Enable/disable reporting aggregated flows periodically.";
          }
          leaf original-abnormal-flow {
            type boolean;
            mandatory true;
            description
              "Enable/disable reporting original abnormal flows.";
          }
          leaf aggregate-abnormal-flow {
            type boolean;
            mandatory true;
            description
              "Enable/disable reporting aggregated abnormal flows.";
          }
        }
      }
      container export-ipv6-hosts {
        must "(count(export-ipv6-host) + count(../export-ipv4-hosts/export-ipv4-host))<=8";
        description
          "List of configure export VPN destination IPv6 address instance.";
        list export-ipv6-host {
          must "not(./original-flow = 'false' and ./aggregate-flow = 'false' and ./original-abnormal-flow = 'false' and ./aggregate-abnormal-flow = 'false')";
          key "address port vpn-name";
          description
            "Configure export VPN destination IPv6 address instance.";
          leaf address {
            type inet:ipv6-address-no-zone;
            description
              "Host IPv6 address.";
          }
          leaf port {
            type uint16 {
              range "1..65535";
            }
            description
              "Host IPv6 port.";
          }
          leaf vpn-name {
            type leafref {
              path "/ni:network-instance/ni:instances/ni:instance/ni:name";
            }
            must "/ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv6-unicast']";
            description
              "VPN instance name.";
          }
          leaf dscp-value {
            type uint8 {
              range "0..63";
            }
            default "0";
            description
              "Differentiated services code point.";
          }
          leaf original-flow {
            type boolean;
            mandatory true;
            description
              "Enable/disable reporting original flows periodically.";
          }
          leaf aggregate-flow {
            type boolean;
            mandatory true;
            description
              "Enable/disable reporting aggregated flows periodically.";
          }
          leaf original-abnormal-flow {
            type boolean;
            mandatory true;
            description
              "Enable/disable reporting original abnormal flows.";
          }
          leaf aggregate-abnormal-flow {
            type boolean;
            mandatory true;
            description
              "Enable/disable reporting aggregated abnormal flows.";
          }
        }
      }
      container match-type {
        must "(count(./inner-protocols/inner-protocol) + count(./inner-protocol-dports/inner-protocol-dport)) <= 100";
        description
          "Configure match types for the user-defined-flow function.";
        container inner-protocols {
          description
            "List of configure match types for the user-defined-flow function without dport.";
          list inner-protocol {
            key "inner-protocol";
            description
              "Configure a filter with inner protocol no dport for the user-defined-flow function.";
            leaf inner-protocol {
              type udm-filter-no-dport-protocols;
              must "count(../../../inner-protocol-dports/inner-protocol-dport[inner-protocol=current()])=0";
              description
                "Inner protocol.";
            }
          }
        }
        container inner-protocol-dports {
          description
            "List of configure match types for the user-defined-flow function with dport.";
          list inner-protocol-dport {
            key "inner-protocol dport";
            description
              "Configure a filter with inner protocol specified dport for the user-defined-flow function.";
            leaf inner-protocol {
              type user-defined-flow-protocol-type;
              must "count(../../../inner-protocols/inner-protocol[inner-protocol=current()])=0";
              description
                "Inner protocol.";
            }
            leaf dport {
              type uint16 {
                range "1..65535";
              }
              description
                "Destination port.";
            }
          }
        }
      }
      container flow-statistics {
        config false;
        description
          "List of flow statistics of user-defined flow.";
        list flow-statistic {
          key "slot";
          description
            "Statistics of the user-defined flow list.";
          leaf slot {
            type string {
              length "1..15";
            }
            description
              "Slot ID.";
          }
          leaf current-ipv4-original-flow {
            type uint32 {
              range "0..65536";
            }
            description
              "Current IPv4 original flow count.";
          }
          leaf current-ipv6-original-flow {
            type uint16 {
              range "0..32768";
            }
            description
              "Current IPv6 original flow count.";
          }
          leaf current-aggregate-flow {
            type uint8 {
              range "0..100";
            }
            description
              "Current aggregated flow count.";
          }
        }
      }
      container ipv4-original-flow-results {
        config false;
        description
          "List of statistic results of IPv4 original flows.";
        list ipv4-original-flow-result {
          key "slot index";
          description
            "Statistics of the IPv4 original flow list of AIFI.";
          leaf slot {
            type string {
              length "1..15";
            }
            description
              "Slot ID.";
          }
          leaf index {
            type uint16 {
              range "0..65535";
            }
            description
              "Record index.";
          }
          leaf top {
            type uint16 {
              range "1..24000";
            }
            description
              "Top speed number of flows.";
            ext:support-filter "true";
          }
          leaf src-ipv4-address {
            type inet:ipv4-address-no-zone;
            description
              "Source IPv4 address.";
            ext:support-filter "true";
            }
          leaf dst-ipv4-address {
            type inet:ipv4-address-no-zone;
            description
              "Destination IPv4 address.";
            ext:support-filter "true";
          }
          leaf dst-ipv4-port {
            type uint16 {
              range "1..65535";
            }
            description
              "IPv4 destination port.";
            ext:support-filter "true";
          }
          leaf protocol {
            type user-defined-flow-protocol-type;
            description
              "Protocol.";
            ext:support-filter "true";
          }
          leaf speed-bps {
            type uint64;
            units bit/s;
            description
              "Flow speed bps.";
          }
          leaf speed-pps {
            type uint32;
            units pps;
            description
              "Flow speed pps.";
          }
          leaf flow-status {
            type user-defined-flow-status-type;
            description
              "Flow status result.";
            ext:support-filter "true";
          }
        }
      }
      container ipv6-original-flow-results {
        config false;
        description
          "List of statistic results of IPv6 original flows.";
        list ipv6-original-flow-result {

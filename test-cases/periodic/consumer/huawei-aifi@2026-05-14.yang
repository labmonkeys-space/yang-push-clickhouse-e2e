      "Huawei private.";
  }
  revision 2023-10-25 {
    description
      "23.1 requirement changes.";
    reference
      "Huawei private.";
  }
  revision 2023-07-19 {
    description
      "23.0 DTS changes.";
    reference
      "Huawei private.";
  }
  revision 2023-07-14 {
    description
      "23.0 DTS changes.";
    reference
      "Huawei private.";
  }
  revision 2023-05-12 {
    description
      "23.0 spec changes.";
    reference
      "Huawei private.";
  }
  revision 2023-03-30 {
    description
      "23.0 requirement changes.";
    reference
      "Huawei private.";
  }
  revision 2023-01-18 {
    description
      "Bound mode change.";
    reference
      "Huawei private.";
  }
  revision 2023-01-17 {
    description
      "Initial revision.";
    reference
      "Huawei private.";
  }
  ext:task-name  "ai-fi";
  typedef session-direction {
    type enumeration {
      enum "outbound" {
        value 0;
        description
          "Outbound direction.";
      }
      enum "inbound" {
        value 1;
        description
          "Inbound direction.";
      }
    }
    description
      "Direction.";
  }
  typedef session-match-pattern {
    type enumeration {
      enum "sip" {
        value 1;
        description
          "Sip mode.";
      }
      enum "dip" {
        value 2;
        description
          "Dip mode.";
      }
      enum "sip-dip" {
        value 3;
        description
          "Sip-dip mode.";
      }
      enum "dip-protocol" {
        value 4;
        description
          "Dip-protocol mode.";
      }
      enum "sip-sport-dip-dport-protocol" {
        value 5;
        description
          "Sip-sport-dip-dport-protocol mode.";
      }
    }
	  description
      "Session match pattern.";
  }
  typedef aifi-color {
    type enumeration {
      enum "green" {
        value 0;
        description
          "Specify the packet color as green.";
      }
      enum "yellow" {
        value 1;
        description
          "Specify the packet color as yellow.";
      }
      enum "red" {
        value 2;
        description
          "Specify the packet color as red.";
      }
    }
    description
      "Description of packet color.";
  }
  typedef aifi-service-class {
    type enumeration {
      enum "be" {
        value 0;
        description
          "Specify the CoS as BE.";
      }
      enum "af1" {
        value 1;
        description
          "Specify the CoS as AF1.";
      }
      enum "af2" {
        value 2;
        description
          "Specify the CoS as AF2.";
      }
      enum "af3" {
        value 3;
        description
          "Specify the CoS as AF3.";
      }
      enum "af4" {
        value 4;
        description
          "Specify the CoS as AF4.";
      }
      enum "ef" {
        value 5;
        description
          "Specify the CoS as EF.";
      }
      enum "cs6" {
        value 6;
        description
          "Specify the CoS as CS6.";
      }
      enum "cs7" {
        value 7;
        description
          "Specify the CoS as CS7.";
      }
    }
    description
      "Description of CoS.";
  }
  typedef remark-type {
    type enumeration {
      enum "enable" {
        value 0;
        description
          "Remark enable.";
      }
      enum "disable" {
        value 1;
        description
          "Remark disable.";
      }
    }
    description
      "Remark type.";
  }
  typedef aifi-action {
    type enumeration {
      enum "enable" {
        value 1;
        description
          "AIFI enable.";
      }
    }
	description
      "AIFI enable on an interface.";
  }
  typedef flow-classification-result {
    type enumeration {
      enum "level0" {
        value 0;
        description
          "Level 0: network control, telephony, signaling, multimedia conferencing, real-time interactive, etc.";
      }
      enum "level1" {
        value 1;
        description
          "Level 1: low-latency data, etc.";
      }
      enum "level2" {
        value 2;
        description
          "Level 2: multimedia streaming, broadcast video, OAM, etc.";
      }
      enum "level3" {
        value 3;
        description
          "Level 3: high-throughput data, standard low-priority data, etc.";
      }
    }
    description
      "Flow classification result.";
  }
  typedef aifi-stop-action {
    type enumeration {
      enum "disable" {
        value 0;
        description
          "AIFI stop disable.";
      }
      enum "enable" {
        value 1;
        description
          "AIFI stop enable.";
      }
    }
    description
      "AIFI stop action.";
  }
  typedef aifi-classification-action {
    type enumeration {
      enum "disable" {
        value 0;
        description
          "AIFI flow classification disable.";
      }
      enum "enable" {
        value 1;
        description
          "AIFI flow classification enable.";
      }
    }
    description
      "AIFI flow classification function action.";
  }
  typedef aifi-burst-monitor-action {
    type enumeration {
      enum "disable" {
        value 0;
        description
          "AIFI burst monitor disable.";
      }
      enum "enable" {
        value 1;
        description
          "AIFI burst monitor enable.";
      }
    }
    description
      "AIFI burst monitor function action.";
  }
  typedef aifi-egress-identification-action {
    type enumeration {
      enum "disable" {
        value 0;
        description
          "AIFI egress ECMP interface identification disable.";
      }
      enum "enable" {
        value 1;
        description
          "AIFI egress ECMP interface identification enable.";
      }
    }
    description
      "AIFI egress ECMP interface identification action.";
  }
  typedef protocol-type {
    type enumeration {
      enum "tcp" {
        value 6;
        description
          "Tcp.";
      }
      enum "udp" {
        value 17;
        description
          "Udp.";
      }
    }
    description
      "Protocol type.";
  }
  typedef host-flow-report-type {
    type enumeration {
      enum "burst-flows" {
        value 0;
        description
          "Report original burst flows and aggregated burst flows.";
      }
      enum "original-burst-flows" {
        value 1;
        description
          "Report original burst flows only.";
      }
      enum "aggregate-burst-flows" {
        value 2;
        description
          "Report aggregated burst flows only.";
      }
      enum "normal-flows" {
        value 3;
        description
          "Report original normal flows and aggregated normal flows.";
      }
      enum "carpet-bombing-flows" {
        value 4;
        description
          "Report carpet bombing flows only.";
      }
      enum "suppress-info" {
        value 5;
        description
          "Report burst suppress information only.";
      }
    }
    description
      "The type of flow reported.";
  }
  typedef session-burst-level {
    type enumeration {
      enum "notification" {
        value 0;
        description
          "Level notification.";
      }
      enum "warning" {
        value 1;
        description
          "Level warning.";
      }
      enum "critical" {
        value 2;
        description
          "Level critical.";
      }
      enum "alert" {
        value 3;
        description
          "Level alert.";
      }
      enum "emergency" {
        value 4;
        description
          "Level emergency.";
      }
    }
    description
      "The level of burst flow events.";
  }
  typedef aifi-config-action {
    type enumeration {
      enum "disable" {
        value 0;
        description
          "Disable function.";
      }
      enum "enable" {
        value 1;
        description
          "Enable function.";
      }
    }
    description
      "AIFI configuration action.";
  }
  typedef ip-type {
    type enumeration {
      enum "ipv4" {
        value 0;
        description
          "IPv4.";
      }
      enum "ipv6" {
        value 1;
        description
          "IPv6.";
      }
    }
    description
      "IP type.";
  }
  typedef user-defined-flow-match-pattern {
    type enumeration {
      enum "sip-dip-dport-protocol" {
        value 6;
        description
          "Sip-dip-dport-protocol mode.";
      }
      enum "dip-dport-protocol" {
        value 7;
        description
          "Dip-dport-protocol mode.";
      }
    }
	  description
      "User-defined flow match pattern.";
  }
  typedef user-defined-flow-protocol-type {
    type enumeration {
      enum "tcp" {
        value 6;
        description
          "Tcp.";
      }
      enum "udp" {
        value 17;
        description
          "Udp.";
      }
      enum "sctp" {
        value 132;
        description
          "Sctp.";
      }
    }
    description
      "Protocol type of user-defined flow.";
  }
  typedef udm-filter-no-dport-protocols {
    type enumeration {
      enum "sctp" {
        value 132;
        description
          "Sctp.";
      }
    }
    description
      "The user-defined flow protocol type that can be configured as filter restriction without dport.";
  }
  typedef user-defined-flow-status-type {
    type enumeration {
      enum "normal" {
        value 0;
        description
          "Normal.";
      }
      enum "abnormal-rise" {
        value 1;
        description
          "Abnormal rise.";
      }
      enum "abnormal-drop" {
        value 2;
        description
          "Abnormal drop.";
      }
    }
    description
      "Flow status type of user-defined flow.";
  }
  typedef alarm-option-type{
    type enumeration {
      enum "burst-alarm" {
        value 1;
        description
          "Burst alarm.";
      }
    }
    description
      "The alarm options of AIFI.";
  }
  typedef suppress-mode-type {
    type enumeration {
      enum "disable" {
        value 0;
        description
          "Disable suppress mode.";
      }
      enum "ipv4-unprotect-list" {
        value 1;
        description
          "IPv4 unprotect list suppress mode.";
      }
      enum "ipv4-protect-list" {
        value 2;
        description
          "IPv4 protect list suppress mode.";
      }
    }
    description
      "The suppress mode of AIFI.";
  }
  typedef suppress-mode-type-ipv6 {
    type enumeration {
      enum "disable" {
        value 0;
        description
          "Disable IPv6 suppress mode.";
      }
      enum "ipv6-unprotect-list" {
        value 1;
        description
          "IPv6 unprotect list suppress mode.";
      }
      enum "ipv6-protect-list" {
        value 2;
        description
          "IPv6 protect list suppress mode.";
      }
    }
    description
      "The IPv6 suppress mode of AIFI.";
  }
  container aifi {
    presence "AIFI enable.";
    description
      "Configure AIFI function.";
    container global {
      must "not (burst-monitor-enable='disable' and carpet-bombing-detect-enable='enable')";
      description
        "Configure global parameters of AIFI.";
      leaf stop {
          type aifi-stop-action;
          default "disable";
          description
            "Enable/Disable AIFI stop function.";
      }
      leaf direction {
          type session-direction;
          must "not(../../user-defined-flow) or (../../user-defined-flow and ../direction='inbound')";
          default "inbound";
          description
            "AIFI flow sample direction.";
      }
      leaf idle-time {
          type uint16 {
            range "10..3600";
          }
          units s;
          must "../idle-time - ../age-time >= 5";
          default "50";
          description
            "Control plane aging time.";
      }
      leaf age-time {
          type uint16 {
            range "5..3595";
          }
          units s;
          must "../idle-time - ../age-time >= 5";
          default "5";
          description
            "Forward plane aging time.";
      }
      leaf packet-size {
          type uint16 {
            range "100..2047";
          }
          units Byte;
          must "not(../../user-defined-flow)";
          default "1000";
          description
            "Packet size to distinguish low-sample-ratio and high-sample-ratio.";
      }
      leaf high-sample-ratio {
          type uint16 {
              range "900..10000";
          }
          must "not(../../user-defined-flow)";
          must "../low-sample-ratio > ../high-sample-ratio";
          default "1000";
          description
            "High packet sample ratio.";
      }
      leaf low-sample-ratio {
          type uint16 {
              range "1000..65535";
          }
          must "not(../../user-defined-flow)";
          must "../low-sample-ratio > ../high-sample-ratio";
          default "10000";
          description
            "Low packet sample ratio.";
      }
      leaf replace-threshold {
          type uint32 {
              range "100..1000000";
          }
          units kbit/s;
          default "1000";
          description
            "Flow replace threshold.";
      }
      leaf protect-time {
          type uint8 {
              range "5..60";
          }
          units s;
          default "10";
          description
            "New flow protect time.";
      }
      leaf cpu-protect {
          type uint8 {
              range "40..100";
          }
          units %;
          default "85";
          description
            "CPU protect utilization ratio.";
      }
      leaf match-pattern {
          type session-match-pattern;
          must "not(../../user-defined-flow)";
          default "sip-sport-dip-dport-protocol";
          description
            "AIFI flow match pattern.";
      }
      leaf egress-identification-enable {
          type aifi-egress-identification-action;
          default "disable";
          description
            "Enable/Disable egress ECMP interface identification.";
      }
      leaf classification-enable {
          type aifi-classification-action;
          must "not(../../user-defined-flow)";
          default "disable";
          description
            "Enable/Disable flow classification.";
      }
      leaf burst-monitor-enable {
          type aifi-burst-monitor-action;
          must "not(../../user-defined-flow)";
          default "disable";
          description
            "Enable/Disable flow burst monitor.";
      }
      leaf burst-monitor-maintain-time {
          type uint16 {
              range "30..1440";
          }
          units s;
          default "720";
          description
            "Flow burst monitor baseline maintain time.";
      }
      leaf max-packet-interval-weight {
          type uint8 {
              range "0..50";
          }
          units %;
          must "not(../../user-defined-flow)";
          default "25";
          description
            "Weight of the max packet interval parameter.";
      }
      leaf max-burst-size-weight {
          type uint8 {
              range "0..50";
          }
          units %;
          must "not(../../user-defined-flow)";
          default "25";
          description
            "Weight of the max burst size parameter.";
      }
      leaf flow-speed-para-weight {
          type uint8 {
              range "0..50";
          }
          units %;
          must "not(../../user-defined-flow)";
          default "25";
          description
            "Weight of the flow speed parameter.";
      }
      leaf flow-size-para-weight {
          type uint8 {
              range "0..50";
          }
          units %;
          must "not(../../user-defined-flow)";
          default "25";
          description
            "Weight of the flow size parameter.";
      }
      leaf packet-len-std-para-weight {
          type uint8 {
              range "0..50";
          }
          units %;
          must "not(../../user-defined-flow)";
          default "25";
          description
            "Weight of the packet length mean squared error parameter.";
      }
      leaf lowest-burst-level {
          type session-burst-level;
          must "not(../../user-defined-flow)";
          default "notification";
          description
            "Configure the lowest level of burst flow events.";
      }
      leaf flow-initial-silent-period {
          type uint16 {
              range "1..1440";
          }
          units min;
          must "not(../../user-defined-flow)";
          default "15";
          description
            "Initial silence period of session-burst-monitor.";
      }
      leaf flow-aggregation-enable {
          type aifi-config-action;
          must "not(../../user-defined-flow)";
          default "disable";
          description
            "Enable/disable flow-aggregation.";
      }
      leaf burst-static-threshold {
          type uint8 {
              range "5..10";
          }
          must "not(../../user-defined-flow)";
          default "5";
          description
            "Configure the static threshold (Gbps) of burst flow events.";
      }
      leaf burst-min-threshold {
          type uint8 {
              range "0..10";
          }
          must "not(../../user-defined-flow)";
          default "4";
          description
            "Configure the min threshold (100Mbps) of burst flow events.";
      }
      leaf carpet-bombing-detect-enable {
          type aifi-config-action;
          must "not(../../user-defined-flow)";
          default "disable";
          description
            "Enable/disable carpet-bombing-detect.";
      }
      leaf carpet-bombing-ipv4-prefix {
          type uint16 {
              range "24..26";
          }
          must "not(../../user-defined-flow)";
          default "24";
          description
            "Configure the prefix value of the IPv4 aggregate flow.";
      }
      leaf carpet-bombing-ipv6-prefix {
          type uint16 {
              range "80";
          }
          must "not(../../user-defined-flow)";
          default "80";
          description
            "Configure the prefix value of the IPv6 aggregate flow.";
      }
      leaf-list alarm-option {
          type alarm-option-type;
          description
            "Configure the alarm options of AIFI.";
      }
      leaf session-monitor-group-enable {
          type boolean;
          default "false";
          description
            "Enable/disable flow whitelist check.";
      }
      leaf carpet-bombing-detect-bandwidth{
          type uint16 {
            range "0..1000";
          }
          units "100 Mbit/s";
          must "not(../../user-defined-flow)";
          default "0";
          description
            "Configure the threshold (100Mbit/s) of carpet-bombing detect bandwidth.";
      }
      container burst-suppress {
        description
          "Configure session burst suppress settings.";
        leaf mode{
            type suppress-mode-type;
            must "not(../../../user-defined-flow)";
            must "../mode='disable' or (../../match-pattern='dip' and ../../direction='inbound' and ../../burst-monitor-enable='enable')";
            must "../mode='disable' or (../mode='ipv4-protect-list' and ../../../burst-suppress-protect-lists/burst-suppress-protect-list/ip-type='ipv4') or (../mode='ipv4-unprotect-list' and ../../../burst-suppress-unprotect-lists/burst-suppress-unprotect-list/ip-type='ipv4')";
            default "disable";
            description
              "Set session burst suppress mode type.";
        }
        leaf mode-ipv6{
            type suppress-mode-type-ipv6;
            must "not(../../../user-defined-flow)";
            must "../mode-ipv6='disable' or (../../match-pattern='dip' and ../../direction='inbound' and ../../burst-monitor-enable='enable')";
            must "../mode-ipv6='disable' or (../mode-ipv6='ipv6-protect-list' and ../../../burst-suppress-protect-lists/burst-suppress-protect-list/ip-type='ipv6') or (../mode-ipv6='ipv6-unprotect-list' and ../../../burst-suppress-unprotect-lists/burst-suppress-unprotect-list/ip-type='ipv6')";
            default "disable";
            description
              "Set IPv6 session burst suppress mode type.";
        }
        leaf user-log{
            type aifi-config-action;
            must "not(../../../user-defined-flow)";
            default "enable";
            description
              "Enable/disable record session burst suppress information.";
        }
        leaf alarm{
            type aifi-config-action;
            default "enable";
            description
              "Enable/disable session burst suppress alarm.";
        }
      }
    }
    container static-ipv4-flow-sips {
      when "/aifi:aifi/aifi:global/aifi:match-pattern='sip'";
      must "not(../user-defined-flow) or count(../static-ipv4-flow-sips/static-ipv4-flow-sip)=0";
      description
        "List of static IPv4 flow for sip match pattern.";
      list static-ipv4-flow-sip {
        key "src-ipv4-address vpn-name";
        max-elements 512;
        description
          "Configure AIFI static flow address.";
        leaf src-ipv4-address {
          type inet:ipv4-address-no-zone;
          description
            "Source IPv4 address.";
        }
        leaf vpn-name {
          type leafref {
            path "/ni:network-instance/ni:instances/ni:instance/ni:name";
          }
          must "/ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv4-unicast']";
          description
            "VPN instance name.";
        }
      }
    }
    container static-ipv6-flow-sips {
      when "/aifi:aifi/aifi:global/aifi:match-pattern='sip'";
      must "not(../user-defined-flow) or count(../static-ipv6-flow-sips/static-ipv6-flow-sip)=0";
      description
        "List of static IPv6 flow for sip match pattern.";
      list static-ipv6-flow-sip {
        key "src-ipv6-address vpn-name";
        max-elements 256;
        description
          "Configure AIFI static flow address.";
        leaf src-ipv6-address {
          type inet:ipv6-address-no-zone;
          description
            "Source IPv6 address.";
        }
        leaf vpn-name {
          type leafref {
            path "/ni:network-instance/ni:instances/ni:instance/ni:name";
          }
          must "/ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv6-unicast']";
          description
            "VPN instance name.";
        }
      }
    }
    container static-ipv4-flow-dips {
      when "/aifi:aifi/aifi:global/aifi:match-pattern='dip'";
      must "not(../user-defined-flow) or count(../static-ipv4-flow-dips/static-ipv4-flow-dip)=0";
      description
        "List of static IPv4 flow for dip match pattern.";
      list static-ipv4-flow-dip {
        key "dst-ipv4-address vpn-name";
        max-elements 512;
        description
          "Configure AIFI static flow address.";
        leaf dst-ipv4-address {
          type inet:ipv4-address-no-zone;
          description
            "Destination IPv4 address.";
        }
        leaf vpn-name {
          type leafref {
            path "/ni:network-instance/ni:instances/ni:instance/ni:name";
          }
          must "/ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv4-unicast']";

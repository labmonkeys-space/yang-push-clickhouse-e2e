      container aggregated-flow-results {
        config false;
        description
          "List of statistic results of aggregated flows.";
        list aggregated-flow-result {
          key "slot index";
          description
            "Statistics of the aggregated flow lists of AIFI.";
          leaf slot {
            type string {
              length "1..15";
            }
            description
              "Slot ID.";
          }
          leaf index {
            type uint16 {
              range "0..100";
            }
            description
              "Record index.";
          }
          leaf dst-port {
            type uint16 {
              range "1..65535";
            }
            description
              "Destination port.";
            ext:support-filter "true";
          }
          leaf protocol {

  rpc reset-udf-baseline-ipv4-original-flow {
    description
      "Reset AI-FI user-defined flow baseline of IPv4 original flow.";
    input {
      container reset-udf-baseline-ipv4-original-flow {
        description
          "Reset AI-FI user-defined flow baseline of IPv4 original flow.";
        leaf slot {
          type string {
            length "1..15";
          }
          description
            "Slot ID.";
        }
        leaf src-ipv4-address {
          type inet:ipv4-address-no-zone;
          description
            "Source IPv4 address.";
        }
        leaf dst-ipv4-address {
          type inet:ipv4-address-no-zone;
          mandatory true;
          description
            "Destination IPv4 address.";
        }
        leaf inner-protocol {
          type user-defined-flow-protocol-type;
          mandatory true;
          description
            "Inner protocol.";
        }
        leaf dst-ipv4-port {
          type uint16 {
            range "1..65535";
          }
          mandatory true;
          description
            "IPv4 destination port.";
        }
      }
    }
  }
 
  rpc reset-udf-baseline-ipv6-original-flow {
    description
      "Reset AI-FI user-defined flow baseline of IPv6 original flow.";
    input {
      container reset-udf-baseline-ipv6-original-flow {
        description
          "Reset AI-FI user-defined flow baseline of IPv6 original flow.";
        leaf slot {
          type string {
            length "1..15";
          }
          description
            "Slot ID.";
        }
        leaf src-ipv6-address {
          type inet:ipv6-address-no-zone;
          description
            "Source IPv6 address.";
        }
        leaf dst-ipv6-address {
          type inet:ipv6-address-no-zone;
          mandatory true;
          description
            "Destination IPv6 address.";
        }
        leaf inner-protocol {
          type user-defined-flow-protocol-type;
          mandatory true;
          description
            "Inner protocol.";
        }
        leaf dst-ipv6-port {
          type uint16 {
            range "1..65535";
          }
          mandatory true;
          description
            "IPv6 destination port.";
        }
      }
    }
  }

  rpc reset-udf-baseline-aggregated-flow {
    description
      "Reset AI-FI user-defined flow baseline of aggregated flow.";
    input {
      container reset-udf-baseline-aggregated-flow {
        description
          "Reset AI-FI user-defined flow baseline of aggregated flow.";
        leaf slot {
          type string {
            length "1..15";
          }
          description
            "Slot ID.";
        }
        leaf inner-protocol {
          type user-defined-flow-protocol-type;
          mandatory true;
          description
            "Inner protocol.";
        }
        leaf dst-port {
          when "../inner-protocol='tcp' or ../inner-protocol='udp'";
          type uint16 {
            range "1..65535";
          }
          mandatory true;
          description
            "Destination port.";
        }
      }
    }
  }

  augment "/ifm:ifm/ifm:interfaces/ifm:interface" {
    description
      "The AIFI configuration on an interface.";
    container aifi {
      when "/aifi:aifi";
      description
        "Configure the AIFI function on an interface.";
      leaf aifi-enable {
        type aifi-action;
        description
          "Enable the AIFI function on an interface.";
      }
    }
  }
}
  
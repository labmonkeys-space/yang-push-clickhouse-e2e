    container whitelist-rules {
      when "/aifi:aifi/aifi:global/aifi:session-monitor-group-enable='true'";
      description
        "List of rule of whitelist.";
      list whitelist-rule {
        key "rule-id";
        unique "destination-address vpn-name";
        description
          "Configure rule of AIFI whitelist.";
        leaf rule-id {
          type uint32 {
            range "1..5000";
          }
          description
            "Rule id.";
        }
        leaf ip-type {
          type ip-type;
          mandatory true;
          description
            "IPv4 or IPv6.";
        }
        leaf destination-address {
          type inet:ip-address-no-zone;
          mandatory true;
          description
            "Destination address.";
        }
        leaf destination-mask {
          type uint8 {
            range "1..128";
          }
          must "(../ip-type='ipv4' and ../destination-mask < 33) or ../ip-type='ipv6'";
          mandatory true;
          description
            "Mask of a destination IP address.";
        }
        leaf vpn-name {
          type leafref {
            path "/ni:network-instance/ni:instances/ni:instance/ni:name";
          }
          must "(../ip-type='ipv4' and /ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv4-unicast']) or (../ip-type='ipv6' and /ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv6-unicast'])";
          description
            "VPN instance name.";
        }
        leaf statistics {
          type boolean;
          default "false";
          description
            "Enable/disable the statistics function for the current rule.";
        }
      }
    }
    container burst-suppress-protect-lists {
      must "not(../user-defined-flow)";
      must "(not(../global/burst-suppress/mode='ipv4-protect-list') or burst-suppress-protect-list/ip-type='ipv4') and (not(../global/burst-suppress/mode-ipv6='ipv6-protect-list') or burst-suppress-protect-list/ip-type='ipv6')";
      must "count(burst-suppress-protect-list/ip-type='ipv4')<=1024 and count(burst-suppress-protect-list/ip-type='ipv6')<=1024";
      presence "Suppress protect lists enable.";
      description
        "List of protection rules.";
      list burst-suppress-protect-list {
        key "ip-type destination-address";
        description
          "Configure a protection rule.";
        leaf ip-type {
          type ip-type;
          description
            "IP type.";
        }
        leaf destination-address {
          type inet:ip-address-no-zone;
          description
            "Destination address.";
        }
      }
    }
    container burst-suppress-unprotect-lists {
      must "not(../user-defined-flow)";
      must "(not(../global/burst-suppress/mode='ipv4-unprotect-list') or burst-suppress-unprotect-list/ip-type='ipv4') and (not(../global/burst-suppress/mode-ipv6='ipv6-unprotect-list') or burst-suppress-unprotect-list/ip-type='ipv6')";
      must "count(burst-suppress-unprotect-list/ip-type='ipv4')<=1024 and count(burst-suppress-unprotect-list/ip-type='ipv6')<=1024";
      presence "Suppress unprotect lists enable.";
      description
        "List of non-protection rules.";
      list burst-suppress-unprotect-list {
        key "ip-type destination-address";
        description
          "Configure a non-protection rule.";
        leaf ip-type {
          type ip-type;
          description
            "IP type.";
        }
        leaf destination-address {
          type inet:ip-address-no-zone;
          description
            "Destination address.";
        }
      }
    }
    container burst-suppress-trust-lists {
      must "not(../user-defined-flow)";
      must "count(burst-suppress-trust-list/ip-type='ipv4')<=512 and count(burst-suppress-trust-list/ip-type='ipv6')<=512";
      description
        "List of trustlist rules.";
      list burst-suppress-trust-list {
        key "ip-type source-address";
        description
          "Configure a trustlist rule.";
        leaf ip-type {
          type ip-type;
          description
            "IP type.";
        }
        leaf source-address {
          type inet:ip-address-no-zone;
          description
            "Source address.";
        }
      }
    }
    container ipv4-suppress-history-records {
      config false;
      description
        "List of The historical information of IPv4 attack traffic suppressed by AIFI.";
      list ipv4-suppress-history-record {
        key "slot index";
        description
          "Statistics of the IPv4 suppress history list of AIFI.";
        leaf slot {
          type string {
            length "1..15";
          }
          description
            "Slot ID.";
        }
        leaf index {
          type uint16 {
            range "0..65535";
          }
          description
            "Record index.";
        }
        leaf start-time {
          type string {
            length "1..24";
          }
          description
            "Start time.";
        }
        leaf end-time {
          type string {
            length "1..24";
          }
          description
            "End time.";
        }
        leaf dst-ipv4-address {
          type inet:ipv4-address-no-zone;
          description
            "Destination IPv4 address.";
        }
        leaf total-suppress-bytes {
          type uint64;
          units Byte;
          description
            "Total suppressed bytes.";
        }
        leaf attack-type {
          type string {
            length "1..100";
          }
          description
            "Attack Type.";
        }
      }
    }
    container ipv6-suppress-history-records {
      config false;

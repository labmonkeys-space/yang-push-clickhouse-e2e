            }
            description
              "Record index.";
          }
          leaf top {
            type uint16 {
              range "1..24000";
            }
            description
              "Top number.";
            ext:support-filter "true";
            }
          leaf src-ipv6-address {
            type inet:ipv6-address-no-zone;
            description
              "Source IPv6 address.";
            ext:support-filter "true";
            }
          leaf dst-ipv6-address {
            type inet:ipv6-address-no-zone;
            description
              "Destination IPv6 address.";
            ext:support-filter "true";
            }
          leaf dst-ipv6-port {
            type uint16 {
              range "1..65535";
            }
            ext:support-filter "true";
            description
              "IPv6 destination port.";
          }
          leaf protocol {
            type user-defined-flow-protocol-type;
            ext:support-filter "true";
            description

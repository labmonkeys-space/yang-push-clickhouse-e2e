      leaf source-ipv4-address {
        type inet:ipv4-address-no-zone;
        mandatory true;
        description
          "Source IPv4 address.";
      }
      leaf source-ipv4-port {
        type uint16 {
          range "1..65535";
        }
        default "40000";
        description
          "Source IPv4 port.";
      }
    }
    container export-ipv6-source {
      presence "Export source IPv6 configuration.";
      description
        "Configure an export source IPv6 address instance.";
      leaf source-ipv6-address {
        type inet:ipv6-address-no-zone;
        mandatory true;
        description
          "Source IPv6 address.";
      }
      leaf source-ipv6-port {
        type uint16 {
          range "1..65535";
        }
        default "40000";
        description

    container ipv4-burst-history {
      config false;
      description
        "Statistics of AIFI DDoS burst history of IPv4 original flows.";
      container original-flow-records {
        config false;
        description
          "List of IPv4 original flow records of AIFI DDoS burst.";
        list original-flow-record {
          key "slot index";
          description
            "Statistics of IPv4 original flow record of AIFI DDoS burst.";
          leaf slot {
            type string {
              length "1..15";
            }
            description
              "Slot ID.";
          }
          leaf index {
            type uint16 {
              range "0..65535";
            }
            description
              "Record index.";
          }
          leaf src-ipv4-address {
            type string {
              length "1..16";
            }
            description
              "Source IPv4 address.";
          }
          leaf dst-ipv4-address {
            type string {
              length "1..16";
            }
            description
              "Destination IPv4 address.";
          }
          leaf vpn-name {
            type leafref {
              path "/ni:network-instance/ni:instances/ni:instance/ni:name";
            }
            description
              "VPN instance name.";
          }
          leaf src-ipv4-port {
            type string {
              length "1..8";
            }
            description
              "IPv4 source port.";
          }
          leaf dst-ipv4-port {
            type string {
              length "1..8";
            }
            description
              "IPv4 destination port.";
          }
          leaf protocol {
            type string {
              length "1..4";
            }
            description
              "Protocol.";
          }
          leaf peak-flow-speed-bps {
            type uint64;
            units bit/s;
            description
              "Peak flow speed.";
          }
          leaf valley-flow-speed-bps {
            type uint64;
            units bit/s;
            description
              "Valley flow speed.";
          }
          leaf average-flow-speed-bps {
            type uint64;
            units bit/s;
            description
              "Average flow speed.";
          }
          leaf start-time {
            type string {
              length "1..24";
            }
            description
              "Start time.";
          }
          leaf end-time {
            type string {
              length "1..24";
            }
            description
              "End time.";
          }
        }
      }
      container carpet-bombing-records {
        config false;
        description
          "List of IPv4 records of AIFI carpet bombing burst.";
        list carpet-bombing-record {

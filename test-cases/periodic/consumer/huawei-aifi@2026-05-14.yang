            }
            description
              "Record index.";
          }
          leaf prefix {
            type string {
              length "1..19";
            }
            description
              "Routing prefix.";
          }
          leaf vpn-name {
            type leafref {
              path "/ni:network-instance/ni:instances/ni:instance/ni:name";
            }
            description

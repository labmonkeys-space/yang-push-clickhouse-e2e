module huawei-dcn-deviations-NE8000-F1A {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-dcn-deviations-NE8000-F1A";
  prefix dcn-devs-NE8000-F1A;

  import huawei-dcn {
    prefix dcn;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-vaccess {
    prefix vaccess;
  }
  import huawei-vaccess-master {
    prefix vaccess-master;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-dcn module.";

  revision 2025-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  deviation "/dcn:dcn/dcn:site/dcn:qx/dcn:server-dtls-policy" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/dcn:dcn/dcn:remote" {
    deviate not-supported;
  }
  deviation "/vaccess:vaccess/vaccess-master:master/dcn:import-admin-ips" {
    deviate not-supported;
  }
  deviation "/vaccess:vaccess/vaccess-master:master/dcn:import-protocols" {
    deviate not-supported;
  }
  deviation "/dcn:dcn/dcn:udp-session-car/dcn:cbs" {
    deviate replace {
      default "120000";
    }
  }
  deviation "/dcn:dcn/dcn:udp-session-car/dcn:pbs" {
    deviate replace {
      default "600000";
    }
  }
  deviation "/dcn:dcn/dcn:tcp-session-car/dcn:cbs" {
    deviate replace {
      default "120000";
    }
  }
  deviation "/dcn:dcn/dcn:tcp-session-car/dcn:pbs" {
    deviate replace {
      default "600000";
    }
  }
}

  
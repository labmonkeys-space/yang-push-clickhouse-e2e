module huawei-fim-ethernet {
  namespace "urn:huawei:yang:huawei-fim-ethernet";
  prefix fim-ethernet;
  import huawei-ethernet {
    prefix ethernet;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-extension {
    prefix ext;
  }
  import huawei-ifm-trunk {
    prefix ifm-trunk;
  }
  import huawei-fim-ifm {
    prefix fim-ifm;
  }
  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "Common interface management, which includes the public configuration of interfaces.";
  reference
    "Huawei private.";
  revision 2024-06-20 {
    description
      "Add interface 800GE, and add advised-node feature.";
    reference
      "Huawei private.";
  }
  revision 2024-02-21 {
    description
      "Add interface 50-100GE.";
    reference
      "Huawei private.";
  }
  revision 2023-01-20 {
    description
      "Change when to positive.";
    reference
      "Huawei private.";
  }
  revision 2022-08-24 {
    description
      "Add interface 1200GE.";
    reference
      "Huawei private.";
  }
  revision 2022-03-19 {
    description
      "Qinq support mode-channel.";
    reference
      "Huawei private.";
  }
  revision 2022-02-10 {
    description
      "Add deprecated for mode-channel.";
    reference
      "Huawei private.";
  }
  revision 2020-03-11 {
    description
      "Initial revision.";
    reference
      "Huawei private.";
  }
  ext:task-name "forwarding";
  typedef enable-type {
    type enumeration {
      enum "disable" {
        value 0;
        description
          "Disable.";
      }
      enum "enable" {
        value 1;
        description
          "Enable.";
      }
    }
    description
      "Enable type.";
  }

  augment "/ifm:ifm/ifm:interfaces/ifm:interface/ethernet:ethernet/ethernet:l3-sub-interface" {
      description
       "FIM configuration to the IFM module.";
    container mode-channel {
      when "(../ethernet:vlan-type-dot1q or ../ethernet:qinq-termination)";
      status deprecated;
      ext:advised-node "/ifm:ifm/ifm:interfaces/ifm:interface/fim-ifm:mode-channel";
      description
        "Configure the mode Channel sub-interface.";
      leaf mode-channel-enable {
        type enable-type;
        default "disable";
        status deprecated;
        description
          "Enable or disable mode channel sub-interface.";
      }
      leaf bandwidth {
        when "../mode-channel-enable='enable'";
        type uint32 {
          range "2..1000000000";
        }
        units "Mbit/s";
        default "2";
        status deprecated;
        description
          "Specify bandwidth of an mode channel sub-interface (Mbit/s).";
      }
    }
  }

  augment "/ifm:ifm/ifm:interfaces/ifm:interface/ethernet:ethernet/ethernet:main-interface" {
      description
        "FIM configuration to the IFM module.";
    container fim-main {
      when "not((../../../ifm:name) = (/ifm:ifm/ifm:interfaces/ifm:interface/ifm-trunk:trunk/ifm-trunk:members/ifm-trunk:member/ifm-trunk:name)) and (../../../ifm:type='GigabitEthernet' or ../../../ifm:type='XGigabitEthernet' or ../../../ifm:type='FlexE' or ../../../ifm:type='Eth-Trunk' or ../../../ifm:type='10GE' or ../../../ifm:type='25GE' or ../../../ifm:type='40GE' or ../../../ifm:type='50GE' or ../../../ifm:type='50|100GE' or ../../../ifm:type='50-100GE' or ../../../ifm:type='100GE' or ../../../ifm:type='200GE' or ../../../ifm:type='400GE' or ../../../ifm:type='800GE' or ../../../ifm:type='1200GE' or ../../../ifm:type='Ethernet')";
      description
        "Configure the FIM configuration to the main interface.";
      leaf outer-vlan-enable {
        type enable-type;
        default "disable";
        description
          "Modify one tag ethernet type.";
      }
    }
    container modechannel-main {
      when "not((../../../ifm:name) = (/ifm:ifm/ifm:interfaces/ifm:interface/ifm-trunk:trunk/ifm-trunk:members/ifm-trunk:member/ifm-trunk:name)) and (../../../ifm:type='GigabitEthernet' or ../../../ifm:type='XGigabitEthernet' or ../../../ifm:type='FlexE' or ../../../ifm:type='Eth-Trunk' or ../../../ifm:type='10GE' or ../../../ifm:type='25GE' or ../../../ifm:type='40GE' or ../../../ifm:type='50GE' or ../../../ifm:type='50|100GE' or ../../../ifm:type='50-100GE' or ../../../ifm:type='100GE' or ../../../ifm:type='200GE' or ../../../ifm:type='400GE' or ../../../ifm:type='800GE' or ../../../ifm:type='1200GE' or ../../../ifm:type='Ethernet')";
      config false;
      status deprecated;
      description
        "Statistics of the main interface that supports channelized sub-interfaces.";
      leaf remain-bandwidth {
        type uint32;
        units "Mbit/s";
        status deprecated;
        description
          "Remaining bandwidth of the main interface.";
      }
      leaf remain-in-bit-rate {
        type uint64;
        units "bit/s";
        status deprecated;
        description
          "Remaining rate at which bits are received within the interval.";
      }
      leaf remain-out-bit-rate {
        type uint64;
        units "bit/s";
        status deprecated;
        description
          "Remaining rate at which bits are sent within the interval.";
      }
    }
  }


  augment "/ifm:ifm/ifm:interfaces/ifm:interface/ethernet:ethernet/ethernet:l2-sub-interface" {
      description
        "FIM configuration to the IFM module.";
    container fim-l2-sub {
      description
        "Configure the FIM configuration to L2 sub interface.";
      leaf egress-strict-filter {
        type enable-type;
        description
          "Enable or disable strict filter on an EVC sub-interface.";
      }
    }
  }
}

  
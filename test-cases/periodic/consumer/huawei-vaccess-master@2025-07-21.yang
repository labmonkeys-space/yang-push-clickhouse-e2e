module huawei-vaccess-master {
  namespace "urn:huawei:yang:huawei-vaccess-master";
  prefix vaccess-master;
  import huawei-vaccess {
    prefix vaccess;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import ietf-inet-types {
    prefix inet;
  }
  import huawei-extension {
    prefix ext;
  }
  import ietf-yang-types {
    prefix yang;
  }
  import huawei-network-instance {
    prefix ni;
  }
  import huawei-pub-type {
    prefix pub-type;
  }
  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "Virtual Access Master Information.";
  revision 2025-07-21 {
    description
      "Add description nodes.";
    reference
      "Huawei private.";
  }
  revision 2025-02-05 {
    description
      "Fixed some descriptions.";
    reference
      "Huawei private.";
  }
  revision 2024-09-03 {
    description
      "Add virtual access flexe-master.";
    reference
      "Huawei private.";
  }
  revision 2022-02-16 {
    description
      "Add nvtag attribute.";
    reference
      "Huawei private.";
  }
  revision 2020-07-11 {
    description
      "Add private syntax to the Control-tunnel keychain name.";
    reference
      "Huawei private.";
  }
  revision 2020-03-24 {
    description
      "Fixed some descriptions.";
    reference
      "Huawei private.";
  }
  revision 2020-03-05 {
    description
      "Add some nodes for virtual access master.";
    reference
      "Huawei private.";
  }
  revision 2019-12-13 {
    description
      "Some compatibility conditions are modified.";
    reference
      "Huawei private.";
  }
  revision 2019-11-13 {
    description
      "Initial revision.";
    reference
      "Huawei private.";
  }
  ext:task-name "virtual-access";
  typedef vaccess-run-state {
    type enumeration {
      enum "offline" {
        value 0;
        description
          "Offline state.";
      }
      enum "online" {
        value 1;
        description
          "Online state.";
      }
    }
    description
      "Ap run state.";
  }
  typedef vaccess-ap-if-state {
    type enumeration {
      enum "down" {
        value 0;
        description
          "Down.";
      }
      enum "up" {
        value 1;
        description
          "Up.";
      }
    }
    description
      "Ap interface state.";
  }
  typedef vaccess-ap-if-type {
    type enumeration {
      enum "inner" {
        value 0;
        description
          "Inner.";
      }
      enum "outer" {
        value 1;
        description
          "Outer.";
      }
    }
    description
      "Ap interface attribute.";
  }
  typedef vaccess-inner-if-type {
    type enumeration {
      enum "to-master" {
        value 1;
        description
          "Connect master interface.";
      }
      enum "to-ap" {
        value 2;
        description
          "Connect ap interface.";
      }
    }
    description
      "Virtual access inner interface type.";
  }
  grouping ap-statistics {
    description
      "Statistics of APs managed by a master.";

		leaf total-number {
		  type uint32;
		  description
			  "Total number of APs managed by a master.";
		}

		leaf online-number {
		  type uint32;
		  description
			  "Number of online APs managed by a master.";
		}

		leaf offline-number {
		  type uint32;
		  description
			  "Number of offline APs managed by a master.";
		}
  }
  augment /vaccess:vaccess {
    description
      "Virtual access master Configuration information augment to module vaccess.";
    container master {
      when "/vaccess:vaccess/vaccess:global/vaccess:role='master'and /vaccess:vaccess/vaccess:global/vaccess:port-extend-enable='true'";
      description
        "Configure virtual access master function.";
      container global {
        description
          "Configure basic master function of virtual access.";
        leaf admin-ip-address {
          type inet:ip-address;
          description
            "Admin IP of master.";
        }
        leaf control-tunnel-keychain-name {
          type string {
            length "1..47";
            pattern '[^A-Z]+';
          }
          ext:case-sensitivity lower-only;
          description
            "Control-tunnel keychain name of master.";
        }
      }
      container aps {
        description
          "List of ap configuration of virtual access.";
        list ap {
          key "ap-id";
          unique "admin-ip-address";
          description
            "Configure ap function for virtual access.";
          leaf ap-id {
            type uint32 {
              range "1024..8191";
            }
            description
              "Ap ID.";
          }
          leaf description {
            type string {
              length "1..246";
            }
            description
              "Sysname of ap.";
          }
          leaf admin-ip-address {
            ext:operation-exclude delete;
            type inet:ip-address;
            must "../admin-ip-address!=../../../global/admin-ip-address";
            description
              "Ap admin IP address. After this node is deleted, the ap and master are disconnected, affecting normal service functions.";
          }
          leaf esn {
            type string {
              length "1..64";
            }
            description
              "ESN number.";
          }
          leaf primary-master-ip {
            type inet:ip-address;
            config false;
            description
              "Primary master IP address.";
          }
          leaf state {
            type vaccess-run-state;
            config false;
            description
              "Current run state of ap.";
          }
          leaf up-time {
            type yang:date-and-time;
            config false;
            description
              "Online time.";
          }
          leaf pnp-state {
            type string {
              length "1..64";
            }
            config false;
            description
              "PNP state.";
          }
          leaf pnp-error-info {
            type string {
              length "1..64";
            }
            config false;
            description
              "PNP error information.";
          }
          leaf isis-peer-state {
            type string {
              length "1..64";
            }
            config false;
            description
              "ISIS peer state.";
          }
          leaf isis-peer-error-info {
            type string {
              length "1..64";
            }
            config false;
            description
              "ISIS peer error information.";
          }
          leaf select-result {
            type string {
              length "1..64";
            }
            config false;
            description
              "Master select result.";
          }
          leaf select-error-info {
            type string {
              length "1..64";
            }
            config false;
            description
              "Master select error information.";
          }
          leaf netconf-state {
            type string {
              length "1..64";
            }
            config false;
            description
              "Netconf state.";
          }
          leaf netconf-error-info {
            type string {
              length "1..64";
            }
            config false;
            description
              "Netconf error information.";
          }
          leaf netconf-config-sync-state {
            type string {
              length "1..64";
            }
            config false;
            description
              "Netconf config synchronize state.";
          }
          leaf netconf-config-sync-error-info {
            type string {
              length "1..64";
            }
            config false;
            description
              "Netconf config synchronize error information.";
          }
          container ap-interface-infos {
            config false;
            description
              "List of ap interface information parameter.";
            list ap-interface-info {
              key "interface-name";
              description
                "Operational data of ap interface information.";
              leaf interface-name {
                type leafref {
                  path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
                }
                description
                  "Interface name.";
              }
              leaf interface-status {
                type vaccess-ap-if-state;
                description
                  "Interface state.";
              }
              leaf interface-type {
                type vaccess-ap-if-type;
                description
                  "Interface type.";
              }
            }
          }
          container nvtag {
            description
              "Configure nvtag attribute.";
            container inner-connects {
              description
                "List of inner communication interfaces.";
              list inner-connect {
                key "ap-inner-interface";
                unique "interface-name";
                description
                  "Configure binding information of the inner communication interface.";
                leaf ap-inner-interface {
                  type pub-type:if-name;
                  must "not (../../../vaccess-master:remote-connects/vaccess-master:remote-connect[vaccess-master:ap-remote-interface = current()])";
                  description
                    "Name of an ap inner communication interface.";
                }
                leaf interface-name {
                  type leafref {
                    path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
                  }
                  must "not (/vaccess:vaccess/vaccess-master:master/vaccess-master:aps/vaccess-master:ap[vaccess-master:ap-id != current()/../../../../vaccess-master:ap-id]/vaccess-master:nvtag/vaccess-master:inner-connects/vaccess-master:inner-connect[vaccess-master:interface-name = current()])";
                  must "not (/vaccess:vaccess/vaccess-master:master/vaccess-master:aps/vaccess-master:ap[vaccess-master:ap-id != current()/../../../../vaccess-master:ap-id]/vaccess-master:nvtag/vaccess-master:remote-connects/vaccess-master:remote-connect[vaccess-master:interface-name = current()])";
                  mandatory true;
                  description
                    "Name of a master inner communication interface.";
                }
              }
            }
            container remote-connects {
              description
                "List of inner and external communication interfaces.";
              list remote-connect {
                key "ap-remote-interface";
                max-elements 256;
                description
                  "Configure binding information of the inner and external communication interfaces.";
                leaf ap-remote-interface {
                  type pub-type:if-name;
                  description
                    "Name of an ap external communication interface.";
                }
                leaf interface-name {
                  type leafref {
                    path "/ni:network-instance/ni:instances/ni:instance/vaccess-master:vaccess-interfaces/vaccess-master:vaccess-interface/vaccess-master:name";
                  }
                  must "not (/vaccess:vaccess/vaccess-master:master/vaccess-master:aps/vaccess-master:ap[vaccess-master:ap-id != current()/../../../../vaccess-master:ap-id]/vaccess-master:nvtag/vaccess-master:inner-connects/vaccess-master:inner-connect[vaccess-master:interface-name = current()])";
                  must "not (/vaccess:vaccess/vaccess-master:master/vaccess-master:aps/vaccess-master:ap[vaccess-master:ap-id != current()/../../../../vaccess-master:ap-id]/vaccess-master:nvtag/vaccess-master:remote-connects/vaccess-master:remote-connect[vaccess-master:interface-name = current()])";
                  mandatory true;
                  description
                    "Name of a master inner communication interface.";
                }
              }
            }
          }
        }
      }
      container ap-statistics {
        config false;
        description
          "Statistics of APs managed by a master.";
	      uses ap-statistics;
      }
    }
    container flexe-master {
      when "/vaccess:vaccess/vaccess:global/vaccess:role='master' and /vaccess:vaccess/vaccess:global/vaccess:port-extend-flexe-enable='true'";
      description
        "Configure virtual access flexe-master function.";
      container global {
        description
          "Configure basic master function of virtual access.";
        leaf admin-ip-address {
          type inet:ip-address;
          description
            "Admin IP of master.";
        }
        leaf control-tunnel-keychain-name {
          type string {
            length "1..47";
            pattern '[^A-Z]+';
          }
          ext:case-sensitivity lower-only;
          description
            "Control-tunnel keychain name of master.";
        }
      }
      container aps {
        description
          "List of ap configuration of virtual access.";
        list ap {
          key "ap-id";
          description
            "Configure ap function for virtual access.";
          leaf ap-id {
            type uint32 {
              range "1024..8191";
            }
            description
              "Ap ID.";
          }
          leaf description {
            type string {
              length "1..246";
            }
            description
              "Sysname of ap.";
          }
          leaf esn {
            type string {
              length "1..64";
            }
            description
              "ESN number.";
          }
          leaf primary-master-ip {
            type inet:ip-address;
            config false;
            description
              "Primary master IP address.";
          }
          leaf state {
            type vaccess-run-state;
            config false;
            description
              "Current run state of ap.";
          }
          leaf up-time {
            type yang:date-and-time;
            config false;
            description
              "Online time.";
          }
          leaf pnp-state {
            type string {
              length "1..64";
            }
            config false;
            description
              "PNP state.";
          }
          leaf pnp-error-info {
            type string {
              length "1..64";
            }
            config false;
            description
              "PNP error information.";
          }
          leaf isis-peer-state {
            type string {
              length "1..64";
            }
            config false;
            description
              "ISIS peer state.";
          }
          leaf isis-peer-error-info {
            type string {
              length "1..64";
            }
            config false;
            description
              "ISIS peer error information.";
          }
          leaf master-select-result {
            type string {
              length "1..64";
            }
            config false;
            description
              "Master select result.";
          }
          leaf master-select-error-info {
            type string {
              length "1..64";
            }
            config false;
            description
              "Master select error information.";
          }
          leaf netconf-state {
            type string {
              length "1..64";
            }
            config false;
            description
              "Netconf state.";
          }
          leaf netconf-error-info {
            type string {
              length "1..64";
            }
            config false;
            description
              "Netconf error information.";
          }
          leaf netconf-config-sync-state {
            type string {
              length "1..64";
            }
            config false;
            description
              "Netconf config synchronize state.";
          }
          leaf netconf-config-sync-error-info {
            type string {
              length "1..64";
            }
            config false;
            description
              "Netconf config synchronize error information.";
          }
          container ap-interface-infos {
            config false;
            description
              "List of ap interface information parameter.";
            list ap-interface-info {
              key "interface-name";
              description
                "Operational data of ap interface information.";
              leaf interface-name {
                type leafref {
                  path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
                }
                description
                  "Interface name.";
              }
              leaf interface-status {
                type vaccess-ap-if-state;
                description
                  "Interface state.";
              }
              leaf interface-type {
                type vaccess-ap-if-type;
                description
                  "Interface type.";
              }
            }
          }
          container inner-connects {
            description
              "List of inner connect interfaces.";
            list inner-connect {
              key "master-interface";
              unique "ap-interface";
              description
                "Configure inner-connect interface.";
              leaf master-interface {
                type leafref {
                  path "/ni:network-instance/ni:instances/ni:instance/vaccess-master:vaccess-flexe-interfaces/vaccess-master:vaccess-flexe-interface/vaccess-master:name";
                }
                must "not (/vaccess:vaccess/vaccess-master:flexe-master/vaccess-master:aps/vaccess-master:ap[vaccess-master:ap-id != current()/../../../vaccess-master:ap-id]/vaccess-master:inner-connects/vaccess-master:inner-connect[vaccess-master:master-interface = current()])";
                description
                  "Master inner connect interface.";
              }
              leaf ap-interface{
                type pub-type:if-name;
                must "not (../../../vaccess-master:remote-bindings/vaccess-master:remote-binding[vaccess-master:ap-remote-interface = current()])";
                mandatory true;
                description
                  "AP inner connect interface.";
              }
            }
          }
          container remote-bindings {
            description
              "List of remote binding interfaces.";
            list remote-binding {
              key "ap-remote-interface";
              unique "master-bind-interface";
              description
                "Configure remote binding interface.";
              leaf ap-remote-interface {
                type pub-type:if-name;
                description
                  "AP external communication interface.";
              }
              leaf master-bind-interface {
                type leafref {
                  path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
                }
                must "not (/vaccess:vaccess/vaccess-master:flexe-master/vaccess-master:aps/vaccess-master:ap[vaccess-master:ap-id != current()/../../../vaccess-master:ap-id]/vaccess-master:remote-bindings/vaccess-master:remote-binding[vaccess-master:master-bind-interface = current()])";
                mandatory true;
                description
                  "Master inner communication interface.";
              }
              leaf description {
                type string {
                  length "1..128";
                }
                description
                  "Remote binding description.";
              }
            }
          }
          container bindinfos {
            config false;
            description
              "List of binding informations.";
            list bindinfo {
              key "master-interface";
              description
                "Operational data of binding information.";
              leaf master-interface {
                type leafref {
                  path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
                }
                description
                  "Master inner communication interface.";
              }
              leaf ap-interface {
                type pub-type:if-name;
                description
                  "AP inner communication interface.";
              }
              leaf ap-out-interface {
                type pub-type:if-name;
                description
                  "AP external communication interface.";
              }
              leaf description {
                type string {
                  length "1..128";
                }
                description
                  "Remote binding description.";
              }
            }
          }
        }
      }
      container ap-statistics {
        config false;
        description
          "Statistics of APs managed by a master.";
        uses ap-statistics;
      }
    }
  }
  augment /ni:network-instance/ni:instances/ni:instance {
    description
      "Inner interface on master of virtual access.";
    container vaccess-interfaces {
      when "/vaccess:vaccess/vaccess:global/vaccess:role='master' and /vaccess:vaccess/vaccess:global/vaccess:port-extend-enable='true'";
      description
        "List of inner interface on master of virtual access.";
      list vaccess-interface {
        key "name";
        description
          "Configure inner interface on master of virtual access.";
        leaf name {
          type leafref {
            path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
          }
          must "/ifm:ifm/ifm:interfaces/ifm:interface[ifm:name=current()]/ifm:vrf-name='_public_'";
          must "../../../ni:name=/ifm:ifm/ifm:interfaces/ifm:interface[ifm:name=current()]/ifm:vrf-name";
          description
            "Inner interface name on master of virtual access.";
        }
      }
    }
    container vaccess-flexe-interfaces {
      when "/vaccess:vaccess/vaccess:global/vaccess:role='master' and /vaccess:vaccess/vaccess:global/vaccess:port-extend-flexe-enable='true'";
      description
        "List of inner flexe-interface on master of virtual access.";
      list vaccess-flexe-interface {
        key "name";
        description
          "Configure inner flexe-interface on master of virtual access.";
        leaf name {
          type leafref {
            path "/ifm:ifm/ifm:interfaces/ifm:interface/ifm:name";
          }
          must "/ifm:ifm/ifm:interfaces/ifm:interface[ifm:name=current()]/ifm:vrf-name='_public_'";
          must "../../../ni:name=/ifm:ifm/ifm:interfaces/ifm:interface[ifm:name=current()]/ifm:vrf-name";
          description
            "Inner flexe-interface name on master of virtual access.";
        }
      }
    }
  }
}
  
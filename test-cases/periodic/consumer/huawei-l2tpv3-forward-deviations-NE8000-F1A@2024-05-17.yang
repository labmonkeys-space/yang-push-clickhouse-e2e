  prefix l2tpv3-forward-devs-NE8000-F1A;

  import huawei-l2tpv3-forward {
    prefix l2tpv3-forward;
  }

  import huawei-devm {
    prefix devm;
  }
  
  organization
    "Huawei Technologies Co., Ltd.";

  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China

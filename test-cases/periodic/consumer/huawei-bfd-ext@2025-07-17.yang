module huawei-bfd-ext {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-bfd-ext";
  prefix bfd-ext;
  import huawei-bfd {
    prefix bfd;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-ifm-trunk {
    prefix ifm-trunk;
  }
  import huawei-extension {
    prefix ext;
  }
  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "Extended BFD functions.";
  revision 2025-07-17 {
    description
      "Modify subif-switch node default value.";
    reference
      "Huawei private.";
  }
  revision 2025-02-21 {
    description
      "Add bfd-single-hop-acl and subif-switch node.";
    reference
      "Huawei private.";
  }
  revision 2023-08-24 {
    description
      "Add bfd-ext and board-fast-switch node.";
    reference
      "Huawei private.";
  }
  revision 2019-10-27 {
    description
      "Initial revision.";
    reference
      "Huawei private.";
  }
  ext:task-name "bfd";
  augment "/ifm:ifm/ifm:interfaces/ifm:interface" {
    description
      "Configure BFD on the interface.";
    container bfd-ext {
      description
        "Configure extended BFD functions based on interfaces.";
      leaf transparent-tx-flag {
        type empty;
        must "(not(/bfd:bfd/bfd:sessions/bfd:session[bfd:out-if-name-multicast-ipv4 = current()/../../ifm:name])) and (not(/ifm:ifm/ifm:interfaces/ifm:interface/ifm-trunk:trunk/ifm-trunk:members/ifm-trunk:member[ifm-trunk:name = current()/../../ifm:name]))";
        description
          "The flag of default BFD transparent transmission.";
      }
    }
  }
  augment "/bfd:bfd" {
    description
      "The BFD augment.";
    container bfd-ext {
      description
        "Configure extended BFD functions based on BFD.";
      leaf board-fast-switch {
        type boolean;
        default "true";
        description
          "Enable/disable BFD board fast switch.";
      }
    }
    container bfd-single-hop-acl {
      description
        "Configure BFD single-Hop actions.";
      leaf subif-switch {
        type boolean;
        default "false";
        description
          "Enable/disable single-Hop BFD sub-interface acl switch.";
      }
    }
  }
}

  
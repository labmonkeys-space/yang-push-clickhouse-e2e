        }
        leaf reverse-session-current-udp {
          type uint32;
          description "Each protocol udp reverse session current info.";
        }
        leaf reverse-session-current-icmp {
          type uint32;
          description "Each protocol icmp reverse session current info.";
        }
        leaf port-current-total {
          type uint32;
          description "Each protocol total port current info.";
        }
        leaf port-current-tcp {
          type uint32;
          description "Each protocol tcp port current info.";
        }
        leaf port-current-udp {
          type uint32;
          description "Each protocol udp port current info.";
        }
        leaf port-current-icmp {
          type uint32;
          description "Each protocol icmp port current info.";
        }
        leaf port-forwarding-flag {
          type string {
            length "1..40";
          }
          description "Port forwarding flag.";
        }
        leaf port-forwarding-ports {
          type pub-type:id-range {
            ext:value-range "1..65535";
          }
          description "Port forwarding ports.";
        }
        leaf radius-specified-pcp-port {
          type boolean;
          description "The flag of the PCP port range specified by RADIUS.";
          ext:support-filter "true";
        }
        leaf pcp-start-port {
          type uint16;
          description "PCP Start port.";
        }
        leaf pcp-end-port {
          type uint16;
          description "PCP end port.";
        }
        leaf pcp-authentication {
          type boolean;
          description "PCP authentication.";
        }
        leaf pcp-session-number {
          type uint32;
          description "The number of PCP session.";
        }
        leaf token {
          type uint32;
          description "Token index.";
        }
        leaf port-limit-packet-drop-number{
          type uint32;
          description "The number of discarded packets due to port limit.";
        }
        leaf session-limit-packet-drop-number{
          type uint32;
          description "The number of discarded packets due to session limit.";
        }
        leaf fib-miss-packet-drop-number {
          type uint32;
          description "The number of discarded packets due to fib miss.";
        }
        leaf forward-tranmit-packets {
          type uint32;
          description "Number of packets sent from private network to the public network, which is statistic on cpu.";
        }
        leaf forward-tranmit-bytes {
          type uint64;
          description "The number of bytes of packets sent from private network to the public network, which is statistic on cpu.";
        }
        leaf forward-drop-packets {
          type uint32;
          description "The number of packets dropped from private network to the public network, which is statistic on cpu.";
        }
        leaf reverse-tranmit-packets {
          type uint32;
          description "Number of packets sent from public network to the private network, which is statistic on cpu.";
        }
        leaf reverse-tranmit-bytes {
          type uint64;
          description "The number of bytes of packets sent from public network to the private network, which is statistic on cpu.";
        }
        leaf reverse-drop-packets {
          type uint32;
          description "The number of packets dropped from public network to the private network, which is statistic on cpu.";
        }
        leaf fast-forward-statistics-id {
          type uint32;
          description "ID of fast forwarding statistics.";
        }
        leaf hit-fast-forward-packets {
          type uint64;
          description "Number of packets that match the fast forwarding session table from the private network to the public network.";
        }
        leaf send-to-cpu-packets {
          type uint64;
          description "Number of packets sent to cpu from the private network to the public network after matching the fast forwarding table.";
        }
        leaf reverse-hit-fast-forward-packets {
          type uint64;
          description "Number of packets that match the fast forwarding table from the public network to the private network.";
        }
        leaf reverse-send-to-cpu-packets {
          type uint64;
          description "Number of packets that match the fast forwarding table from the public network to the private network and are sent to the multi-core CPU.";
        }
      }
    }
    container user-table-usages {
      config false;
      description "List of memory usage of user-info entries of CGN board.";
      list user-table-usage {
        key "slot engine card";
        description "Statistics of memory usage of user-info table of CGN board.";
        leaf slot {
          type string {
            length "1..31";
          }
          description "Specifies the Slot ID of a service board.";
        }
        leaf engine {
          type engine-id;
          description "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description "The value is NA when the service is based on slot or engine.";
        }
        leaf total-number {
          type uint32;
          description "Total number.";
        }
        leaf used-number {
          type uint32;
          description "Used number.";
        }
        leaf free-number {
          type uint32;
          description "Free number.";
        }
        leaf usage {
          type pub-type:percent;
          description "Usage of memory.";
        }
      }
    }
    container server-maps {
      config false;
      description "List of information of server-maps.";
      list server-map {
        key "protocol source-vpn source-ip source-port source-nat-ip source-nat-port destination-vpn destination-ip destination-port destination-nat-ip destination-nat-port slot engine card";
        description "Statistics of server-map information.";
        leaf protocol {
          type string {
            length "1..31";
          }
          description "Protocol.";
        }
        leaf source-vpn {
          type leafref {
            path "/ni:network-instance/ni:instances/ni:instance/ni:name";
          }
          description "Source VPN instance name.";
        }
        leaf source-ip {
          type inet:ip-address-no-zone;
          description "Display server-map entry information with a specified source IP address.";
        }
        leaf source-port {
          type uint16;
          description "Source port.";
        }
        leaf source-nat-ip {
          type inet:ip-address-no-zone;
          description "Source NAT IP.";
        }
        leaf source-nat-port {
          type uint16;
          description "Source NAT port.";
        }
        leaf destination-vpn {
          type leafref {
            path "/ni:network-instance/ni:instances/ni:instance/ni:name";
          }
          description "Destination VPN instance name.";
        }
        leaf destination-ip {
          type inet:ip-address-no-zone;
          description "Display server-map entry information with a specified destination IP address.";
        }
        leaf destination-port {
          type uint16;
          description "Destination port.";
        }
        leaf destination-nat-ip {
          type inet:ip-address-no-zone;
          description "Destination NAT IP.";
        }
        leaf destination-nat-port {
          type uint16;
          description "Destination NAT port.";
        }
        leaf slot {
          type string {
            length "1..31";
          }
          description "Specifies the Slot ID of a service board.";
        }
        leaf engine {
          type engine-id;
          description "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description "The value is NA when the service is based on slot or engine.";
        }
        leaf direction {
          type enumeration {
            enum "positive" {
              value 1;
              description "Positive mapping.";
            }
            enum "reverse" {
              value 2;
              description "Reverse mapping.";
            }
          }
          description "Direction of a mapping rule.";
        }
        leaf instance-type {
          type instance-type;
          description "Instance Type.";
        }
        leaf instance-name {
          type string {
            length "1..31";
          }
          description "Instance name.";
        }
        leaf tag {
          type string {
            length "1..11";
          }
          description "Status of a TCP connection.";
        }
        leaf ttl {
          type string {
            length "1..20";
          }
          description "Time to live, in hh:mm:ss format.";
        }
        leaf left-time {
          type string {
            length "1..10";
          }
          description "Remaining time of a server-map entry, in hh:mm:ss format.";
        }
        leaf outbound {
          type boolean;
          description "Outbound enabled flag.";
        }
        leaf extendable {
          type boolean;
          description "The extended NAT server flag. The enable flag can be configured for multiple NAT servers with the same private IP and different public IPs in the same instance.";
        }
        leaf nat64-prefix-id {
          type uint8 {
            range "1..16";
          }
          description "NAT64 prefix ID.";
        }
        leaf cpe-ip {
          type inet:ip-address-no-zone;
          description "CPE IP.";
        }
      }
    }

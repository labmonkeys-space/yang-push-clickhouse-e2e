  typedef engine-id {
    type enumeration {
      enum "NA" {
        value 0;
        description
          "The enumeration is NA when the service is based on slot or card.";
      }
      enum "engine0" {
        value 1;
        description
          "Engine ID 0.";
      }
      enum "engine1" {
        value 2;
        description
          "Engine ID 1.";
      }
      enum "engine2" {
        value 3;
        description
          "Engine ID 2.";
      }
      enum "engine3" {
        value 4;
        description
          "Engine ID 3.";
      }
      enum "engine4" {
        value 5;
        description
          "Engine ID 4.";
      }
      enum "engine5" {
        value 6;
        description
          "Engine ID 5.";
      }
      enum "engine6" {
        value 7;
        description
          "Engine ID 6.";
      }
      enum "engine7" {
        value 8;
        description
          "Engine ID 7.";
      }
    }
    description
      "CGN engine ID.";
  }

  typedef card-id {
    type enumeration {
      enum "NA" {
        value 0;
        description
          "The enumeration is NA when the service is based on slot or engine.";
      }
      enum "card0" {
        value 1;
        description
          "Card ID 0.";
      }
      enum "card1" {
        value 2;
        description
          "Card ID 1.";
      }
    }
    description
      "CGN card ID.";
  }
  typedef instance-type {
    type enumeration {
      enum "nat" {
        value 0;
        description
          "Nat type.";
      }
      enum "ds-lite" {
        value 1;
        description
          "DS-Lite type.";
      }
      enum "nat64" {
        value 2;
        description
          "Nat64 type.";
      }
      enum "nat66" {
        value 3;
        description
          "Nat66 type.";
      }
      enum "ecgw-nat" {
        value 4;
        description
          "Ecgw-Nat type.";
      }
    }
    description
      "Instance type.";
  }
  typedef license-type{
    type enumeration{
      enum "bandwidth-board-increment"{
        value 0;
        description
          "Incremental board bandwidth.";
      }
      enum "bandwidth-board"{
        value 1;
        description
          "Board bandwidth which need to specified.";
      }
      enum "bandwidth-card"{
        value 2;
        description
          "Subcard bandwidth license type.";
      }
      enum "bandwidth-board-vsu800"{
        value 3;
        description
          "Board bandwidth of VSU800 which need to specified.";
      }
    }
    description
      "CGN bandwidth license type.";
  }

  typedef valid-flag {
    type enumeration {
      enum "valid" {
        value 0;
        description
          "Whether the license configuration is valid on the board.";
      }
      enum "invalid" {
        value 1;
        description
          "License configuration is invalid on the board.";
      }
      enum "invalid-board-type-error" {
        value 2;
        description
          "Invalid (board type error).";
      }
      enum "invalid-board-unregistered" {
        value 3;
        description
          "Invalid (board unregistered).";
      }
    }
    description
      "Valid flag type.";
  }
  typedef ve-link-mode-value {
    type enumeration {
      enum "vsgw" {
        value 1;
        description
          "Ve is linked to vSGW.";
      }
      enum "multi-access" {
        value 2;
        description
          "Ve is linked to multi-access BD.";
      }
    }
    description
      "VE link mode.";
  }
  typedef algorithm-type-value {
    type enumeration {
      enum "default" {
        value 0;
        description
          "Default sort algorithm.";
      }
      enum "by-section-id" {
        value 1;
        description
          "Sort by section id.";
      }
    }
    description
      "The sort algorithm of address pool.";
  }
  typedef mode-type-value {
    type enumeration {
      enum "default" {
        value 0;
        description
          "Default mode.";
      }
      enum "extend-mode" {
        value 1;
        description
          "Extend mode.";
      }
    }
    description
      "The mode of global-pool.";
  }
  typedef cgn-address-spec {
    type enumeration {
      enum "512K" {
        value 0;
        description
          "Maximum number of public IP addresses is 512K.";
      }
      enum "2M" {
        value 1;
        description
          "Maximum number of public IP addresses is 2M.";
      }
    }
    description
      "CGN address spec.";
  }
  container cgn {
    description
      "Carrier Grade NAT.";
    container nat-session-statisticss {
      config false;
      description
        "List of nat sessions statistics.";
      list nat-session-statistics {
        key "slot engine card";
        description
          "Statistics of nat sessions.";
        leaf slot {
          type string {
            length "1..16";
          }
          description
            "Slot ID.";
        }
        leaf engine {
          type engine-id;
          description
            "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description
            "The value is NA when the service is based on slot or engine.";
        }
        leaf session-count {
          type uint32;
          description
            "Current nat sessions count.";
        }
      }
    }
    container nat-service-infos {
      config false;
      description
        "List of nat service information.";
      list nat-service-info {
        key "slot engine card";
        description
        "Statistics of nat service.";
        leaf slot {
          type string {
            length "1..16";
          }
          description
            "Slot ID.";
          }
        leaf engine {
          type engine-id;
          description
            "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description
            "The value is NA when the service is based on slot or engine.";
        }
        container payload-statistics{
          description
          "List of nat payload statistics.";
          list payload-statistic {
            key "start-time end-time";
            description
              "Statistics of nat payload.";
            leaf start-time {
              type yang:date-and-time;
              description
                "Start time when statistics were collected.";
            }
            leaf end-time {
              type yang:date-and-time;
              description
                "End time when statistics were collected.";
            }
            leaf sampling-interval {
              ext:support-filter "true";
              type uint8 {
                range "1..24";
              }
              units "h";
              description
                "Interval for sampling.";
            }
            leaf send-average-packet-speed {
              type uint64;
              units "pps";
              description
                "Average number of sent packet speed.";
            }
            leaf send-maximum-packet-speed {
              type uint64;
              units "pps";
              description
                "Maximum number of sent packet speed.";
            }
            leaf send-average-bit-speed {
              type uint64;
              units "bit/s";
              description
                "Average number of sent bit speed.";
            }
            leaf send-maximum-bit-speed  {
              type uint64;
              units "bit/s";
              description
                "Maximum number of sent bit speed.";
            }
            leaf received-average-packet-speed {
              type uint64;
              units "pps";
              description
                "Average value of received packet speed.";
            }
            leaf received-maximum-packet-speed {
              type uint64;
              units "pps";
              description
                "Maximum number of received packet speed.";
            }
            leaf received-average-bit-speed  {
              type uint64;
              units "bit/s";
              description
                "Average number of received bit speed.";
            }
            leaf received-maximum-bit-speed  {
              type uint64;
              units "bit/s";
              description
                "Maximum number of received bit speed.";
            }
          }
        }
      }
    }
    container nat-instance-infos {
      config false;
      description
        "List of nat instance information.";
      list nat-instance-info{
        key "slot engine card instance-type instance-name";
        description
          "Statistics of nat instance.";
        leaf slot {
          type string {
            length "1..16";
          }
          description
            "Slot ID.";
        }
        leaf engine {
          type engine-id;
          description
            "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description
            "The value is NA when the service is based on slot or engine.";
        }
        leaf instance-type {
          type instance-type;
          description
            "Instance type.";
        }
        leaf instance-name {
          type string {
            length "1..31";
          }
          description
            "Instance name.";
        }
        container session-usages {
          description
            "List of nat session usage.";
          list session-usage {
            key "start-time end-time";
            description
              "Statistics of nat session.";
            leaf start-time {
              type yang:date-and-time;
              description
                "Start time when statistics were collected.";
            }
            leaf end-time {
              type yang:date-and-time;
              description
                "End time when statistics were collected.";
            }
            leaf sampling-interval {
              ext:support-filter "true";
              type uint8 {
                range "1..24";
              }
              units "h";
              description
                "Interval for sampling.";
            }
            leaf current-session-usage {
              type uint64;
              description
                "If interval is specified, the current-session-usage is filled with 0. If interval is not specified, the start/end time field is filled with 1970.";
            }
            leaf average-session-usage {
              type uint64;
              description
                "Average session usage.";
            }
            leaf maximum-session-usage {
              type uint64;
              description
                "Maximum session usage.";
            }
          }
        }
        container nat-statistics-info {
          description
            "Statistics of nat instance.";
          leaf current-user-number {
            type uint64;
            description
              "Current user number.";
          }
          leaf current-session-number {
            type uint64;
            description
              "Current session number.";
          }
        }
      }
    }
    container instance-address-usages {
      config false;
      description "List of nat address group usage.";
      list instance-address-usage {
        key "instance-type instance-name pool-name slot engine card";
        description "Statistics of address usage info on a cpu.";
        leaf instance-type {
          type instance-type;
          description
            "Instance type.";     
        }
        leaf instance-name {
          type string {
            length "1..31";
          }
          description "NAT instance name.";
        }
        leaf pool-name {      
          type string {
            length "1..31";
          }
          description "NAT address pool name.";
        }
        leaf slot {
          type string {
            length "1..15";
          }
          description "Specifies the Slot ID of a service board.";
        }
        leaf engine {
          type engine-id;
          description
            "The value is NA when the service is based on slot or card. This parameter can only be configured on a centralized-boards.";
        }
        leaf card {
          type card-id;
          description
            "The value is NA when the service is based on slot or engine. This parameter takes effect only on a VSUF-80 or VSUF-160 or VSUI-160-E.";
        }          
        leaf pool-id {
          type uint8 {
            range "0..127";
          }
          description "IP address pool ID.";
        }
        leaf pool-address-usage {
          type pub-type:percent;
          description 
            "Address usage of an IP address pool. If a section is locked, an attempt to apply for public IP addresses may fail even if address usage is not 100%.";
        }
        leaf pool-port-usage {
          type pub-type:percent;
          description 
            "Users' actual port usage. The value is the number of user actually used ports/Total number of ports (Reserved ports are not counted for the actually used ports and total ports).";
        }
        leaf pcp-allcated-port-usage {
          type pub-type:percent;
          description 
            "Usage of the reserved PCP ports allocated by the RADIUS service. The value is the number of PCP ports allocated by the RADIUS service/Total number of reserved ports.";         
        }
        leaf pcp-reserved-port-usage {
          type pub-type:percent;
          description 
            "Users' actual usage of reserved PCP ports. The value is the number of user actually used PCP ports/Total number of reserved ports (Well-known ports are not counted for the actually used PCP ports and reserved ports).";            
        }
        leaf ip-total-number {
          type uint32;
          description "Display the number of ip addresses in the nat ip address pool.";
        }
        container verbose-infos {
          description
            "List of Port usage of Single IP Address.";
          list verbose-info {
            key "public-ip";
            description
              "Statistics of Port usage of Single IP Address.";
            leaf public-ip {
              type inet:ipv4-address-no-zone;
              description "Public IPv4 address.";
            }
            leaf user-allocated-port-usage {
              type pub-type:percent;
              description
                "Port usage of a single IP address. The value is the number of ports allocated to users/Total number of ports.";
            }
            leaf session-allocated-port-usage {
              type pub-type:percent;
              description
                "This parameter takes effect only when port-reuse enable is disabled. Port usage of a single IP address for session table. The value is the number of ports allocated to sessions/Total number of ports.";          
            }
            leaf tcp-allocated-port-usage {
              type pub-type:percent;
              description
                "This parameter takes effect only when port-reuse enable is disabled. Port usage of a single IP address for tcp session table. The value is the number of ports allocated to tcp sessions/Total number of ports.";          
            }
            leaf non-tcp-allocated-port-usage {
              type pub-type:percent;
              description
                "This parameter takes effect only when port-reuse enable is disabled. Port usage of a single IP address for non-tcp session table. The value is the number of ports allocated to non-tcp sessions/Total number of ports.";          
            }
          }
        }
      }     
    }
    container nat-ip-pools {
      description
        "List of nat-ip-pool.";
      list nat-ip-pool {
        key "pool-name";
        description
          "Configure nat ip pool, used to set NAT public address.";
        leaf pool-name {
          type string {
            length "1..31";
          }
          description
            "NAT ip pool name.";
        }
        leaf vpn-name {
          ext:operation-exclude create|update|delete;
          type leafref {
            path "/ni:network-instance/ni:instances/ni:instance/ni:name";
          }
          must "/ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv4-unicast']";
          description
            "VPN instance name.";
        }
        leaf dynamic {
          ext:operation-exclude update|delete;
          type boolean;
          default "false";
          description
            "Enable/disable dynamic ip pool.";
        }
        leaf no-pat {
          ext:operation-exclude update|delete;
          type boolean;
          default "false";
          description
            "Enable/disable not use address translation with PAT.";
        }
        leaf slave {
          ext:operation-exclude update|delete;
          type boolean;
          default "false";
          description
            "Enable/disable slave chassis pool.";
        }
        container subnet-mask {
          description
            "Configure the subnet mask length when allocating address to a service-location in a nat-instance.";
          leaf initial-segment-masklen {
            type uint8 {
              range "20..32";
            }
            must "(../../no-pat='true' and ../initial-segment-masklen >= 20 and ../initial-segment-masklen <= 27) or ((../../no-pat='false' or not(../../no-pat)) and ../initial-segment-masklen >= 22 and ../initial-segment-masklen <= 32)";
            default "27";
            description
              "The mask length of initial should be 22~32 in pat mode, default is 27, and 20~27 in no-pat mode, default is 27.";
          }
          leaf extend-segment-masklen {
            type uint8 {
              range "0 | 20..32";
            }
            must "(../../no-pat='true' and ../extend-segment-masklen >= 20 and ../extend-segment-masklen <= 27) or ((../../no-pat='false' or not(../../no-pat)) and ../extend-segment-masklen >= 22 and ../extend-segment-masklen <= 32) or ../extend-segment-masklen = 0";
            default "27";
            description
              "The mask length of extend should be 22~32 in pat mode, default is 27, and 20~27 in no-pat mode, default is 27.";
          }
        }
        container subnet-threshold {
          must './ip-used-upper-limit > ./ip-used-lower-limit';
          description "Configure the attribute of the ip pool.";
          leaf ip-used-upper-limit {
            type uint8 {
              range "1..100";
            }
            default "80";
            description
              "Specifies the upper limit threshold of the address segment used by nat-instance in the global address pool.";
          }
          leaf ip-used-lower-limit {
            type uint8 {
              range "0..99";
            }
            default "20";
            description
              "Specifies the lower limit threshold of the address segment used by nat-instance in the global address pool.";
          }
        }
        container alarm {
          description "Configure the alarm parameters of the ip pool.";
          leaf alarm-log-enable {
            type boolean;
            default "true";
            description
              "Enable/disable the log warning function for the global address pool.";
          }
          leaf alarm-trap-enable {
            type boolean;
            default "true";
            description
              "Enable/disable the trap warning function for the global address pool.";
          }
          leaf alarm-threshold {
            type uint8 {
              range "60..100";
            }
            default "80";
            description
              "Specifies the alarm threshold for the global address pool. When the pool usage is greater than the alarm threshold, the device sends a global address pool usage alarm. When the pool usage is less than or equal to 7/8 of the alarm threshold, the device sends an alarm indicating that the global address pool usage is cleared.";
          }
        }
        container allocate-unlimited {
          when "../dynamic='false'";
          description "Configure the ip allocate unlimited parameters of the ip pool.";
          leaf allocate-unlimited {
            type boolean;
            default "false";
            description
              "Enable/disable the ip allocate unlimited function for the global address pool.";
          }
        }
        container auto-release-enhance {
          when "../dynamic='true' and ../slave='false'";
          must "(not (/bras-cu-agent:bras-cu-agent/bras-cu-agent:cu-agent) and ./enable = 'false') or (/bras-cu-agent:bras-cu-agent/bras-cu-agent:cu-agent)";
          description "Configure the ip auto-release-enhance switch.";
          leaf enable {
            type boolean;
            default "false";
            description
              "Enable/disable the ip auto-release-enhance switch.";
          }
          leaf start-time {
            when "../enable='true'";
            type string {
              length "1..10";
              pattern '\d{2}:\d{2}:\d{2}';
            }
            description
              "Start time of the ip auto-release-enhance function.";
          }
          leaf end-time {
            when "../enable='true' and ../start-time";
            type string {
              length "1..10";
              pattern '\d{2}:\d{2}:\d{2}';
            }
            must "../end-time != ../start-time";
            mandatory true;
            description
              "End time of the ip auto-release-enhance function.";
          }
        }
        container address-pool-mode {
          when "../dynamic='true' and ../slave='false'";
          must "not(./mode) or (/bras-cu-agent:bras-cu-agent/bras-cu-agent:cu-agent)";
          description "Configure the mode of the global dynamic address pool.";
          leaf mode {
            type enumeration {
              enum "warm-standby" {
                value 1;
                description
                  "Warm standby.";
              }
              enum "warm-standby-loadbalance" {
                value 2;
                description
                  "Warm standby loadbalance.";
              }
            }
            must "(../../no-pat='false') or (../mode='warm-standby')";
            description
              "The Mode of the global dynamic address pool.";
          }
        }
      }
    }
    container log {
      description
        "Configure cgn log global info.";
      container send-rate {
        when "/vsm:vsm/vsm:on-board-mode/vsm:mode='centralized-board'";
        description
          "Configure log send rate.";
        leaf rate {
          type uint16 {
            range "16..1000";
          }
          default "256";
          description "Specifies the rate at which NAT logs are sent, units is K logs per second.";
        }
      }
      container send-interval {
        when "/vsm:vsm/vsm:on-board-mode/vsm:mode='centralized-board'";
        description
          "Configure log send interval.";
        leaf interval-value {
          type uint16 {
            range "10..60000";
          }
          units "ms";
          default "10";
          description "Specifies the NAT log send interval, units is milliseconds.";
        }
      }
    }
    container import-ribs {
      when "/vsm:vsm/vsm:on-board-mode/vsm:mode='centralized-board'";
      description
        "List of nat-unr import-ribs policy.";
      list import-rib {
        must 'not(./source-vpn-instance=./destination-vpn-instance)';
        key "ip-type source-vpn-instance destination-vpn-instance";
        max-elements 256;
        description
          "Configure a nat-unr import-ribs policy.";
        leaf ip-type {
          type cgn-common:ip-address-type;
          description "Indicate the IP type.";
        }
        leaf source-vpn-instance {
          type leafref {
            path "/ni:network-instance/ni:instances/ni:instance/ni:name";
          }
          must "(../ip-type='ipv4' and /ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv4-unicast']) or (../ip-type='ipv6' and /ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv6-unicast'])";
          description
            "The name of source vpn-instance.";
        }
        leaf destination-vpn-instance {
          type leafref {
            path "/ni:network-instance/ni:instances/ni:instance/ni:name";
          }
          must "(../ip-type='ipv4' and /ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv4-unicast']) or (../ip-type='ipv6' and /ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv6-unicast'])";
          description
            "The name of destination vpn-instance.";
        }
        leaf status {
          type string {
            length "1..31";
          }
          config false;
          description
            "The status of nat unr import policy.";
        }
      }
    }
    container performance-adjust {
      description
        "Configure cgn performance adjust parameters.";
      container dns-fast-aging {
        description
          "Configure DNS fast aging parameter.";
        leaf enable {
          type boolean;
          default "false";
          description
            "Enable/disable the DNS session fast-aging function.";
        }
        leaf aging-time {
          type uint16 {
            range "1..20";
          }
          units "s";
          default "3";
          description "Specifies the fast-aging time of DNS session.";
        }
      }
    }
    container weighted-load-balance {
      when "/vsm:vsm/vsm:on-board-mode/vsm:mode='centralized-board'";
      description
        "Configure weighted-load-balance switch.";
      leaf centralized-nat {
        type boolean;
        default "false";
        description
          "Enable/disable weighted-load-balance for centralized-nat.";
      }
      leaf distributed-nat {
        type boolean;
        default "true";
        description
          "Enable/disable weighted-load-balance for distributed-nat.";
      }
    }
    container user-tables {
      config false;
      description "List of user information for CGN board.";
      list user-table {
        key "slot engine card user-type user-id cpe-ip vpn-instance instance-type instance-name";
        description "Statistics of user information for CGN board.";
        leaf slot {
          type string {
            length "1..16";
          }
          description "Slot ID.";
        }
        leaf engine {
          type engine-id;
          description "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description "The value is NA when the service is based on slot or engine.";
        }
        leaf user-type {
          type enumeration {
            enum "nat444" {
              value 0;
              description "NAT444 User.";
            }
            enum "ds-lite" {
              value 1;
              description "DS-Lite User.";
            }
            enum "nat64" {
              value 2;
              description "NAT64 User.";
            }
            enum "l2-aware-nat" {
              value 3;
              description "L2NAT User.";
            }
            enum "ecgw-nat" {
              value 4;
              description "ECGWNAT User.";
            }
          }
          description "User type.";
        }
        leaf user-id {
          type uint32;
          description "User ID.";
        }
        leaf cpe-ip {
          type inet:ip-address-no-zone;
          description "Displays private network user information on a CPE with a specified address.";
        }
        leaf vpn-instance {
          type leafref {
            path "/ni:network-instance/ni:instances/ni:instance/ni:name";
          }
          description "VPN instance name.";
        }
        leaf instance-type {
          type instance-type;
          description "Instance type.";
        }
        leaf instance-name {
          type string {
            length "1..31";
          }
          description "Instance name.";
        }
        leaf no-pat {
          type boolean;
          description "User hit No-PAT address-group.";
        }
        leaf address-group {
          type string {
            length "1..31";
          }
          description "Address group name.";
          ext:support-filter "true";
        }
        leaf public-ip {
          type inet:ipv4-address-no-zone;
          description "Public IPv4 address.";
          ext:support-filter "true";
        }
        leaf cpe-prefix-length {
          type uint8 {
            range "1..128";
          }
          description "Displays information about private network users on a CPE with a specified IPv6 prefix length.";
          ext:support-filter "true";
        }
        leaf start-port {
          type uint16;
          description "Start port.";
        }
        leaf port-range {
          type uint16;
          description "Port range.";
        }
        leaf port-total {
          type uint16;
          description "Port total.";
        }
        leaf port-reuse {
          type boolean;
          description "Port reuse status.";
        }
        leaf up-escape {
          type boolean;
          description "Up escape user status.";
        }
        leaf create-time {
          type string {
            length "1..20";
          }
          description "Time when the user table is generated, in yyyy-mm-dd hh:mm:ss format.";
        }
        leaf extend-port-alloc-times {
          type uint16;
          description "Extend port alloc times.";
        }
        leaf extend-port-alloc-number {

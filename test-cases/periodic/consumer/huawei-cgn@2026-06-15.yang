        }
        leaf session-current-udp {
          type uint32;
          description "Each protocol udp session current info.";
        }
        leaf session-current-icmp {
          type uint32;
          description "Each protocol icmp session current info.";
        }
        leaf reverse-session-current-total {
          type uint32;
          description "Each protocol total reverse session current info.";
        }
        leaf reverse-session-current-tcp {
          type uint32;

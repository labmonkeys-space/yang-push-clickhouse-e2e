  }
  import huawei-cgn-common {
    prefix cgn-common;
  }
  import huawei-vsm {
    prefix vsm;
  }
  import huawei-bras-cu-agent {
    prefix bras-cu-agent;
  }
  import huawei-ip {
    prefix ip;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-bd {
    prefix bd;
  }
  organization
    "Huawei Technologies Co., Ltd.";

  contact
    "Huawei Industrial Base
    Bantian, Longgang
    Shenzhen 518129
    People's Republic of China
    Website: http://www.huawei.com
    Email: support@huawei.com";

  description
    "This module contains a collection of YANG definitions for Configurations of cgn.";

        }
        leaf source-nat-port {
          type uint16;
          description "Source nat port.";
          ext:support-filter "true";
        }
        leaf destination-nat-ip {
          type inet:ip-address-no-zone;
          description "Destination nat address.";
          ext:support-filter "true";
        }
        leaf destination-nat-port {
          type uint16;
          description "Destination nat port.";
          ext:support-filter "true";
        }
        leaf three-tuple {
          type boolean;
          description "Display 3-tuple NAT session table.";
          ext:support-filter "true";
        }
        leaf pat {
          type boolean;
          description "Displays PAT or NO-PAT session table.";
          ext:support-filter "true";
        }
        leaf hit {
          type boolean;
          description "Specifies the session that is matched.";
          ext:support-filter "true";
        }
        leaf user-id {
          type uint32;
          description "User ID.";
          ext:support-filter "true";
        }
        leaf cpe-prefix-length {
          type uint8 {
            range "1..128";
          }
          description "CPE IPv6 address prefix length.";
          ext:support-filter "true";
        }
        leaf instance-type {
          type instance-type;
          description "Instance type.";
          ext:support-filter "true";
        }
        leaf instance-name {
          type string {
            length "1..31";
          }
          description "Instance name.";
          ext:support-filter "true";
        }
        leaf alg {
          type boolean;
          description "ALG session.";
          ext:support-filter "true";
        }
        leaf alg-protocol {
          type cgn-common:alg-protocol-type;
          description "ALG protocol.";
          ext:support-filter "true";
        }
        leaf pcp {
          type boolean;
          description "Displays information about PCP session table.";
          ext:support-filter "true";
        }
        leaf long-link {
          type boolean;
          description "Long link.";
          ext:support-filter "true";
        }
        leaf sudden-traffic-drop {
          type boolean;
          description "Specifies the flag for collecting data about sudden traffic drop.";
          ext:support-filter "true";
        }
        leaf fast-forward {
          type boolean;
          description "Fast forward.";
          ext:support-filter "true";
        }
        leaf tcp-connect-state {
          type string {
            length "1..12";
          }
          description "Session status flag.";
        }
        leaf master {
          type boolean;
          description "Session entry status.";
        }
        leaf create-time {
          type string {
            length "1..20";
          }
          description "Date and time when a session entry was created, in yy-mm-dd hh:mm:ss format.";
        }
        leaf ttl {
          type string {
            length "1..20";
          }
          description "Time to live, in hh:mm:ss format.";
        }
        leaf left-time {
          type string {
            length "1..20";
          }
          description "Remaining time of a session entry, in hh:mm:ss format.";
        }
        leaf application-protocol {
          type string {
            length "1..10";
          }
          description "Application layer protocol of session entries.";
        }
        leaf forward-type {
          type string {
            length "1..15";
          }
          description "Address translation type.";
        }
        leaf pcp-description {
          type string {
            length "1..128";
          }
          description "Description of a PCP flow table.";
        }
        leaf pcp-filter-ip {
          type inet:ipv4-address-no-zone;
          description "PCP Filter IP.";
        }
        leaf pcp-filter-mask {
          type inet:ipv4-address-no-zone;
          description "PCP Filter Mask.";
        }
        leaf pcp-filter-port {
          type uint16;
          description "Port number that is filtered based on the PCP flow table.";
        }
        leaf icmp-type-code {
          type string {
            length "1..6";
          }
          description "ICMP type code.";
        }
      }
    }
    container session-table-usages {
      config false;
      description "List of memory usage of session infos.";
      list session-table-usage {
        key "slot engine card";
        description "Statistics of memory usage of session info.";
        leaf slot {
          type string {
            length "1..31";
          }
          description "Specifies the Slot ID of a service board.";
        }
        leaf engine {
          type engine-id;
          description "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description "The value is NA when the service is based on slot or engine.";
        }
        leaf total-number {
          type uint32;
          description "Total number.";
        }
        leaf used-number {
          type uint32;
          description "Used number.";
        }
        leaf free-number {
          type uint32;
          description "Free number.";
        }
        leaf usage {
          type pub-type:percent;
          description "Usage of memory.";
        }
      }
    }
    container fragment-table-usages {
      config false;
      description "List of memory usage of fragments.";
      list fragment-table-usage {
        key "slot engine card";
        description "Statistics of memory usage of the fragment tables.";
        leaf slot {
          type string {
            length "1..31";
          }
          description "Specifies the Slot ID of a service board.";
        }
        leaf engine {
          type engine-id;
          description "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description "The value is NA when the service is based on slot or engine.";
        }
        leaf total-number {
          type uint32;
          description "Total number.";
        }
        leaf used-number {
          type uint32;
          description "Used number.";
        }
        leaf free-number {
          type uint32;
          description "Free number.";
        }
        leaf usage {
          type pub-type:percent;
          description "Usage of memory.";
        }
      }
    }
    container vsu-board-infos {
      config false;
      description "List of vsu board information.";
      list vsu-board-info {
        key "frame-index slot-id cpu-id";
        description "Statistics of vsu board information.";
        leaf frame-index {
          type uint32;
          description "Specifies the frame index of a service board.";
        }
        leaf slot-id {
          type string {
            length 1..15;
          }
          description "Specifies the slot ID of a service board.";
        }
        leaf cpu-id {
          type uint32;
          description "Specifies the CPU ID of a service board.";
        }
        leaf cpu-name {
          type string {
            length 1..31;
          }
          description "Specifies the CPU name of a service board.";
        }
      }
    }
    container board-level-statistics-infos {
      config false;
      description "List of board scale statistics information.";
      list board-level-statistics-info {
        key "slot";
        description "Statistics of cgn board scale statistics information.";
        leaf slot {
          type string {
            length "1..31";
          }
          description "Specifies the Slot ID of a service board.";
        }
        leaf receive-packets {
          type uint64;
          description "Number of packets received by the current slot.";
        }
        leaf send-packets {
          type uint64;
          description "The number of packets sent by the current slot.";
        }
        leaf receive-packet-rate-bps {
          type uint64;
          units "bit/s";
          description "The current rate of received packets, in bit/s.";
        }
        leaf receive-packet-rate-pps {
          type uint64;
          units "pps";
          description "The current rate of received packets, in pps.";
        }
        leaf send-packet-rate-bps {
          type uint64;
          units "bit/s";
          description "The current rate of sent packets, in bit/s.";
        }
        leaf send-packet-rate-pps {
          type uint64;
          units "pps";
          description "The current rate of sent packets, in pps.";
        }
        leaf cfg-bandwidth {
          type uint64;
          units "bit/s";
          description "Specifies the configured bandwidth value.";
        }
        leaf bandwidth-usage {
          type pub-type:percent;
          description "Display the bandwidth usage by current slot.";
        }
        leaf inbound-packets {
          type uint64;
          description "Number of Inbound packets in the current slot.";
        }
        leaf outbound-packets {
          type uint64;
          description "Number of Outbound packets in the current slot.";
        }
        leaf inbound-fail-packets {
          type uint64;
          description "Number of Inbound failure packets in the current slot.";
        }
        leaf outbound-fail-packets {
          type uint64;
          description "Number of Outbound failure packets in the current slot.";
        }
        leaf current-user-number {
          type uint64;
          description "Number of current user in the current slot.";
        }
        leaf flow-setup-rate {
          type uint64;
          description "Number of flow setup rate in the current slot.";
        }
      }
    }
    container cpu-level-statistics-infos {
      config false;
      description "List of cgn cpu scale statistics information.";
      list cpu-level-statistics-info {
        key "slot engine card";
        description "Statistics of cgn cpu scale statistics information.";
        leaf slot {
          type string {
            length "1..31";
          }
          description "Specifies the Slot ID of a service board.";
        }
        leaf engine {
          type engine-id;
          description "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description "The value is NA when the service is based on slot or engine.";
        }
        leaf cfg-session-number {
          type uint32;
          description "Specifies the configured session number.";
        }
        leaf current-session-number {
          type uint32;
          description "Specifies the current session number.";
        }
        leaf session-usage {
          type pub-type:percent;
          description "Display the percentage of the number of current sessions to the number of configured sessions.";
        }
        leaf user-number {
          type uint32;
          description "Specifies the current user number.";
        }
        leaf average-session-per-user {
          type uint32;
          description "Specifies the average number of sessions per user.";
        }
      }
    }
    container nat-ip-pool-infos {
      config false;
      description "List of nat ip pool information.";
      list nat-ip-pool-info {
        key "pool-name";
        description "Statistics of nat ip pool information.";
        leaf pool-name {
          type string {
            length "1..31";
          }
          description "NAT ip pool name.";
        }
        leaf ip-total-number {
          type uint32;
          description "Display the number of ip addresses in the nat ip address pool.";
        }
        leaf section-usage {
          type pub-type:percent;
          description "Display the nat ip pool usage.";
        }
        leaf ip-usage {
          type pub-type:percent;
          description "Display the total IP address usage calculated based on the service location usage allocated to each nat instance.";
        }
        leaf used-ip-number {
          type uint32;
          description "Display the number of ip addresses used in the nat ip address pool.";
        }
        leaf free-ip-number {
          type uint32;
          description "Displays the number of idle IP addresses in the NAT IP address pool.";
        }
        leaf max-ip-usage {
          type pub-type:percent;
          description "Display the max total IP address usage.";
        }
        leaf max-ip-usage-date {
          type yang:date-and-time;
          description "Display the max total IP address usage date.";
        }
      }
    }
    container instance-address-group-infos {
      config false;
      description "List of instance address group information.";
      list instance-address-group-info {
        key "instance-type instance-name address-group-name";
        description "Statistics of Instance address group information.";
        leaf instance-type {
          type instance-type;
          description "Instance-type.";
        }
        leaf instance-name {
          type string {
            length "1..31";
          }
          description "Instance name.";
        }
        leaf address-group-name {
          type string {
            length "1..31";
          }
          description "Address group name.";
        }
        leaf instance-index {
          type uint32;
          description "Instance index, which is internally allocated.";
        }
        leaf address-group-id {
          type uint32;
          description "Address group id.";
        }
        leaf ip-total-number {
          type uint32;
          description "Display the number of ip addresses in the address group.";
        }
        leaf used-ip-number {
          type uint32;
          description "Display the number of ip addresses used in the address group.";
        }
        leaf free-ip-number {
          type uint32;
          description "Displays the number of idle IP addresses in the address group.";
        }
      }
    }
    container instance-brief-infos {
      config false;
      description "List of brief instance information.";
      list instance-brief-info {
        key "instance-type instance-name";
        description "Statistics of Brief instance information.";
        leaf instance-type {
          type instance-type;
          description "Instance type.";
        }
        leaf instance-name {
          type string {
            length "1..31";
          }
          description "Instance name.";
        }
        leaf instance-index {
          type uint32;
          description "Instance index, which is internally allocated.";
        }
      }
    }
    container cpu-level-session-infos {
      config false;
      description "List of cgn cpu scale sessions information.";
      list cpu-level-session-info {
        key "slot engine card";
        description "Statistics of cgn cpu scale session.";
        leaf slot {
          type string {
            length "1..31";
          }
          description "Specifies the Slot ID of a service board.";
        }
        leaf engine {
          type engine-id;
          description "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description "The value is NA when the service is based on slot or engine.";
        }
        leaf tcp-session-number {
          type uint64;
          description "Specifies the tcp session number.";
        }
        leaf udp-session-number {
          type uint64;
          description "Specifies the udp session number.";
        }
        leaf dns-session-number {
          type uint64;
          description "Specifies the dns session number.";
        }
        leaf no-hit-tcp-session-number {
          type uint64;
          description "Specifies the current number of tcp sessions which did not complete the three-way handshake.";
        }
        leaf no-hit-udp-session-number {
          type uint64;
          description "Specifies the current number of udp sessions which are hit by less than three packets.";
        }
        leaf no-hit-dns-session-number {
          type uint64;
          description "Specifies the current number of dns sessions which are hit by less than two packets.";
        }
        leaf icmp-session-number {
          type uint64;
          description "Specifies the icmp session number.";
        }
        leaf other-session-number {
          type uint64;
          description "Specifies the other session number.";
        }
      }
    }
    container static-mapping {
      must "/vsm:vsm/vsm:on-board-mode/vsm:mode='centralized-board'";
      presence "Create nat static mapping.";
      description
        "Configure nat static mapping.";
      leaf inside-pool-vpn-enable {
        type boolean;
        default "false";
        description
          "Enable/disable the VPN function for the static mapping inside pools.";
      }
      container inside-pools {
        description
          "List of static mapping inside pools.";
        list inside-pool {
          key "pool-id";
          description
            "Configure static mapping inside pool, used to set static mapping inside public address.";
          leaf pool-id {
            type uint16 {
              range "1..2000";
            }
            description
              "Inside ip pool id.";
          }
          leaf vpn-instance {
            type leafref {
              path "/ni:network-instance/ni:instances/ni:instance/ni:name";
            }
            ext:operation-exclude update|delete;
            must "/cgn:cgn/cgn:static-mapping/cgn:inside-pool-vpn-enable='true'";
            must "/ni:network-instance/ni:instances/ni:instance[ni:name=current()]/l3vpn:afs/l3vpn:af[l3vpn:type='ipv4-unicast']";
            description "VPN instance name.";
          }
          leaf sort-algorithm {
            type algorithm-type-value;
            default "default";
            ext:operation-exclude update;
            description
              "Enable/disable sort-algorithm by section-id.";
          }
          container sections {
            description
              "List of inside ip pool section.";
            list section {
              key "section-id";
              description
                "Configure Static-mapping inside ip pool section.";
                leaf section-id {
                  type uint16{
                    range "1..2000";
                  }
                  description "Id of static-mapping inside ip pool section.";
                }
                leaf start-ip {
                  when "../section-id";
                  type inet:ipv4-address-no-zone;
                  mandatory true;
                  description "Start ip address of inside ip pool section.";
                }
                leaf end-ip {
                  when "../section-id";
                  type inet:ipv4-address-no-zone;
                  mandatory true;
                  description "End ip address of inside ip pool section.";
                }
            }
          }
        }
      }
      container global-pools {
        description
          "List of static mapping global pools.";
        list global-pool {
          key "pool-id";
          description
            "Configure static mapping global pool, used to set static mapping global public address.";
          leaf pool-id {
            type uint16 {
              range "1..2000";
            }
            description
              "Global ip pool id.";
          }
	        leaf extend-mode {
            type mode-type-value;
            default "default";
            ext:operation-exclude update;
            description
              "Enable/disable extend mode of global pool.";
          }
          leaf sort-algorithm {
            type algorithm-type-value;
            default "default";
            ext:operation-exclude update;
            description
              "Enable/disable sort-algorithm by section-id.";
          }
          container sections {
            description
              "List of global ip pool section.";
            list section {
              key "section-id";
              description
                "Configure static-mapping global ip pool section.";
                leaf section-id {
                  type uint16{
                    range "1..2000";
                  }
                  description "Id of static-mapping global ip pool section.";
                }
                leaf start-ip {
                  when "../section-id";
                  type inet:ipv4-address-no-zone;
                  mandatory true;
                  description "Start ip address of global ip pool section.";
                }
                leaf end-ip {
                  when "../section-id";
                  type inet:ipv4-address-no-zone;
                  mandatory true;
                  description "End ip address of global ip pool section.";
                }
            }
          }
        }
      }
      container mapping-rules {
        description
          "List of static mapping rule.";
        list mapping-rule {
          key "rule-id";
          description
            "Configure static mapping rules.";
          leaf rule-id {
            type uint16 {
              range "1..2000";
            }
            mandatory true;
            description
              "Static-mapping rule id.";
          }
          leaf inside-pool {
            type leafref {
              path "../../../inside-pools/inside-pool/pool-id";
            }
            mandatory true;
            description
              "Inside ip pool id.";
          }
          leaf global-pool {
            type leafref {
              path "../../../global-pools/global-pool/pool-id";
            }
            mandatory true;
            description
              "Global ip pool id.";
          }
          leaf start-port {
            type uint16 {
              range "256..65535";
            }
            must "(../start-port) < (../end-port) and (../start-port) mod 256 = 0";
            mandatory true;
            description "Start port of section.";
          }
          leaf end-port {
            type uint16 {
              range "256..65535";
            }
            must "(../end-port) > (../start-port) and ((../end-port) + 1) mod 256 = 0";
            mandatory true;
            description "End port of section.";
          }
          leaf port-size {
            type uint16 {
              range "64..65280";
            }
            must "(../port-size) <= ((../end-port) - (../start-port) + 1) and (../port-size) mod 64 = 0";
            mandatory true;
            description "Port size of section.";
          }
        }
      }
    }
    container nat-pool-section-infos {
      config false;
      description "List of nat ip pool section information.";
      list nat-pool-section-info {
        key "pool-name";
        description "Statistics of nat ip pool section information.";      
        leaf pool-name {
          type string {
            length "1..31";
          }
          description "NAT ip pool name.";
        }
        container section-infos {
          description "List of section information.";
          list section-info {
            key "id";
            description "Statistics of nat ip pool section information.";      
            leaf id {
              type uint32;
              description "Id.";
            }
            leaf start-address {
              type inet:ipv4-address-no-zone;
              description "The start address of the section.";
            }
            leaf end-address {
              type inet:ipv4-address-no-zone;
              description "The end address of the section.";
            }
            leaf mask-length {
              type uint8;
              description "Specifies the mask length of public IP addresses.";
            }
          }
        }
      }
    }
    container static-mapping-address-extended {
      description
        "Configure CGN static mapping spec.";
      leaf spec {
        type cgn-address-spec;
        default "512K";
        description
          "CGN static mapping spec mode.";
      }
    }
  }
  rpc filter-user-tables {
    description
      "List of the user tables.";
    ext:node-ref "/cgn:cgn/cgn:user-tables/cgn:user-table";
    input {
      leaf port-usage {
        type pub-type:percent;
        description
          "Displays information about users whose port usage is greater than the port usage.";
      }
      leaf top-ten {
        type boolean;
        description "Displays information about the top 10 users with the largest number of sessions.";
      }
      leaf by-tcp {
        when "../port-usage or ../top-ten='true'";
        type boolean;
        description "This parameter takes effect only when port-reuse enable is enabled. Can be used together with port-usage to display user information on all centralized boards whose TCP port usage is greater than or equal to a specified value. Can be used together with top-ten to display information about the top 10 users with the largest number of TCP sessions.";
      }
      leaf by-non-tcp {
        when "../port-usage or ../top-ten='true'";
        type boolean;
        description "This parameter takes effect only when port-reuse enable is enabled. Can be used together with port-usage to display user information on all centralized boards whose non-TCP (UDP/ICMP) port usage is greater than or equal to a specified value. Can be used together with top-ten to display information about the top 10 users with the largest number of non-TCP (UDP/ICMP) sessions.";
      }
      leaf session-discard {
        type boolean;
        description "Displays information about users whose packets are dropped because the rate at which packets are sent to create sessions exceeds the threshold.";
      }
      leaf exchange-ip-failed {
        type boolean;
        description "Displays information about users whose IP addresses fail to be updated.";
      }
      leaf domain {
        type string {
          length "1..64";
        }
        description "Displays information about users with a specified domain name.";
      }
      leaf user-name {
        type string {
          length "1..253";
        }
        description "Displays information about users with a specified user name.";
      }
      leaf nat-ip-pool {
        type leafref {
          path "/cgn:cgn/cgn:nat-ip-pools/cgn:nat-ip-pool/cgn:pool-name";
        }
        description "Displays information about users in a specified global address pool.";
      }
      leaf pool-section-id {
        when ../nat-ip-pool;
        type uint8;
        mandatory true;
        description "Section ID in nat ip pool.";
      }
    }
    output {
      container user-tables {
        description "List of user information for CGN board.";
        list user-table {
          key "user-type user-id cpe-ip vpn-instance instance-type instance-name";
          description "Statistics of user information for CGN board.";
          leaf user-type {
            type enumeration {
              enum "nat444" {
                value 0;
                description "NAT444 User.";
              }
              enum "ds-lite" {
                value 1;
                description "DS-Lite User.";
              }
              enum "nat64" {
                value 2;
                description "NAT64 User.";
              }
              enum "l2-aware-nat" {
                value 3;
                description "L2NAT User.";
              }
              enum "ecgw-nat" {
                value 4;
                description "ECGWNAT User.";
              }
            }
            description "User type.";
          }
          leaf user-id {
            type uint32;
            description "User ID.";
          }
          leaf cpe-ip {
            type inet:ip-address-no-zone;
            description "Displays private network user information on a CPE with a specified address.";
          }
          leaf vpn-instance {
            type leafref {
              path "/ni:network-instance/ni:instances/ni:instance/ni:name";
            }
            description "VPN instance name.";
          }
          leaf instance-type {
            type instance-type;
            description "Instance type.";
          }
          leaf instance-name {
            type string {
              length "1..31";
            }
            description "Instance name.";
          }
        }
      }
    }
  }
  rpc filter-server-maps {
    description "Get server-map infos.";
    ext:node-ref "/cgn:cgn/cgn:server-maps/cgn:server-map";
    input {
      leaf slot {
        type string {
          length "1..31";
        }
        description "Specifies the Slot ID of a service board.";
      }
      leaf engine {
        when ../slot;
        type engine-id;
        description "The value is NA when the service is based on slot or card.";
      }
      leaf card {
        when ../slot;
        type card-id;
        description "The value is NA when the service is based on slot or engine.";
      }
      leaf map-type {
        type enumeration {
          enum "static" {
            value 2;
            description "Displays server-map table information on internal servers.";
          }
          enum "dynamic" {
            value 4;
            description "Displays server-map table information automatically generated by an ALG.";
          }
          enum "port-forwarding" {
            value 5;
            description "Displays server-map table information with the port-forwarding attribute.";
          }
        }
        description "Map type.";
      }
      leaf ip {
        type inet:ipv4-address-no-zone;
        description "Display server-map entry information with a specified IP address.";
      }
      leaf port {
        type uint16 {
          range "1..65535";
        }
        description "Port number of the ServerMap table.";
      }
      leaf vpn-instance {
        type leafref {
          path "/ni:network-instance/ni:instances/ni:instance/ni:name";
        }
        description "ServerMap table of the VPN instance.";
      }
    }
    output {
      container server-maps {
        description "List of information of server-maps.";
        list server-map {
          key "protocol source-vpn source-ip source-port source-nat-ip source-nat-port destination-vpn destination-ip destination-port destination-nat-ip destination-nat-port slot engine card";
          description "Statistics of server-map information.";
          leaf protocol {
            type string {
              length "1..31";
            }
            description "Protocol.";
          }
          leaf source-vpn {
            type leafref {
              path "/ni:network-instance/ni:instances/ni:instance/ni:name";
            }
            description "Source VPN instance name.";
          }
          leaf source-ip {
            type inet:ip-address-no-zone;
            description "Display server-map entry information with a specified source IP address.";
          }
          leaf source-port {
            type uint16;
            description "Source port.";
          }
          leaf source-nat-ip {
            type inet:ip-address-no-zone;
            description "Source NAT IP.";
          }
          leaf source-nat-port {
            type uint16;
            description "Source NAT port.";
          }
          leaf destination-vpn {
            type leafref {
              path "/ni:network-instance/ni:instances/ni:instance/ni:name";
            }
            description "Destination VPN instance name.";
          }
          leaf destination-ip {
            type inet:ip-address-no-zone;
            description "Display server-map entry information with a specified destination IP address.";
          }
          leaf destination-port {
            type uint16;
            description "Destination port.";
          }
          leaf destination-nat-ip {
            type inet:ip-address-no-zone;
            description "Destination NAT IP.";
          }
          leaf destination-nat-port {
            type uint16;
            description "Destination NAT port.";
          }
          leaf slot {
            type string {
              length "1..31";
            }
            description "Specifies the Slot ID of a service board.";
          }
          leaf engine {
            type engine-id;
            description "The value is NA when the service is based on slot or card.";
          }
          leaf card {
            type card-id;
            description "The value is NA when the service is based on slot or engine.";
          }
          leaf direction {
            type enumeration {
              enum "positive" {
                value 1;
                description "Positive mapping.";
              }
              enum "reverse" {
                value 2;
                description "Reverse mapping.";
              }
            }
            description "Direction of a mapping rule.";
          }
          leaf instance-type {
            type instance-type;
            description "Instance Type.";
          }
          leaf instance-name {
            type string {
              length "1..31";
            }
            description "Instance name.";
          }
          leaf tag {
            type string {
              length "1..11";
            }
            description "Status of a TCP connection.";
          }
          leaf ttl {
            type string {
              length "1..20";
            }
            description "Time to live, in hh:mm:ss format.";
          }
          leaf life-time {
            type string {
              length "1..10";
            }
            description "Remaining time of a server-map entry, in hh:mm:ss format.";
          }
          leaf outbound {
            type boolean;
            description "Outbound enabled flag.";
          }
          leaf extendable {
            type boolean;
            description "The extended NAT server flag. The enable flag can be configured for multiple NAT servers with the same private IP and different public IPs in the same instance.";
          }
          leaf nat64-prefix-id {
            type uint8 {
              range "1..16";
            }
            description "NAT64 prefix ID.";
          }
          leaf cpe-ip {
            type inet:ip-address-no-zone;
            description "CPE IP.";
          }
        }
      }
    }
  }
  rpc reset-user-by-address-group {
    description "Reset nat user by nat address group section in nat instance.";
    ext:node-ref "/cgn:cgn/cgn:user-tables/cgn:user-table";
    input {
      leaf instance-type {
        type instance-type;
        mandatory true;
        description "Instance type.";
      }
      leaf instance-name {
        type string {
          length "1..31";
        }
        mandatory true;
        description "Instance name.";
      }
      leaf address-group {
        type string {
          length "1..31";
        }
        mandatory true;
        description "NAT instance address group name.";
      }
      leaf section-id {
        type uint8;
        mandatory true;
        description "Section ID.";
      }
    }
  }
  rpc reset-user-by-nat-ip-pool {
    description "Reset user by global nat ip pool section.";
    ext:node-ref "/cgn:cgn/cgn:user-tables/cgn:user-table";
    input {
      leaf pool-name {
        type leafref {
          path "/cgn:cgn/cgn:nat-ip-pools/cgn:nat-ip-pool/cgn:pool-name";
        }
        mandatory true;
        description "Deletes user information with a specified global address pool.";
      }
      leaf section-id {
        type uint8;
        mandatory true;
        description "Section ID in nat ip pool.";
      }
    }
  }
  rpc reset-session-table {
    description "Reset nat session table.";
    ext:node-ref "/cgn:cgn/cgn:session-tables/cgn:session-table";
    input {
      leaf slot {
        type string {
          length "1..31";
        }
        description "Slot ID.";
      }
      leaf engine {
        when ../slot;
        type engine-id;
        description "The value is NA when the service is based on slot or card.";
      }
      leaf card {
        when ../slot;
        type card-id;
        description "The value is NA when the service is based on slot or engine.";
      }
      leaf source-ip {
        type inet:ipv4-address-no-zone;
        description "Source ip address.";
      }
      leaf source-ipv6 {
        type inet:ipv6-address-no-zone;
        description "Source IPv6 address.";
      }
      leaf source-nat-ip {
        type inet:ipv4-address-no-zone;
        description "Source nat address.";
      }
      leaf source-nat-port {
        type uint16;
        description "Source nat port.";
      }
      leaf source-vpn {
        type leafref {
          path "/ni:network-instance/ni:instances/ni:instance/ni:name";
        }
        description "Source VPN instance name.";
      }
      leaf destination-ip {
        type inet:ipv4-address-no-zone;
        description "Destination global address.";
      }
      leaf destination-ipv6 {
        type inet:ipv6-address-no-zone;
        description "Destination IPv6 address.";
      }
      leaf destination-nat-ip {
        type inet:ipv4-address-no-zone;
        description "Destination address.";
      }
      leaf destination-port {
        type uint16;
        description "Destination port.";
      }
      leaf destination-vpn {
        type leafref {
          path "/ni:network-instance/ni:instances/ni:instance/ni:name";
        }
        description "Destination VPN instance name.";
      }
      leaf user-id {
        type uint32;
        description "User ID.";
      }
      leaf cpe-address {
        type inet:ipv6-address-no-zone;
        description "CPE address.";
      }
      leaf cpe-prefix-length {
        when ../cpe-address;
        type uint8 {
          range "1..128";
        }
        description "CPE address prefix length.";
      }
      leaf protocol {
        type string {
          length "1..10";
        }
        description "Protocol, such as tcp, udp, icmp, udplite, or a number in range 0-255.";
      }
      leaf instance-type {
        type instance-type;
        description "Instance type.";
      }
      leaf instance-name {
        when ../instance-type;
        type string {
          length "1..31";
        }
        description "Instance name.";
      }
      leaf long-link {
        type boolean;
        description "Long link.";
      }
      leaf pcp {
        type boolean;
        description "Port Control Protocol.";
      }
    }
  }
  rpc get-port-usage-distributes {
    description
      "Query port usage distributes in a nat-instance.";
    input {
      leaf instance-name {
        type string {
          length "1..31";
        }
        description "NAT instance name.";
      }
      leaf start-port {
        type uint16;
        default 0;
        description "Displays the number of users assigned a port range with a specified start port number.";
      }
      leaf step {
        type uint16 {
          range "64..2048";
        }
        description "Displays the number of users assigned a port range with a specified port number step.";
      }
      leaf interval-count {
        type uint8 {
          range "1..10";
        }
        default 10;
        description "Specifies the number of port ranges.";
      }
    }
    output {
      container port-range-infos {
        description "List of port range info.";
        list port-range-info {
          key "instance-name start-port";
          description
            "Statistics of the users for which ports in specified ranges have been allocated.";
          leaf instance-name {
            type string {
              length "1..31";
            }
            description "NAT instance name.";
          }
          leaf start-port {
            type uint16;
            description "Start port in a port range.";
          }
          leaf end-port {
            type uint16;
            description "End port in a port range.";
          }
          leaf user-number {
            type uint16;
            description "Number of users in a port range.";
          }
        }
      }
    }
  }
  augment "/lcs:license" {
    description
      "Configure CGN license for CGN board.";
    container active-nat-sessions {
      description
        "List of active-nat-session-table-size for CGN board.";
      list active-nat-session {
        must "/vsm:vsm/vsm:on-board-mode/vsm:mode='centralized-board'";
        key "slot engine card";
        description
          "Configure active-nat-session-table-size for CGN board.";         
        leaf slot {
          type string {
            length "1..16";
          }
          description
            "Slot ID.";
        }
        leaf engine {
          type engine-id;
          must "((../engine='NA') and (../card='NA')) or ((../engine='NA') and (not(../card='NA'))) or ((not(../engine='NA')) and (../card='NA'))";
          description
            "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          must "((../engine='NA') and (../card='NA')) or ((../engine='NA') and (not(../card='NA'))) or ((not(../engine='NA')) and (../card='NA'))";
          description
            "The value is NA when the service is based on slot or engine.";
        }
        leaf session-number {
          type uint32 {
            range "1..32";
          }
          must "((../session-number) mod 2 = 0) and (not(../engine='NA' and ../card='NA'))";
          mandatory true;
          description
            "Specifies the maximum number of NAT session tables that can be created, units: M sessions.";
        }
      }
    }
    container session-capacitys {
      config false;
      description
        "Operational state of session-table info.";
      leaf total-size {
        type uint16;
        description "Total session size, units: M sessions.";
      }
      leaf used-size {
        type uint16;
        description "Used session size, units: M sessions.";
      }
      leaf free-size {
        type uint16;
        description "Free session size, units: M sessions.";
      }
      leaf used-rate {
        type pub-type:percent;
        description "Display the session usage.";
      }
    }
    container session-capacitys-verbose-infos {
      config false;
      description
        "List of session verbose info.";
      list session-capacitys-verbose-info {
        key "slot engine card";
        description
          "Operational state of session.";
        leaf slot {
          type string {
            length "1..16";
          }
          description
            "Slot ID.";
        }
        leaf engine {
          type engine-id;
          description
            "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          description
            "The value is NA when the service is based on slot or engine.";
        }
        leaf configured-session {
          type uint32;
          description
            "Configured session size, units: M sessions.";
        }
        leaf used-session {
          type uint32;
          description
            "Used session size.";
        }
        leaf usage-of-session {
          type pub-type:percent;
          description 
            "Usage value of session table size.";
        }
        leaf valid-flag {
          type valid-flag;
          description
            "Whether the session configuration is valid on the board.";
        }
      }
    }
    container active-bandwidths {
      description 
        "List of active bandwidth for CGN board.";
      list active-bandwidth {
        must "/vsm:vsm/vsm:on-board-mode/vsm:mode='centralized-board'";
        key "slot engine card";
        description
          "Configure active-bandwidth for CGN board.";        
        leaf slot {
          type string {
            length "1..16";
          }
          description
            "Slot ID.";
        }
        leaf engine {
          type engine-id;
          must "((../engine='NA') and (../card='NA')) or ((../engine='NA') and (not(../card='NA'))) or ((not(../engine='NA')) and (../card='NA'))";
          description
            "The value is NA when the service is based on slot or card.";
        }
        leaf card {
          type card-id;
          must "((../engine='NA') and (../card='NA')) or ((../engine='NA') and (not(../card='NA'))) or ((not(../engine='NA')) and (../card='NA'))";
          description
            "The value is NA when the service is based on slot or engine.";
        } 
        leaf bandwidth-value {
          when "(../engine='NA') and (../card='NA')";
          type uint16 {
            range "20..800";
          }
          units "Gbit/s";
          mandatory true;
          description
            "The bandwidth value of a VSUI-400 series board must be an integer multiple of 20, the bandwidth value of a VSUP-100 series board must be an integer multiple of 10.";
        }       
      }
    }
    container bandwidth-capacitys {
      config false;
      description
        "List of bandwidth capacity.";
      list bandwidth-capacity {
        key "license-type";
        description
          "Statistics of bandwidth capacity.";
        leaf license-type {
          type license-type;
          description
            "CGN license type.";
        }
        leaf total-size {
          type uint32;
          description
            "Total basic bandwidth and license bandwidth of all boards on a device.";
        }
        leaf total-license-size {
          type uint32;
          description
            "Total license bandwidth.";
        }
        leaf used-license-size {
          type uint32;
          description
            "Used license bandwidth.";
        }
        leaf free-license-size {
          type uint32;
          description
            "Remaining license bandwidth.";
        }
        container verbose-infos {
          description
            "List of bandwidth verbose info.";
          list verbose-info{
            key "slot engine card";
            description
              "Operational state of bandwidth.";
            leaf slot {
              type string {
                length "1..16";
              }
              description
                "Slot ID.";
            }
            leaf engine {
              type engine-id;
              description
                "The value is NA when the service is based on slot or card.";
            }
            leaf card {
              type card-id;
              description
                "The value is NA when the service is based on slot or engine.";
            }            
            leaf basic-bandwidth {
              type uint32;
              units "GB";
              description 
                "Basic bandwidth.";
            }
            leaf config-bandwidth {
              type uint32;
              units "GB";
              description 
                "Configured enhanced bandwidth.";
            }
            leaf actual-bandwidth {
              type uint32;
              units "GB";
              description
                "Actual bandwidth.";
            }
            leaf total-bandwidth {
              type uint32;
              units "GB";
              description
                "Total bandwidth.";
            }
            leaf valid-flag {
              type valid-flag;
              description
                "Whether the bandwidth configuration is valid on the board.";
            }
            leaf barcode {
              type string {
                length "1..32";
              }
              description
                "Barcode of device, presence when in cloud mode.";
            }
            leaf active-value {
              type uint32;
              units "GB";
              description
                "Active value of bandwidth, presence when in cloud mode.";
            }
            leaf usage-value {
              type uint32;
              units "GB";
              description
                "Usage value of bandwidth, presence when in cloud mode.";
            }
            leaf used-bandwidth {
              type uint32;
              units "MB";
              description
                "Used bandwidth. units: Mbps.";
            }
            leaf usage-of-bandwidth {
              type pub-type:percent;
              description
                "Usage value of bandwidth.";
            }
          }
        }
      }
    }
  }
  augment "/ifm:ifm/ifm:interfaces/ifm:interface" {
    description "Configure binding container to an interface.";
    container bind-container {
      when "../ifm:type='LoopBack' and (../ip:ipv4/ip:addresses/ip:address/ip:ip or ../ip:ipv6/ip:addresses/ip:address/ip:ip)";
      must "(not (./instance-name) and not (./bond-name)) or ((./instance-name) and (./bond-name))";
      description "Configure container binded.";
      leaf instance-name {
        type string {
          length "1..128";
        }
        description
          "Name of an OAS instance.";
      }
      leaf bond-name {
        type string {
          length "1..64";
        }
        description
          "Name of bond interface.";
      }
    }
    container cgn {
      description
        "Configure mobile edgecloud gateway.";
      container ve-link-mode {
        when "../../ifm:type='Global-VE' or ../../ifm:type ='Virtual-Ethernet'";
        must "not(./cgn:mode) or (../../ifm:class='sub-interface' and ../../ifm:l2-mode-enable='true')";
        must "not(./cgn:mode) or (/bd:bd/bd:instances/bd:instance[bd:service-points/bd:service-point/bd:interface-name=current()/../../ifm:name]/cgn:cgn/cgn:bd-access/cgn:enable='true')";
        must "not(./cgn:mode) or (/bd:bd/bd:instances/bd:instance[bd:service-points/bd:service-point/bd:interface-name=current()/../../ifm:name]/bd:split-horizon='disable')";
        description
          "Configure the link-mode in the interface.";
        leaf mode {
          type ve-link-mode-value;
          description
            "VE link mode.";
        }
      }
    }
  }
  augment "/bd:bd/bd:instances/bd:instance" {
    description
      "Cgn-ecgw configuration to the BD module.";
    container cgn {
      description
        "Configure the edgecloud-gateway.";
      container bd-access {
        description
          "Configure the access of bd.";
        leaf enable {
          type boolean;
          default "false"; 
          description "Enable/disable the BD access function.";
        }
      }
    }
  }
  ext:task-name "nat";
}
  
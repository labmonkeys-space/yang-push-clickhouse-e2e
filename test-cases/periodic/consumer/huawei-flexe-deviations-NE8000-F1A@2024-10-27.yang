module huawei-flexe-deviations-NE8000-F1A {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-flexe-deviations-NE8000-F1A";
  prefix flexe-devs-NE8000-F1A;

  import huawei-flexe {
    prefix flexe;
  }
  import huawei-vaccess {
    prefix vaccess;
  }
  import huawei-vaccess-master {
    prefix vaccess-master;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-flexe module.";

  revision 2024-10-27 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  typedef flexe-sub-ts-granula-type-deviations {
    type enumeration {
      enum 1G {
        value 1;
        description
          "Sub-timeslot granularity 1G.";
      }
      enum 5G {
        value 0;
        description
          "The sub-timeslot granularity is not supported.";
      }
    }
    description
      "Setting sub-timeslot granularity.";
  }

  deviation "/vaccess:vaccess/vaccess-master:flexe-master/flexe:groups" {
    deviate not-supported;
  }
  deviation "/vaccess:vaccess/vaccess-master:flexe-master/flexe:clients" {
    deviate not-supported;
  }
  deviation "/vaccess:vaccess/vaccess-master:flexe-master/flexe:bind-abilitys" {
    deviate not-supported;
  }
  deviation "/flexe:flexe/flexe:card-attributes/flexe:card-attribute/flexe:sub-timeslot-granula" {
    deviate replace {
      type flexe-devs-NE8000-F1A:flexe-sub-ts-granula-type-deviations;
    }
  }
  deviation "/flexe:flexe/flexe:groups/flexe:group/flexe:padding-enable" {
    deviate delete {
      default "false";
    }
  }
  deviation "/flexe:flexe/flexe:groups/flexe:group/flexe:index" {
    deviate delete {
      must 'not(/vaccess:vaccess/vaccess-master:flexe-master/flexe:groups/flexe:group[flexe:index=current()])';
    }
  }
  deviation "/flexe:flexe/flexe:clients/flexe:client/flexe:index" {
    deviate delete {
      must 'not(/vaccess:vaccess/vaccess-master:flexe-master/flexe:clients/flexe:client[flexe:index=current()])';
    }
  }
}

  
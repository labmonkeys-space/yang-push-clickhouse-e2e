module huawei-flowspec-forward {
  namespace "urn:huawei:yang:huawei-flowspec-forward";
  prefix flowspec-forward;
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-devm {
    prefix devm;
  }
  import huawei-extension {
    prefix ext;
  }
  import ietf-inet-types {
    prefix inet;
  }
  import huawei-network-instance {
    prefix ni;
  }
  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "Flowspec-forward.";
  revision 2025-10-11 {
    description
      "Add source-community for flowspec-rule.";
    reference
      "Huawei private.";
  }
  revision 2025-03-26 {
    description
      "Add new enum.";
    reference
      "Huawei private.";
  }
  revision 2024-11-18 {
    description
      "Modify description.";
    reference
      "Huawei private.";
  }
  revision 2024-08-06 {
    description
      "Add new container.";
    reference
      "Huawei private.";
  }
  revision 2024-05-17 {
    description
      "Add new leaf for flowspec-forward.";
    reference
      "Huawei private.";
  }
  revision 2024-04-22 {
    description
      "Add new container and enum.";
    reference
      "Huawei private.";
  }
  revision 2024-03-25 {
    description
      "Add new enum and leafs.";
    reference
      "Huawei private.";
  }
  revision 2023-10-26 {
    description
      "Add new containers.";
    reference
      "Huawei private.";
  }
  revision 2023-07-05 {
    description
      "Modify the slot regular expression.";
    reference
      "Huawei private.";
  }
  revision 2023-04-20 {
    description
      "1.Add new enum for packet-match-type/type.
       2.Add destination-community for flowspec-rule.";
    reference
      "Huawei private.";
  }
  revision 2023-03-15 {
    description
      "Modify packet-match-types.";
    reference
      "Huawei private.";
  }
  revision 2023-02-22 {
    description
      "Add new containers.";
    reference
      "Huawei private.";
  }
  revision 2023-01-16 {
    description
      "Add new containers.";
    reference
      "Huawei private.";
  }
  revision 2022-07-19 {
    description
      "Modify flowspec-rule/as type range.";
    reference
      "Huawei private.";
  }
  revision 2022-03-16 {
    description
      "Add new nodes.";
    reference
      "Huawei private.";
  }
  revision 2022-02-26 {
    description
      "Modify flowspec-rule/as type range.";
    reference
      "Huawei private.";
  }
  revision 2021-12-14 {
    description
      "Modify slot-id pattern.";
    reference
      "Huawei private.";
  }
  revision 2020-03-12 {
    description
      "Descriptive optimization.";
    reference
      "Huawei private.";
  }
  revision 2020-02-25 {
    description
      "The modifications in the schema file are synchronized to the YANG file.";
    reference
      "Huawei private.";
  }
  revision 2019-12-31 {
    description
      "The modifications in the schema file are synchronized to the YANG file.";
    reference
      "Huawei private.";
  }
  revision 2019-11-18 {
    description
      "The modifications in the schema file are synchronized to the YANG file.";
    reference
      "Huawei private.";
  }
  revision 2019-10-24 {
    description
      "The modifications in the schema file are synchronized to the YANG file.";
    reference
      "Huawei private.";
  }
  revision 2019-04-20 {
    description
      "Initial revision.";
    reference
      "Huawei private.";
  }
  ext:task-name "qos";

  typedef match-fragment-ip-version {
    type enumeration {
      enum ipv4 {
        value "0";
        description
         "The IPv4 protocol.";
      }
    }
    description
     "This value represents the version of the IP protocol.";
  }
  container flowspec-forward {
    description
      "Configure flowspec forward.";    
    leaf statistic-enable {
        type boolean;
        default "false";
          description
            "Enable/disable flowspec statistic.";
    }
    leaf vxlan-packet-enable {
        type boolean;
        default "false";
          description
            "Enable/disable flowspec only for the vxlan packet.";
    }
    leaf match-ip-layer {
        type boolean;
        default "false";
          description
            "Enable/disable flowspec only for the IP layer.";
    }
    leaf match-ip-layer-vxlan-pop {
        type boolean;
        default "false";
          description
            "Enable/disable flowspec only for the IP layer vxlan pop.";
    }
    container protocol-protect-disables {
      description
        "List of flowspec protocol-protect disable.";
      list protocol-protect-disable {
        key "flow-type";
        description
        "Configure protocol-protect disable instance.";
        leaf flow-type {
          type enumeration {
            enum ipv4 {
              value 0;
              description
                "Protocol-protect disable IPv4.";
            }
            enum ipv6 {
              value 1;
              description
                "Protocol-protect disable IPv6.";
            }
          }
          description
            "BGP protocol-protect disable flowtype, The value all is mutually exclusive with IPv4 and IPv6.";
        }
      }
    }
    container flowspec-match-protocol-fragments {
      description
        "List of configure flowspec protocol fragmentation rules complies with RFC 5575.";
      list flowspec-match-protocol-fragment {
        key "protocol";
        description
          "Configure flowspec protocol fragmentation rules complies with RFC 5575.";
        leaf protocol {
          type match-fragment-ip-version;
          description
            "IP family type.";
        }
      }
    }
    container cascading-modes {
      description
        "List of configure match flowspec global rule after interface-based miss.";
      list cascading-mode {
        key "type";
        description 
          "Configure match flowspec global rule after interface-based miss.";
        leaf type {
            type enumeration {
              enum ipv4 {
                value 1;
                description
                  "IPv4.";
              }
              enum ipv6 {
                value 2;
                description
                  "IPv6.";
              }
            }
            description
              "IP family type.";
          }
      }
    }
    container allow-dscp {
      description
        "Configure flowspec allow dscp.";
      leaf enable {
        type boolean;
        default "false";
        description
          "Enable/disable flowspec allow dscp.";
      }
    }
    container packet-match-types {
      description
        "List of configure BGP flowspec packet match type.";
      list packet-match-type {
        key "type";
        description
          "Configure BGP flowspec packet match type.";
        leaf type {
          type enumeration {
            enum ipv6-fragment-inner-protocol {
              value 0;
              description
                "Match IPv6 fragment inner protocol.";
            }
            enum srv6-inner-ip {
              value 1;
              description
                "Match SRv6 inner IP.";
            }
            enum match-rule-enhance {
              value 2;
              description
                "Match rule enhance.";
            }
            enum match-rule-ipv6-enhance {
              value 3;
              description
                "Match rule IPv6 enhance.";
            }
            enum match-bras-ipv4 {
              value 4;
              description
                "Match bras IPv4.";
            }
            enum match-bras-ipv6 {
              value 5;
              description
                "Match bras IPv6.";
            }
            enum vpnv4-match-int-group {
              value 6;
              description
                "Vpnv4 Match Int Group.";
            }
          }
          description
            "BGP flowspec packet match type.";
        }
      }
    }
    container ddos {
      presence "Enter the view for BGP flowspec DDoS fast effect.";
      description
        "Enable/disable BGP flowspec DDoS fast effect.";
      container peers {
        description
          "List of configure BGP flowspec peers for DDoS fast effect.";
        list peer {
          key "address vpn-instance-name";
          max-elements  "16384";
          description
            "Configure BGP flowspec peers for DDoS fast effect.";
          leaf address {
            type inet:ip-address-no-zone;
            description
              "Connection address of a peer, which can be an IPv4 or IPv6 address.";
          }
          leaf vpn-instance-name {
            type leafref {
              path "/ni:network-instance/ni:instances/ni:instance/ni:name";
            }
            description
              "Specify a VPN instance name. Public network vpn-name value is '_public_'.";
          }
        }
      }
    }
    container flowspec-rules {
      config false;
      description
        "List of flowspec rule.";
      list flowspec-rule {
        key "slot-id flow-route-index index";
        description
          "Operational data of flowspec rule.";
        leaf slot-id {
          type string {
            length "1..16";
            pattern '((c[cl]c\d+/)|(\d+/))?\d+';
          }
          description
            "Slot ID.";
        }
        leaf flow-route-index {
          type uint32 {
            range "1..4294967295";
          }
          description
            "Specify the flow-route Index.";
        }
        leaf index {
          type uint32 {
            range "1..4294967295";
          }
          description
            "Logical index of combination rule.";
        }
        leaf source-ip {
          type inet:ipv4-address-no-zone;
          description
            "Source IPv4 address.";
        }
        leaf source-ip-prefix {
          type string {
            length "0..4";
          }
          description
            "Source IPv4 prefix length.";
        }
        leaf destination-ip {
          type inet:ipv4-address-no-zone;
          description
            "Destination IPv4 address.";
        }
        leaf destination-ip-prefix {
          type string {
            length "0..4";
          }
          description
            "Destination IPv4 prefix length.";
        }
        leaf protocol {
          type uint16;
          description
            "Protocol number.";
        }
        leaf source-port {
          type uint16;
          description
            "Source port.";
        }
        leaf destination-port {
          type uint16;
          description
            "Destination port.";
        }
        leaf fragment-flag {
          type uint8;
          description
            "Fragment flag: 0 indicates the non-fragment; 1 indicates the fragment; 2 indicates fragmentation is ignored.";
        }
        leaf first-fragment-flag {
          type uint8;
          description
            "First fragment flag: 0 indicates the non-start fragment; 1 indicates the start fragment; 2 indicates whether the first fragment is ignored.";
        }
        leaf middle-fragment-flag {
          type uint8;
          description
            "Middle fragment flag: 0 indicates the non-middle fragment; 1 indicates the middle fragment; 2 indicates that the middle fragment is ignored.";
        }
        leaf last-fragment-flag {
          type uint8;
          description
            "Last fragment flag: 0 indicates the non-last fragment; 1 indicates the last fragment; 2 indicates that the last fragment is ignored.";
        }
        leaf do-not-fragment-flag {
          type uint8;
          description
            "Don't fragment flag: 0 indicates that fragmentation is enabled; 1 indicates fragmentation is disabled; 2 indicates whether to disable fragmentation is ignored.";
        }
        leaf tcp-flag {
          type uint8;
          description
            "Flag of a TCP header.";
        }
        leaf dscp {
          type uint8;
          description
            "Identifier of packet priority.";
        }
        leaf icmp-type {
          type uint8;
          description
            "ICMP type.";
        }
        leaf icmp-code {
          type uint8;
          description
            "ICMP code.";
        }
        leaf as {
          type uint16 {
            range "0..511";
          }
          description
            "Number to which an AS number is mapped.";
        }
        leaf packet-length-begin {
          type uint32 {
            range "0..4294967295";
          }
          description
            "Packet length begin.";
        }
        leaf packet-length-end {
          type uint32 {
            range "0..4294967295";
          }
          description
            "Packet length end.";
        }
        leaf destination-community {
          type uint16 {
            range "1..511";
          }
          description
            "Destination community.";
        }
        leaf source-community {
          type uint16 {
            range "1..511";
          }
          description
            "Source community.";
        }
      }
    }

    container flowspec-ipv6-rules {
      config false;
      description
        "List of flowspec IPv6 rule.";
      list flowspec-ipv6-rule {
        key "slot-id flow-route-index index";
        description
          "Operational data of flowspec IPv6 rule.";
        leaf slot-id {
          type string {
            length "1..16";
            pattern '((c[cl]c\d+/)|(\d+/))?\d+';
          }
          description
            "Slot ID.";
        }
        leaf flow-route-index {
         type uint32 {
            range "1..4294967295";
          }
          description
            "Specify the flow-route Index.";
        }
        leaf index {
          type uint32 {
            range "1..4294967295";
          }
          description
            "Logical index of combination rule.";
        }
        leaf source-ip {
          type inet:ipv6-address-no-zone;
          description
            "Source IPv6 address.";
        }
        leaf source-ip-prefix {
          type string {
            length "0..4";
          }
          description
            "Source IPv6 prefix length.";
        }
        leaf destination-ip {
          type inet:ipv6-address-no-zone;
          description
            "Destination IPv6 address.";
        }
        leaf destination-ip-prefix {
          type string {
            length "0..4";
          }
          description
            "Destination IPv6 prefix length.";
        }
        leaf protocol {
          type uint16;
          description
            "Protocol number.";
        }
        leaf source-port {
          type uint16;
          description
            "Source port.";
        }
        leaf destination-port {
          type uint16;
          description
            "Destination port.";
        }
        leaf fragment-flag {
          type uint8;
          description
            "Fragment flag: 0 indicates the non-fragment; 1 indicates the fragment; 2 indicates fragmentation is ignored.";
        }
        leaf first-fragment-flag {
          type uint8;
          description
            "First fragment flag: 0 indicates the non-start fragment; 1 indicates the start fragment; 2 indicates whether the first fragment is received is ignored.";
        }
        leaf tcp-flag {
          type uint8;
          description
            "Flag of a TCP header.";
        }
        leaf dscp {
          type uint8;
          description
            "Identifier of packet priority.";
        }
        leaf icmp-type {
          type uint8;
          description
            "ICMP type.";
        }
        leaf icmp-code {
          type uint8;
          description
            "ICMP code.";
        }
        leaf packet-length-begin {
          type uint32 {
            range "0..4294967295";
          }
          description
            "Packet length begin.";
        }
        leaf packet-length-end {
          type uint32 {
            range "0..4294967295";
          }
          description
            "Packet length end.";
        }
        leaf as {
          type uint16 {
            range "1..511";
          }
          description
            "AS.";
        }
        leaf destination-community {
          type uint16 {
            range "1..511";
          }
          description
            "Destination community.";
        }
        leaf source-community {
          type uint16 {
            range "1..511";
          }
          description
            "Source community.";
        }
      }
    }

    container flowspec-rule-statisticss {
      config false;
      description
        "List of flowspec rule statistics.";
      list flowspec-rule-statistics {
        key "slot-id protocol";
        description
          "Flowspec rule statistics.";
        leaf slot-id {
          type string {
            length "1..16";
            pattern '((c[cl]c\d+/)|(\d+/))?\d+';
          }
          description
            "Slot ID.";
        }
        leaf protocol {
          type inet:ip-version;
          description
            "Ip family type.";
        }
        leaf rule-numbers {
          type uint32;
          description
            "Rule numbers.";
        }
      }
    }

    container flowspec-global-resources {
      config false;
      description
        "List of the flowspec global resource.";
      list flowspec-global-resource {
        key "slot-id address-family pool";
        description
          "Operational data of flowspec global resource.";
        leaf slot-id {
          type string {
            length "1..31";
            pattern '((c[cl]c\d+/)|(\d+/))?\d+';
          }
          description
            "Slot ID.";
        }
        leaf address-family {
          type inet:ip-version;
          description
            "Address family.";
        }
        leaf pool {
          type string {
            length "1..32";
          }
          description
            "Resource pool.";
        }
        leaf used-number {
          type uint32;
          description
            "Used resource.";
        }
        leaf free-number {
          type uint32;
          description
            "Free resource.";
        }
        leaf utilization-rate {
          type uint32{
            range "0..100";
          }
          description
            "Resource utilization rate.";
        }
      }
    }

    container flowspec-interface-resources {
      config false;
      description
        "List of the flowspec interface resource.";
      list flowspec-interface-resource {
        key "slot-id address-family pool";
        description
          "Operational data of flowspec interface resource.";
        leaf slot-id {
          type string {
            length "1..31";
            pattern '((c[cl]c\d+/)|(\d+/))?\d+';
          }
          description
            "Slot ID.";
        }
        leaf address-family {
          type inet:ip-version;
          description
            "Address family.";
        }
        leaf pool {
          type string {
            length "1..32";
          }
          description
            "Resource pool.";
        }
        leaf used-number {
          type uint32;
          description
            "Used resource.";
        }
        leaf free-number {
          type uint32;
          description
            "Free resource.";
        }
        leaf utilization-rate {
          type uint32{
            range "0..100";
          }
          description
            "Resource utilization rate.";
        }
      }
    }

    container redirect-wtr-time {
      description
        "Configure flowspec redirect wtr time.";
      leaf wtr-time {
        type uint32 {
          range "1..60";
        }
        units "s";
        description
          "Wtr time value, the empirical value is 5.";
      }
    }
  }
  
  augment "/ifm:ifm/ifm:interfaces/ifm:interface" {
    description
            "Flowspec forward.";
    container flowspec-forward {
      description
        "Configure flowspec forward.";
      container refluence {
        presence "create flowspec refluence";
        description
          "Enable/disable flowspec refluence.";
      }
      container tunnel-pop {
        presence "create tunnel-pop";
        description
         "Enable/disable flowspec after tunnel pop."; 
      }
      container disables {
        description
          "List of flowspec disables.";
        list disable {
          must "not(../../refluence)";
          must "(./flow-type='all' and not(../disable[flow-type='ipv4']) and not(../disable[flow-type='ipv6'])) or (./flow-type!='all' and not(../disable[flow-type='all']))";
          key "flow-type";
          description
          "Configure flowspec disable instance.";
          leaf flow-type {
            type enumeration {
              enum all {
                value 0;
                description
                  "Flowspec disable.";
              }
              enum ipv4 {
                value 1;
                description
                  "Flowspec disable IPv4.";
              }
              enum ipv6 {
                value 2;
                description
                  "Flowspec disable IPv6.";
              }
            }
            description
              "BGP flowspec disable flowtype, The value all is mutually exclusive with IPv4 and IPv6.";
          }
          leaf sub-port-exclude {
            when "../../../../ifm:class='main-interface'";
            type boolean;
            default "false";
            description
              "Enable/disable sub-port exclude.";
          }
        }
      }
    }
  }

  augment "/devm:devm/devm:lpu-boards/devm:lpu-board" {
    description
      "Flowspec forward.";
    container flowspec-forward {
      description
          "Configure flowspec forward.";
      container ipv6-flowspec-enable {
        presence "ipv6-flowspec-enable";
        description
          "Enable/disable IPv6-flowspec.";
      }
      container flowspec-enables {
        description
          "List of flowspec enables.";
        list flowspec-enable {
          key "flow-type";
          description
            "Configure bgp flowspec on VSU board.";
          leaf flow-type {
            type enumeration {
              enum ipv4 {
                value 0;
                description
                  "Flowspec IPv4.";
              }
              enum ipv6 {
                value 1;
                description
                  "Flowspec IPv6.";
              }
            }
            description
              "IP family type of flowspec.";
          }
        }
      }
    }
  }
}

  
    deviate not-supported;
  }
  deviation "/pic:pic/pic:panel-split-ports/pic:panel-split-port/pic:split-type" {
    deviate replace {
      type pic-devs-NE8000-F1A:panel-split-ports-split-type-deviations;
    }
  }
  deviation "/pic:pic/pic:auto-clears/pic:auto-clear/pic:type" {
    deviate replace {
      type pic-devs-NE8000-F1A:auto-clear-deviations;
    }
  }
  deviation "/devm:devm/devm:ports/devm:port/pic:ethernet/pic:speed" {
    deviate replace {
      type pic-devs-NE8000-F1A:eth-speed-type-deviations;
    }
  }
  deviation "/devm:devm/devm:ports/devm:port/pic:ethernet/pic:negotiation-mode" {
    deviate replace {
      type pic-devs-NE8000-F1A:port-negotiation-mode-type-deviations;
    }
  }
  deviation "/devm:devm/devm:ports/devm:port/pic:optical-module/pic:wavelength-adjustment/pic:by-wavelength/pic:tunable-wavelength" {
    deviate delete {
      units "10 fm";
    }
  }
  deviation "/devm:devm/devm:ports/devm:port/pic:optical-module/pic:wavelength-adjustment/pic:by-frequency/pic:tunable-frequency" {
    deviate delete {
      units "10 MHz";
    }
  }
  deviation "/devm:devm/devm:ports/devm:port/pic:port-alarm/pic:alarm-type/pic:crc-error-threshold/pic:crc-error-threshold/pic:crc-error-interval" {
    deviate add {
      must 'not(../crc-error-percent-alm-thr)';
    }
  }
  deviation "/devm:devm/devm:ports/devm:port/pic:port-alarm/pic:alarm-type/pic:link-crc/pic:crc-per-alarm/pic:crc-per-alm-thr-power" {
    deviate replace {
      type uint32 {
        range "1..5";
      }
    }
  }
  deviation "/devm:devm/devm:ports/devm:port/pic:port-alarm/pic:alarm-type/pic:link-crc/pic:crc-per-alarm/pic:crc-per-rsum-thr-power" {
    deviate replace {
      type uint32 {
        range "1..6";
      }
    }
  }
  deviation "/lcs:license/pic:lcs-ports/pic:port-basic/pic:port-band" {
    deviate replace {
      type enumeration {
        enum 200G {
          value 1;
          description
            "Upgrade to 200G.";
        }
        enum 400G {
          value 2;
          description
            "Upgrade to 400G.";
        }
        enum 300G {
          value 3;
          description
            "Upgrade to 300G.";
        }
        enum 50G {
          value 8;
          description
            "Upgrade to 50G.";
        }
        enum 100G {
          value 9;
          description
            "Upgrade to 100G.";
        }
        enum 10G {
          value 4;
          description
            "Upgrade to 10G.";
        }
        enum 25G {
          value 11;
          description
            "Upgrade to 25G.";
        }
      }
    }
  }
  deviation "/devm:devm/devm:cards/devm:card/pic:port-group-modes/pic:port-group-mode/pic:mode-type" {
    deviate replace {
      type pic-devs-NE8000-F1A:card-port-group-mode-type-deviations;
    }
  }
  ext:deviation-ext "/pic:pic/pic:auto-clears/pic:auto-clear/pic:time" {
    ext:deviate-ext "replace" {
      ext:dynamic-default {
        ext:default-value "20" {
          when "../type = 'physical-mode'";
          description
            "The default value is 20 when type is physical-mode.";
        }
      }
    }
  }
}

  
module huawei-pic-deviations-NE8000-F1A {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-pic-deviations-NE8000-F1A";
  prefix pic-devs-NE8000-F1A;

  import huawei-pic {
    prefix pic;
  }
  import huawei-driver {
    prefix driver;
  }
  import huawei-devm {
    prefix devm;
  }
  import huawei-license {
    prefix lcs;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-extension {
    prefix ext;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-pic module.";

  revision 2025-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  typedef auto-clear-deviations {
    type enumeration {
      enum physical-mode {
        value 14;
        description
          "Physical mode.";
      }
    }
    description
      "Auto Clear Type.";
  }

  typedef eth-speed-type-deviations {
    type enumeration {
      enum 10M {
        value 0;
        description
          "Configure 10M.";
      }
      enum 100M {
        value 1;
        description
          "Configure 100M.";
      }
      enum 1000M {
        value 2;
        description
          "Configure 1000M.";
      }
      enum auto {
        value 9;
        description
          "Auto.";
      }
    }
    description
      "Speed type.";
  }

  typedef port-negotiation-mode-type-deviations {
    type enumeration {
      enum slave {
        value 0;
        description
          "Slave.";
      }
    }
    description
      "Port negotiation mode.";
  }

  typedef card-port-group-mode-type-deviations {
    type enumeration {
      enum 25GE-10GE {
        value 1;
        description
          "Configure 25GE-10GE.";
      }
      enum 10GE-1GE {
        value 2;
        description
          "Configure 10GE-1GE.";
      }
      enum 50GE-25GE {
        value 5;
        description
          "Configure 50GE-25GE.";
      }
      enum 50GE-10GE {
        value 6;
        description
          "Configure 50GE-10GE.";
      }
    }
    description
      "Switch mode.";
  }

  typedef panel-split-ports-split-type-deviations {
    type enumeration {
      enum 4X10GE {
        value 1;
        description
          "Four 10G optical fiber ports.";
      }
      enum 1X40GE {
        value 2;
        description
          "One 40G optical fiber port.";
      }
      enum 1X100GE {
        value 3;
        description
          "One 100G optical fiber port.";
      }
      enum 10X10GE {
        value 4;
        description
          "Ten 10G optical fiber ports.";
      }
      enum 4X25GE-NULL {
        value 5;
        description
          "Split to 4*25GE on other ports.";
      }
      enum 4X10GE-1X40GE {
        value 9;
        description
          "Split to 1*40GE on current port and 4*10GE on other ports.";
      }
      enum 4X10GE-4X10GE {
        value 10;
        description
          "Split to 4*10GE on current port and 4*10GE on other ports.";
      }
      enum NULL-1X100GE {
        value 12;
        description
          "Split to 1*100GE on current port.";
      }
      enum 1X400GE {
        value 13;
        description
          "One 400GE port.";
      }
      enum NULL-2X25GE {
        value 15;
        description
          "Split to 2*25GE on other ports.";
      }
      enum 1X50GE-NULL {
        value 16;
        description
          "Split to 1*50GE on current port.";
      }
      enum 1X25GE-2X1GE {
        value 17;
        description
          "Split to 1*25GE on current port and 2*1GE on other ports.";
      }
      enum 1X10GE-2X10GE {
        value 18;
        description
          "Split to 1*10GE on current port and 2*10GE on other ports.";
      }
      enum 1X25GE-NULL {
        value 19;
        description
          "Split to 1*25GE on current port and null on other ports.";
      }
      enum 1X10GE-1X10GE {
        value 20;
        description
          "Split to 1*10GE on current port and 1*10GE on another port.";
      }
      enum ADAPT {
        value 21;
        description
          "Auto-adapt.";
      }
      enum 4X25GE {
        value 22;
        description
          "Four 25G optical fiber ports.";
      }
      enum 1X50GE {
        value 23;
        description
          "One 50G optical fiber port.";
      }
      enum 2X50GE {
        value 24;
        description
          "Two 50G optical fiber ports.";
      }
      enum 2X100GE {
        value 26;
        description
          "Two 100G optical fiber ports.";
      }
      enum 4X100GE {
        value 27;
        description
          "Four 100G optical fiber ports.";
      }
      enum 2X200GE {
        value 28;
        description
          "Two 200G optical fiber ports.";
      }
      enum 3X100GE {
        value 42;
        description
          "Three 100G optical fiber ports.";
      }
      enum 1X400GE-2XOA {
        value 52;
        description
          "Split to 1*400GE on current port and 2*OpticalAmplifier on other ports.";
      }
    }
    description
      "Enum of split type.";
  }

  deviation "/pic:pic/pic:alarm-ais-inserts" {
    deviate not-supported;
  }
  deviation "/pic:pic/pic:port-extends" {
    deviate not-supported;
  }

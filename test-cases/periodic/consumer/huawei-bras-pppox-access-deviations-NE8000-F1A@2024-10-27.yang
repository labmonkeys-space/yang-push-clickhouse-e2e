module huawei-bras-pppox-access-deviations-NE8000-F1A {
  namespace "urn:huawei:yang:huawei-bras-pppox-access-deviations-NE8000-F1A";
  prefix bras-pppox-access-devs-NE8000-F1A;

  import huawei-bras-pppox-access {
    prefix bras-pppox-access;
  }
  import huawei-bras-cu-controller {
    prefix bras-cu-controller;
  }
  import huawei-devm {
    prefix devm;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-bras-pppox-access module.";

  revision 2024-10-27 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  deviation "/bras-pppox-access:bras-pppox-access/bras-pppox-access:cu-ppp-chasten-infos" {
    deviate not-supported;
  }
  deviation "/bras-pppox-access:bras-pppox-access/bras-pppox-access:cu-ppp-option105-chasten-statistics" {
    deviate not-supported;
  }
  deviation "/bras-pppox-access:reset-cu-ppp-statistic" {
    deviate not-supported;
  }
  deviation "/bras-pppox-access:reset-cu-pppoe-statistic" {
    deviate not-supported;
  }
  deviation "/bras-pppox-access:reset-cu-chasten-ppp-user-by-mac" {
    deviate not-supported;
  }
  deviation "/bras-pppox-access:reset-cu-chasten-ppp-user-by-option105" {
    deviate not-supported;
  }
  deviation "/devm:devm/devm:lpu-boards/devm:lpu-board/bras-pppox-access:bras-pppox" {
    deviate not-supported;
  }
  deviation "/bras-cu-controller:bras-cu-controller/bras-cu-controller:resource-ups/bras-cu-controller:resource-up/bras-pppox-access:pppox" {
    deviate not-supported;
  }
  deviation "/bras-cu-controller:bras-cu-controller/bras-cu-controller:upmng-instances/bras-cu-controller:upmng-instance/bras-cu-controller:loadbalance-instances/bras-cu-controller:loadbalance-instance/bras-pppox-access:pppox" {
    deviate not-supported;
  }
  deviation "/bras-pppox-access:bras-pppox-access/bras-pppox-access:ppp-user-infos/bras-pppox-access:ppp-user-info/bras-pppox-access:user-id" {
    deviate replace {
      type uint32 {
        range "0..3145727";
      }
    }
  }
  deviation "/devm:devm/devm:mpu-boards/devm:mpu-board/bras-pppox-access:bras-pppox/bras-pppox-access:max-sessions/bras-pppox-access:max-session-number" {
    deviate replace {
      type uint32 {
        range "0..262144";
      }
    }
    deviate add {
      default "65534";
    }
  }
}

  
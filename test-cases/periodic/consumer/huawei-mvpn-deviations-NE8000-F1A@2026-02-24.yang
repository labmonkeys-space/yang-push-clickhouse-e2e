  deviation "/ni:network-instance/ni:instances/ni:instance/l3vpn:afs/l3vpn:af/mvpn:mvpn/mvpn:mvpn-type/mvpn:ng-mvpn/mvpn:ng/mvpn:spmsi-tunnels/mvpn:spmsis/mvpn:star-grps/mvpn:star-grp" {
    deviate delete {
      must "(./tunnel-mode!='bier' and ./tunnel-mode!='p2mp-mldp' and ./tunnel-mode!='p2mp-te' and ./tunnel-mode!='ingress-replication') or (../../../../../mvpn:mvpn-id or /mvpn:mvpn/mvpn:globals/mvpn:global[mvpn:address-family=current()/../../../../../../l3vpn:type]/mvpn:mvpn-id)";
    }
    deviate delete {
      must "./tunnel-mode!='ingress-replication' or (../../../../inter-area-seg-enable='false' and ../../../../is-inter-as='false')";
    }
    deviate add {
      must "(./tunnel-mode!='bier' and ./tunnel-mode!='p2mp-mldp' and ./tunnel-mode!='p2mp-te') or (../../../../../mvpn:mvpn-id or /mvpn:mvpn/mvpn:globals/mvpn:global[mvpn:address-family=current()/../../../../../../l3vpn:type]/mvpn:mvpn-id)";
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/l3vpn:afs/l3vpn:af/mvpn:mvpn/mvpn:mvpn-type/mvpn:ng-mvpn/mvpn:ng/mvpn:spmsi-tunnels/mvpn:spmsis/mvpn:star-grps/mvpn:star-grp/mvpn:tunnel-mode" {
    deviate replace {
      type mvpn-devs-NE8000-F1A:tunnel-mode-deviations;
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/l3vpn:afs/l3vpn:af/mvpn:mvpn/mvpn:mvpn-type/mvpn:ng-mvpn/mvpn:ng/mvpn:spmsi-tunnels/mvpn:spmsis/mvpn:star-grps/mvpn:star-grp/mvpn:per-item-tunnel-limit" {
    deviate add {
      must "../tunnel-mode='p2mp-mldp' or ../per-item-tunnel-limit<=8192";
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/l3vpn:afs/l3vpn:af/mvpn:mvpn/mvpn:mvpn-type/mvpn:ng-mvpn/mvpn:ng/mvpn:spmsi-tunnels/mvpn:spmsis/mvpn:star-grps/mvpn:star-grp/mvpn:tunnel-attribute/mvpn:rsvp-te-p2mp/mvpn:rsvp-te-p2mp-template" {
    deviate replace {
      type leafref {
        path "/mpls:mpls/mpls-te:te/mpls-te:p2mp-templates/mpls-te:p2mp-template/mpls-te:name";
      }
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/l3vpn:afs/l3vpn:af/mvpn:mvpn/mvpn:mvpn-type/mvpn:ng-mvpn/mvpn:ng/mvpn:spmsi-tunnels/mvpn:spmsis/mvpn:src-grps/mvpn:src-grp/mvpn:tunnel-mode" {
    deviate delete {
      must "(../tunnel-mode!='ingress-replication') or ((../../../star-star/tunnel-mode and ../../../star-star/tunnel-mode='ingress-replication') or (../../../../../ipmsi-tunnel/tunnel-mode and ../../../../../ipmsi-tunnel/tunnel-mode='ingress-replication'))";
    }
    deviate delete {
      must "../tunnel-mode!='ingress-replication' or (../../../../../inter-area-seg-enable='false' and ../../../../../is-inter-as='false')";
    }
    deviate replace {
      type mvpn-devs-NE8000-F1A:tunnel-mode-deviations;
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/l3vpn:afs/l3vpn:af/mvpn:mvpn/mvpn:mvpn-type/mvpn:ng-mvpn/mvpn:ng/mvpn:spmsi-tunnels/mvpn:spmsis/mvpn:src-grps/mvpn:src-grp/mvpn:per-item-tunnel-limit" {
    deviate add {
      must "../tunnel-mode='p2mp-mldp' or ../per-item-tunnel-limit<=8192";
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/l3vpn:afs/l3vpn:af/mvpn:mvpn/mvpn:mvpn-type/mvpn:ng-mvpn/mvpn:ng/mvpn:spmsi-tunnels/mvpn:spmsis/mvpn:src-grps/mvpn:src-grp/mvpn:tunnel-attribute/mvpn:rsvp-te-p2mp/mvpn:rsvp-te-p2mp-template" {
    deviate replace {
      type leafref {
        path "/mpls:mpls/mpls-te:te/mpls-te:p2mp-templates/mpls-te:p2mp-template/mpls-te:name";
      }
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/l3vpn:afs/l3vpn:af/mvpn:mvpn/mvpn:mvpn-type/mvpn:ng-mvpn/mvpn:ng/mvpn:multistream-spmsis/mvpn:multistream-spmsi" {
    deviate delete {
      must "(./tunnel-mode!='bier') or ((../../spmsi-tunnels/spmsis/star-star/tunnel-mode and ../../spmsi-tunnels/spmsis/star-star/tunnel-mode='bier') or (../../ipmsi-tunnel/tunnel-mode and ../../ipmsi-tunnel/tunnel-mode='bier'))";
    }
    deviate delete {
      must "(./tunnel-mode!='bier-ipv6') or ((../../spmsi-tunnels/spmsis/star-star/tunnel-mode and ../../spmsi-tunnels/spmsis/star-star/tunnel-mode='bier-ipv6') or (../../ipmsi-tunnel/tunnel-mode and ../../ipmsi-tunnel/tunnel-mode='bier-ipv6'))";
    }
    deviate delete {
      must "(./tunnel-mode!='ir') or ((../../spmsi-tunnels/spmsis/star-star/tunnel-mode and ../../spmsi-tunnels/spmsis/star-star/tunnel-mode='ir') or (../../ipmsi-tunnel/tunnel-mode and ../../ipmsi-tunnel/tunnel-mode='ir'))";
    }
    deviate delete {
      must "(./tunnel-mode!='ir') or (../../inter-area-seg-enable='false' and ../../is-inter-as='false')";
    }
    deviate delete {
      must "(./tunnel-mode!='p2mp-te') or ((../../spmsi-tunnels/spmsis/star-star/tunnel-mode and ../../spmsi-tunnels/spmsis/star-star/tunnel-mode='p2mp-te') or (../../ipmsi-tunnel/tunnel-mode and ../../ipmsi-tunnel/tunnel-mode='p2mp-te'))";
    }
    deviate delete {
      must "./tunnel-mode!='bier' or (./sub-domain-id and ./bsl)";
    }
    deviate delete {
      must "./tunnel-mode!='bier-ipv6' or (./sub-domain-id-ipv6 and ./bsl-ipv6)";
    }
    deviate delete {
      must "./tunnel-mode!='p2mp-te' or ./rsvp-te-p2mp-template";
    }
    deviate add {
      must "(./tunnel-mode!='bier') or ((../../spmsi-tunnels/spmsis/star-star/tunnel-mode and ../../spmsi-tunnels/spmsis/star-star/tunnel-mode='bier') or (../../ipmsi-tunnel/tunnel-mode and ../../ipmsi-tunnel/tunnel-mode='bier'))";
    }
    deviate add {
      must "(./tunnel-mode!='bier-ipv6') or ((../../spmsi-tunnels/spmsis/star-star/tunnel-mode and ../../spmsi-tunnels/spmsis/star-star/tunnel-mode='bier-ipv6') or (../../ipmsi-tunnel/tunnel-mode and ../../ipmsi-tunnel/tunnel-mode='bier-ipv6'))";

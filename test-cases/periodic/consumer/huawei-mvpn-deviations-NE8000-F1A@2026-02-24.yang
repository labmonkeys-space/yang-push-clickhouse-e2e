  deviation "/ni:network-instance/ni:instances/ni:instance/l3vpn:afs/l3vpn:af/mvpn:mvpn/mvpn:mvpn-type/mvpn:ng-mvpn/mvpn:ng/mvpn:multistream-spmsis/mvpn:multistream-spmsi/mvpn:tunnel-attribute/mvpn:bier-ipv6/mvpn:sub-domain-id-ipv6" {

    deviate add {
      must "./tunnel-mode!='bier-ipv6' or (./sub-domain-id-ipv6 and ./bsl-ipv6)";
    }
    deviate add {
      must "./tunnel-mode!='p2mp-te' or ./rsvp-te-p2mp-template";
    }

module huawei-pp4-deviations-NE8000-F1A {
  yang-version 1;
  namespace "urn:huawei:yang:huawei-pp4-deviations-NE8000-F1A";
  prefix pp4-devs-NE8000-F1A;

  import huawei-pp4 {
    prefix pp4;
  }
  import huawei-ifm {
    prefix ifm;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-pp4 module.";

  revision 2025-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  typedef app-proto-type-deviations {
    type enumeration {
      enum management {
        value 1;
        description
          "Management protocol.";
      }
      enum control {
        value 2;
        description
          "Control protocol.";
      }
    }
    description
      "Application protocol type.";
  }

  deviation "/pp4:pp4/pp4:global/pp4:udp-helper-switch" {
    deviate not-supported;
  }
  deviation "/pp4:pp4/pp4:ip-acl-dscps" {
    deviate not-supported;
  }
  deviation "/pp4:pp4/pp4:priority-8021p" {
    deviate not-supported;
  }
  deviation "/pp4:pp4/pp4:udp-helper-ports" {
    deviate not-supported;
  }
  deviation "/pp4:pp4/pp4:udp-helper-info" {
    deviate not-supported;
  }
  deviation "/pp4:reset-udp-helper-stats" {
    deviate not-supported;
  }
  deviation "/ifm:ifm/ifm:interfaces/ifm:interface/pp4:if-udp-helper-servers" {
    deviate not-supported;
  }
  deviation "/pp4:pp4/pp4:ip-dscps/pp4:ip-dscp/pp4:proto-type" {
    deviate replace {
      type pp4-devs-NE8000-F1A:app-proto-type-deviations;
    }
  }
}

  
  deviation "/bgp:bgp/bgp:base-process/bgp-rt:bgp-route/bgp-flow:vpnv4-flow/bgp-flow:routes/bgp-flow:route/bgp-flow:rule-indexs/bgp-flow:rule-index/bgp-flow:type" {

    deviate not-supported;
  }
  deviation "/bgp:bgp/bgp:base-process/bgp-rt:bgp-route/bgp-flow:ipv6-flow/bgp-flow:route-actions/bgp-flow:route-action/bgp-flow:interface-groups" {
    deviate not-supported;
  }
  deviation "/bgp:bgp/bgp:base-process/bgp-rt:bgp-route/bgp-flow:ipv6-flow/bgp-flow:route-actions/bgp-flow:route-action/bgp-flow:application-awareness" {
    deviate not-supported;
  }
  deviation "/bgp:bgp/bgp:base-process/bgp-rt:bgp-route/bgp-flow:vpnv4-flow/bgp-flow:route-rule/bgp-flow:interface-groups" {
    deviate not-supported;
  }
  deviation "/bgp:bgp/bgp:base-process/bgp-rt:bgp-route/bgp-flow:vpnv4-flow/bgp-flow:route-actions/bgp-flow:route-action/bgp-flow:remark-slice-ids" {
    deviate not-supported;
  }
  deviation "/bgp:bgp/bgp:base-process/bgp-rt:bgp-route/bgp-flow:vpnv4-flow/bgp-flow:route-actions/bgp-flow:route-action/bgp-flow:interface-groups" {
    deviate not-supported;
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/bgp:bgp/bgp:base-process/bgp:afs/bgp:af/bgp-flow:ipv4-flow/bgp-flow:common/bgp-flow:check-origin-as-uncheck-interface-group" {
    deviate delete {
      must "../check-origin-as-enable='false'";
    }
  }
  deviation "/ni:network-instance/ni:instances/ni:instance/bgp:bgp/bgp:base-process/bgp:afs/bgp:af/bgp-flow:ipv6-flow/bgp-flow:common/bgp-flow:check-origin-as-uncheck-interface-group" {
    deviate delete {
      must "../check-origin-as-enable='false'";
    }
  }
  deviation "/bgp:bgp/bgp:base-process/bgp-rt:bgp-route/bgp-flow:ipv4-flow/bgp-flow:routes/bgp-flow:route/bgp-flow:rule-indexs/bgp-flow:rule-index/bgp-flow:type" {
    deviate replace {
      type bgp-flow-devs-NE8000-F1A:base-flow-rule-type-deviations;
    }
  }
  deviation "/bgp:bgp/bgp:base-process/bgp-rt:bgp-route/bgp-flow:ipv6-flow/bgp-flow:routes/bgp-flow:route/bgp-flow:rule-indexs/bgp-flow:rule-index/bgp-flow:type" {
    deviate replace {
      type bgp-flow-devs-NE8000-F1A:base-flow-rule-type-deviations;

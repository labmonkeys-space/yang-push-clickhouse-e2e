module huawei-cgn-nat444 {
  namespace "urn:huawei:yang:huawei-cgn-nat444";
  prefix cgn-nat444;
  import huawei-extension {
    prefix ext;
  }
  import huawei-cgn-common {
    prefix cgn-common;
  }
  import ietf-inet-types {
    prefix inet;
  }
  import huawei-network-instance {
    prefix ni;
  }
  import huawei-l3vpn {
    prefix l3vpn;
  }
  import huawei-qos {
    prefix qos;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-acl {
    prefix acl;
  }
  import huawei-cgn {
    prefix cgn;
  }
  import huawei-vsm {
    prefix vsm;
  }
  import huawei-bras-cu-agent {
    prefix bras-cu-agent;
  }
  import huawei-ip {
    prefix ip;
  }
  import huawei-nqa {
    prefix nqa;
  }
  organization
    "Huawei Technologies Co., Ltd.";

  contact
    "Huawei Industrial Base
    Bantian, Longgang
    Shenzhen 518129
    People's Republic of China
    Website: http://www.huawei.com
    Email: support@huawei.com";

  description
    "This module contains a collection of YANG definitions for Configurations of cgn NAT444.";
  revision 2026-06-15 {
    description
      "Add container nat-session-aging.";
    reference
      "Huawei private.";
  }
  revision 2026-04-24 {
    description
      "Add container log-mode.";
    reference
      "Huawei private.";
  }
  revision 2026-03-03 {
    description
      "Add leaf new-end-address.";
    reference
      "Huawei private.";
  }
  revision 2026-01-27 {
    description
      "Add container five-tuple-port-reuse. Delete host must condition.";
    reference
      "Huawei private.";
  }
  revision 2025-12-03 {
    description
      "Change leaf track-nqa-admin-name, track-nqa-test-name must condition.";
    reference
      "Huawei private.";
  }
  revision 2025-10-28 {
    description
      "Add leaf track-nqa-admin-name, track-nqa-test-name.";
    reference
      "Huawei private.";
  }
  revision 2025-08-04 {
    description
      "Delete the must condition for container port-limit. Delete the when condition for container redirect-with-ids. Add leaf period-value.";
    reference
      "Huawei private.";
  }
  revision 2025-02-08 {
    description
      "Add container redirect-with-ids.";
    reference
      "Huawei private.";
  }
  revision 2024-11-22 {
    description
      "Add container elog-version.";
    reference
      "Huawei private.";
  }
  revision 2024-08-14 {

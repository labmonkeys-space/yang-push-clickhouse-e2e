      "Modify the must condition for container warm-backup-profiles.";
    reference
      "Huawei private.";
  }
  revision 2024-08-02 {
    description
      "Add unique for list easyip-mapping, add the must condition for leaf global-interface.";
    reference
      "Huawei private.";
  }
  revision 2024-08-01 {
    description
      "Modify the must condition for container nat-instances.";
    reference
      "Huawei private.";
  }
  revision 2024-07-26 {
    description
      "Add container warm-backup-profiles.";
    reference
      "Huawei private.";
  }
  revision 2024-07-16 {
    description
      "Add container bind-nat-statistics, rpc get-nat-outif-statistics, reset-nat-outif-statistics.";
    reference
      "Huawei private.";
  }
  revision 2024-07-03 {
    description
      "Add container alarm.";
    reference
      "Huawei private.";
  }
  revision 2024-06-19 {
    description
      "Modify the must condition for leaf mapping-address-group.";
    reference
      "Huawei private.";
  }
  revision 2024-05-25 {
    description
      "Add some nodes.";
    reference
      "Huawei private.";
  }
  revision 2024-05-19 {
    description
      "Add container dns-alg-dynamic.";
    reference
      "Huawei private.";
  }
  revision 2024-02-19 {
    description
      "Modify the must condition to when condition for leaf interface.";
    reference
      "Huawei private.";
  }
  revision 2023-11-17 {
    description
      "Add the when and mandatory condition for choice inside-end-ip.";
    reference
      "Huawei private.";
  }
  revision 2023-10-17 {
    description
      "Modify the must condition to when condition for container user-migration.";
    reference
      "Huawei private.";
  }
  revision 2023-10-10 {
    description
      "Add container user-migration.";
    reference
      "Huawei private.";
  }
  revision 2023-09-04 {
    description
      "Delete the when condition for container send-mode.";
    reference
      "Huawei private.";
  }
  revision 2023-08-04 {
    description
      "Modify the when condition for container bind-service-instance-group.";
    reference
      "Huawei private.";
  }
  revision 2023-07-24 {
    description
      "Add the when condition for container port-range, nat-translate, nat-translate, filter-mode, user-log, fast-forwarding, inter-chassis-distributing, port-reuse.";
    reference
      "Huawei private.";
  }
  revision 2023-02-09 {
    description
      "Modify the must condition of inside-port in container server-mappings, delete presence container of easyip-mappings.";
    reference
      "Huawei private.";
  }
  revision 2023-01-30 {
    description
      "Modify the must condition in container server-mappings.";
    reference
      "Huawei private.";
  }
  revision 2023-01-17 {
    description
      "Add container server-mappings and easyip-mappings.";
    reference
      "Huawei private.";
  }
  revision 2022-10-15 {
    description
      "Modify using-address-group-ip default value.";

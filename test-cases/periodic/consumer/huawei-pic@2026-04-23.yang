    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
    Bantian, Longgang
    Shenzhen 518129
    People's Republic of China
    Website: http://www.huawei.com
    Email: support@huawei.com";
  description
    "Global Configuration.";
  revision 2026-04-23 {
    description
      "Modify the type of leaves rx-power-status, tx-power-status in optical-module and channels.
       Add new leaves rx-power-status, tx-power-status in optical-module and channels.";
    reference
      "Huawei private.";
  }
  revision 2026-03-16 {
    description
      "Add new enum of devm-trans-alarm-type.
       Add new enum of alarm-type.
       Add new enum of port-band.
       Add new enums of possible-cause.
       Modify the must condition of alarm-threshold.
       The crc-error is deprecated.
       Add new enums of detect-status.
       Modify the description of fhc-refractive-index.";
    reference
      "Huawei private.";
  }
  revision 2026-01-23 {
    description
      "Modify the units of tx-power-target-value.
       Modify the leaves wavelength-channel-number, tunable-wavelength, tunable-wavelength-unit, tunable-frequency, and tunable-frequency-unit to use choice and case declarations.
       Add leaf-list current-service-switch-mode.
       Add new enum of panel-split-ports-split-type.
       Add leaf port-transmission.
       Add container alarm-threshold.
       Add new enum of panel-split-ports-split-type.
       Add two leaf nodes: cd and cd-status.
       Modify enum value of two leaf nodes: cd and cd-status.
       Modify default value of two leaf nodes: traffic-convergence-alarm-threshold and traffic-convergence-resume-threshold.
       Add leaf fhc-refractive-index.
       Add new enums of possible-cause.
       Add a read-only leaf node fhc-refractive-index.";
    reference
    "Huawei private.";
  }
  revision 2025-09-16 {
    description
      "Add new enum of detect-status and failed-reason.
       Modify and add new enum of failed-reason and possible-cause.
       Add new enum of failed-reason and possible-cause.
       Modify the pattern of leaf position, fiber-length, slope, attenuation and reflected-power.
       Add rpc upgrade-firmware and get-upgrade-firmware-result.
       Add a new port-combination-modes and port-combo-mode-type.
       Add new enum of optical module type and transceiver-medium-type.
       Modify the pattern of leaf position, fiber-length, slope, attenuation and reflected-power.
       Add a new container crc-alarm-threshold.
       Add leaves traffic-convergence-alarm-threshold and traffic-convergence-resume-threshold.
       Add new enum of mode-type, bandwidth-mode.
       Add new container fhc-detect, add leaves rx-bind-position and tx-bind-position.
       Add new leaf-list support-mode-capability, add new enum of switch-speed-type.
       Add a new container lcs-usage-port-capacity and type port-lcs-type.
       Modify the when condition of leaf signal-dqpsk-tx, leaf signal-dqpsk-rx.
       Add new enum of port-lcs-type.
       Modify the description of the rpc lead laser-test-time.
       Modify max value of crc-error threshold from 65535 to 4294967295.
       Add a new leaf owned-value.
       Corrected several spelling mistakes.";
    reference
    "Huawei private.";
  }

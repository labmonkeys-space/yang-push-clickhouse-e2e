module huawei-snmp-deviations-NE8000-F1A {
  namespace "urn:huawei:yang:huawei-snmp-deviations-NE8000-F1A";
  prefix snmp-devs-NE8000-F1A;

  import huawei-snmp {
    prefix snmp;
  }
  import huawei-extension {
    prefix ext;
  }
  import huawei-aaa {
    prefix aaa;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-snmp module.";

  revision 2025-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  deviation "/snmp:snmp/snmp:system/snmp:trap-source-ipv4-address" {
    deviate not-supported;
  }
  deviation "/snmp:snmp/snmp:system/snmp:ipv6-acl" {
    deviate not-supported;
  }
  deviation "/snmp:snmp/snmp:target-hosts/snmp:target-host/snmp:ip-version" {
    deviate not-supported;
  }
  deviation "/snmp:snmp/snmp:target-hosts/snmp:target-host/snmp:is-need-heart-beat" {
    deviate not-supported;
  }
  deviation "/snmp:snmp/snmp:target-hosts/snmp:target-host/snmp:heart-beat-time" {
    deviate not-supported;
  }
  deviation "/snmp:snmp/snmp:target-hosts/snmp:target-host/snmp:status" {
    deviate not-supported;
  }
  deviation "/snmp:snmp/snmp:local-users/snmp:local-user/snmp:name" {
    deviate add {
      must "/aaa:aaa/aaa:lam/aaa:users/aaa:user[aaa:name = current()]/aaa:service-snmp = 'true'";
    }
  }
  deviation "/snmp:snmp/snmp:proxy/snmp:communitys/snmp:community/snmp:acl" {
    deviate replace {
      type string {
        length "1..32";
      }
    }
  }
  deviation "/snmp:snmp/snmp:proxy/snmp:standard-communitys/snmp:standard-community/snmp:acl" {
    deviate replace {
      type string {
        length "1..32";
      }
    }
  }
  ext:deviation-ext "/snmp:snmp/snmp:mib-views/snmp:mib-view" {
    ext:deviate-ext "add" {
      ext:operation-exclude "update" {
        ext:filter "view-name = 'ViewDefault'";
      }
    }
    ext:deviate-ext "add" {
      ext:generated-by "system" {
        ext:filter "view-name = 'ViewDefault'";
      }
    }
  }
}

  
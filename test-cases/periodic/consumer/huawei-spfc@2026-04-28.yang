          description "Index of the interface that triggers PFC packet sending.";
        }
        leaf trigger-sliceid15 {
          type uint32;
          description "ID of the slice that triggers PFC packet sending.";
        }
        leaf trigger-queue15 {
          type flex-chan-service-class;
          description "Queue that triggers PFC packet sending.";
        }
        leaf trigger-ifindex16 {
          type uint32;
          description "Index of the interface that triggers PFC packet sending.";
        }
        leaf trigger-sliceid16 {
          type uint32;
          description "ID of the slice that triggers PFC packet sending.";
        }
        leaf trigger-queue16 {
          type flex-chan-service-class;
          description "Queue that triggers PFC packet sending.";
        }
      }
    }
    container pfc-receive-statistics-reports {
      config false;
      description "List of telemetry-reported statistics about received PFC packets.";
      list pfc-receive-statistics-report {
        key "ifindex";
        description "Statistics of received PFC packets reported through telemetry.";
        leaf ifindex {
          type uint32;
          description "Index of the outbound interface that receives PFC packets.";
        }        
        leaf increment-count {
          type uint32;
          description "Incremental count of received PFC packets.";
        }
        leaf total-count {
          type uint64;
          description "Total count of received PFC packets.";
        }
      }
    }
    container rpfc {
      description "Configure the RPFC function.";
      container global-attribute {
        description "Configure global RPFC parameters.";
        leaf rpfc-enable {
          type boolean;
          default "false";
          description
            "Enable/disable RPFC.";
        }
        leaf flow-aging-time {
            when "../rpfc-enable='true'";
            type uint32 {
            range "10..300";
            }
            units "s";
            default "50";
            description "Aging time for forwarding-plane flow tables.";
        }     
        leaf udp-port {
            when "../rpfc-enable='true'";
            type uint32 {
            range "10000..57999";
            }
            default "19518";
            description "Destination UDP port ID.";
        }
        leaf source-ip{
            when "../rpfc-enable='true'";
            type inet:ipv4-address-no-zone {
              pattern '((([1-9]|[1-9][0-9]|1[0-1][0-9]|12[0-6])|(12[8-9]|1[3-8][0-9]|19[0-1])|(19[2-9]|2[0-1][0-9]|22[0-3]))(\..*){3})';
            }
            description
            "Source IP address.";
        }
      }
    }
    container rpfc-statistics-reports {
      config false;
      description "List of telemetry-reported statistics about rPFC packets.";
      list rpfc-statistics-report {
        key "ifindex rpfc-type";
        description "Statistics of rPFC packets reported through telemetry.";
        leaf ifindex {
          type uint32;
          description "Index of the outbound interface that rPFC packets.";
        }
        leaf rpfc-type {
          type uint32;
          description "Send or receive.";
        }
        leaf slotid {
          type uint32;
          description "Slot ID of the board that triggers rPFC packet sending.";
        }
        leaf increment-count {
          type uint32;
          description "Incremental count of rPFC packets.";
        }
        leaf trigger-ifindex1 {
          type uint32;
          description "Index of the interface that triggers rPFC packet sending.";
        }
        leaf trigger-sliceid1 {
          type uint32;
          description "ID of the slice that triggers rPFC packet sending.";
        }
        leaf trigger-queue1 {
          type flex-chan-service-class;
          description "Queue that triggers rPFC packet sending.";
        }
        leaf trigger-ifindex2 {
          type uint32;
          description "Index of the interface that triggers rPFC packet sending.";
        }
        leaf trigger-sliceid2 {
          type uint32;
          description "ID of the slice that triggers rPFC packet sending.";
        }
        leaf trigger-queue2 {
          type flex-chan-service-class;
          description "Queue that triggers rPFC packet sending.";
        }
        leaf trigger-ifindex3 {
          type uint32;
          description "Index of the interface that triggers rPFC packet sending.";
        }
        leaf trigger-sliceid3 {
          type uint32;
          description "ID of the slice that triggers rPFC packet sending.";
        }
        leaf trigger-queue3 {
          type flex-chan-service-class;
          description "Queue that triggers rPFC packet sending.";

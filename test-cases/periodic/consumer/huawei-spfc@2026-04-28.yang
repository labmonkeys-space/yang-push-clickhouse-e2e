module huawei-spfc {
  namespace "urn:huawei:yang:huawei-spfc";
  prefix spfc;
  import huawei-extension {
    prefix ext;
  }
  import huawei-net-slice {
    prefix net-slice;
  }
  import huawei-ifm {
    prefix ifm;
  }
  import huawei-ethernet {
    prefix ethernet;
  }
  import ietf-inet-types {
    prefix inet;
  }
  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module contains a collection of YANG definitions spfc feature.";
  revision 2026-04-28 {
    description
      "Add new nodes.";
    reference
      "Huawei private.";
  }
  revision 2026-01-05 {
    description
      "Add new nodes.";
    reference
      "Huawei private.";
  }
  revision 2025-12-03 {
    description
      "Add node.";
    reference
      "Huawei private.";
  }
  revision 2025-08-07 {
    description
      "Add node.";
    reference
      "Huawei private.";
  }
  revision 2025-03-27 {
    description
      "Initial revision.";
    reference
      "Huawei private.";
  }
  typedef flex-chan-service-class {
    type enumeration {
      enum "be" {
        value 0; 
        description
          "Service class BE.";
      }
      enum "af1" {
        value 1; 
        description
          "Service class AF1.";
      }
      enum "af2" {
        value 2; 
        description
          "Service class AF2.";
      }
      enum "af3" {
        value 3; 
        description
          "Service class AF3.";
      }
      enum "af4" {
        value 4; 
        description
          "Service class AF4.";
      }
      enum "ef" {
        value 5; 
        description
          "Service class EF.";
      }
      enum "cs6" {
        value 6; 
        description
          "Service class CS6.";
      }
      enum "cs7" {
        value 7; 
        description
          "Service class CS7.";
      }
    }
    description
      "Service class type.";
  }
  ext:task-name  "forwarding";
  container spfc {
    description "SPFC function.";
    container statistics {
      description "Configure the SPFC statistics collection function.";
      container report-attribute {
        description "Configure the SPFC statistics reporting parameters.";
        leaf enable {
          type boolean;
          default "false";
          description "Enable/disable the SPFC statistics reporting function.";
        }
        leaf period {
          when "../enable='true'";
          type uint32 {
              range "10|30|60|300|600";
          }
          units "s";
          default "60";
          description "Period for reporting SPFC statistics.";
        }
      }
    }
    container statistics-reports {
      config false;
      description "List of SPFC statistics reported through telemetry.";
      list statistics-report {
        key "slice-id slice-ifindex";
        description "Statistics of SPFC reported through telemetry.";
        leaf slice-id {
          type uint32;
          description "Network slice ID.";
        }
        leaf slice-ifindex {
          type uint32;
          description "Index of the SPFC slice interface.";
        }
        leaf period {
          type uint32;
          description "Send period.";
        }
        leaf first-queue-cos {
          type flex-chan-service-class;
          description "Service class of the first-priority queue.";
        }
        leaf first-queue-collect-time {
          type uint32;
          units "s";
          description "Time when the first-priority queue collects statistics.";
        }
        leaf first-queue-count {
          type uint32;
          description "Number of packets sent by the first-priority queue.";
        }
        leaf second-queue-cos {
          type flex-chan-service-class;
          description "Service class of the second-priority queue.";
        }
        leaf second-queue-collect-time {
          type uint32;
          units "s";
          description "Time when the second-priority queue collects statistics.";
        }
        leaf second-queue-count {
          type uint32;
          description "Number of packets sent by the second-priority queue.";
        }
        leaf outifindex1 {
          type uint32;
          description "Outbound interface 1 for sending SPFC packets.";
        }
        leaf outifindex2 {
          type uint32;
          description "Outbound interface 2 for sending SPFC packets.";
        }
        leaf outifindex3 {
          type uint32;
          description "Outbound interface 3 for sending SPFC packets.";
        }
        leaf outifindex4 {
          type uint32;
          description "Outbound interface 4 for sending SPFC packets.";
        }
        leaf outifindex5 {
          type uint32;
          description "Outbound interface 5 for sending SPFC packets.";
        }
        leaf outifindex6 {
          type uint32;
          description "Outbound interface 6 for sending SPFC packets.";
        }
        leaf outifindex7 {
          type uint32;
          description "Outbound interface 7 for sending SPFC packets.";
        }
        leaf outifindex8 {
          type uint32;
          description "Outbound interface 8 for sending SPFC packets.";
        }
      }
    }
    container pfc-send-statistics-reports {
      config false;
      description "List of telemetry-reported statistics about sent PFC packets.";
      list pfc-send-statistics-report {
        key "ifindex";
        description "Statistics of sent PFC packets reported through telemetry.";
        leaf ifindex {
          type uint32;
          description "Index of the outbound interface that sends PFC packets.";
        }
        leaf slotid {
          type uint32;
          description "Slot ID of the board that triggers PFC packet sending.";
        }
        leaf increment-count {
          type uint32;
          description "Incremental count of sent PFC packets.";
        }
        leaf trigger-ifindex1 {
          type uint32;
          description "Index of the interface that triggers PFC packet sending.";
        }
        leaf trigger-sliceid1 {
          type uint32;
          description "ID of the slice that triggers PFC packet sending.";
        }
        leaf trigger-queue1 {
          type flex-chan-service-class;
          description "Queue that triggers PFC packet sending.";
        }
        leaf trigger-ifindex2 {
          type uint32;
          description "Index of the interface that triggers PFC packet sending.";
        }
        leaf trigger-sliceid2 {
          type uint32;
          description "ID of the slice that triggers PFC packet sending.";
        }
        leaf trigger-queue2 {
          type flex-chan-service-class;

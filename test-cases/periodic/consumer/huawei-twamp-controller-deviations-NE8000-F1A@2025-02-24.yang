module huawei-twamp-controller-deviations-NE8000-F1A {
  namespace "urn:huawei:yang:huawei-twamp-controller-deviations-NE8000-F1A";
  prefix twamp-controller-devs-NE8000-F1A;

  import huawei-twamp-controller {
    prefix twamp-controller;
  }

  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";
  description
    "This module defines deviation statements for huawei-twamp-controller module.";

  revision 2025-02-24 {
    description
      "Initial revision.";
    reference "Huawei private.";
  }

  deviation "/twamp-controller:twamp-controller/twamp-controller:client/twamp-controller:sessions/twamp-controller:session/twamp-controller:session-detail/twamp-controller:sequence-num" {
    deviate not-supported;
  }
  deviation "/twamp-controller:twamp-controller/twamp-controller:client/twamp-controller:sessions/twamp-controller:session/twamp-controller:session-detail/twamp-controller:tx-num" {
    deviate not-supported;
  }
  deviation "/twamp-controller:twamp-controller/twamp-controller:client/twamp-controller:sessions/twamp-controller:session/twamp-controller:session-detail/twamp-controller:rx-num" {
    deviate not-supported;
  }
  deviation "/twamp-controller:twamp-controller/twamp-controller:client/twamp-controller:sessions/twamp-controller:session/twamp-controller:session-detail/twamp-controller:discard-num" {
    deviate not-supported;
  }
  deviation "/twamp-controller:twamp-controller/twamp-controller:sender/twamp-controller:sessions/twamp-controller:session/twamp-controller:sample-interval" {
    deviate not-supported;
  }
  deviation "/twamp-controller:start-on-demand-test/twamp-controller:input/twamp-controller:sample-interval" {
    deviate not-supported;
  }
  deviation "/twamp-controller:twamp-controller/twamp-controller:client/twamp-controller:sessions/twamp-controller:session/twamp-controller:id" {
    deviate replace {
      type uint32 {
        range "1..2048";
      }
    }
  }
  deviation "/twamp-controller:twamp-controller/twamp-controller:client/twamp-controller:sessions/twamp-controller:session/twamp-controller:padding-length" {
    deviate replace {
      type uint32 {
        range "32..1454";
      }
    }
  }
}

  
submodule huawei-dhcpv6-server {
  yang-version 1;
  belongs-to huawei-dhcpv6 {
    prefix dhcpv6;
  }
  import ietf-inet-types {
    prefix inet;
  }
  organization
    "Huawei Technologies Co., Ltd.";
  contact
    "Huawei Industrial Base
    Bantian, Longgang
    Shenzhen 518129
    People's Republic of China
    Website: http://www.huawei.com
    Email: support@huawei.com";
  description
    "This module contains a collection of YANG definitions for managing DHCPv6 server.";
  revision 2023-07-18 {
    description
      "Init revision.";
    reference
      "Huawei private.";
  }
  grouping dhcpv6-server-type {
    description
      "DHCPv6 server.";
    container ipv6-pools {
      description
        "List of the DHCPv6 server address pools configuration.";
      list ipv6-pool {
        key "pool-name";
        description
          "Configure the DHCPv6 server address pool configuration.";
        leaf pool-name {
          type string {
            length "1..31";
          }
          description
            "Pool name.";
        }
        container address-prefixes {
          description
            "List of the address prefixes configuration.";
          list address-prefix {
            must "preferred-time <= valid-time";
            must "(valid-infinite and preferred-infinite) or (not(valid-infinite) and not(preferred-infinite)) or (not(preferred-infinite) and valid-infinite)";
            key "prefix prefix-length";
            description
              "Configure the address prefix.";
            leaf prefix {
              type inet:ipv6-address-no-zone;
              description
                "Address prefix.";
            }
            leaf prefix-length {
              type uint8 {
                range "16..128";
              }
              description
                "Prefix length.";
            }
            choice valid-life-type {
              mandatory true;
              description
                "Specify valid lifetime type.";
              case valid-finite-format {
                description
                  "Configure valid lifetime.";
                leaf valid-time {
                  type uint32 {
                    range "60..8640000";
                  }
                  units "s";
                  default "172800";
                  description
                    "Valid lifetime.";
                }
              }
              case valid-infinite-format {
                description
                  "Configure the valid lifetime to infinity.";
                leaf valid-infinite {
                  type empty;
                  description
                  "Enable/disable the valid lifetime to infinity.";
                }
              }
            }
            choice preferred-life-type {
              mandatory true;
              description
                "Specify preferred lifetime type.";
              case preferred-finite-format {
                description
                  "Configure preferred lifetime.";
                leaf preferred-time {
                  type uint32 {
                    range "60..8640000";
                  }
                  units "s";
                  default "86400";
                  description
                    "Preferred lifetime.";
                }
              }
              case preferred-infinite-format {
                description
                  "Configure the preferred lifetime to infinity.";
                leaf preferred-infinite {
                  type empty;
                  description
                  "Enable/disable the preferred lifetime to infinity.";
                }
              }
            }
          }
        }
      }
    }
  }
}
  
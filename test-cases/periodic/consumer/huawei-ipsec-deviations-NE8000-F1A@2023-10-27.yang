  typedef ah-auth-algorithm-router-type-deviations {
    type enumeration {
      enum "MD5" {
        value 1;
        description "MD5.";
      }
      enum "SHA1" {
        value 2;
        description "SHA1.";
      }
      enum "SHA2-256" {
        value 3;
        description "SHA2-256.";
      }
      enum "SHA2-384" {
        value 4;
        description "SHA2-384.";
      }
      enum "SHA2-512" {
        value 5;
        description "SHA2-512.";
      }
      enum "SM3" {
        value 6;
        description "SM3.";
      }
    }
    description
      "The type of ah-authentication-algorithm definition.";
  }

  typedef dpd-type-deviations {
    type enumeration {
      enum "periodic" {
        value 1;
        description
          "Periodic.";
      }
      enum "on-demand" {
        value 2;
        description
          "On-demand.";
      }
    }
    description
      "Type of IKE DPD.";
  }


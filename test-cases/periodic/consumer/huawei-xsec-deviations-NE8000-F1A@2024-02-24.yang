module huawei-xsec-deviations-NE8000-F1A {
  namespace "urn:huawei:yang:huawei-xsec-deviations-NE8000-F1A";
  prefix xsec-devs-NE8000-F1A;

  import huawei-xsec {
    prefix xsec;
  }

  import huawei-license {
    prefix lcs;
  }

  organization
    "Huawei Technologies Co., Ltd.";

  contact
    "Huawei Industrial Base
     Bantian, Longgang
     Shenzhen 518129
     People's Republic of China
     Website: http://www.huawei.com
     Email: support@huawei.com";

  description
